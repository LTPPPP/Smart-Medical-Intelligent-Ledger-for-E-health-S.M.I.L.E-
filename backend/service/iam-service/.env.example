# Application
APP_PORT=8081
APP_HOST=localhost
APP_URL=http://localhost:8081
APP_FALLBACK_LANGUAGE=en

# Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=auth_service_db
DATABASE_SYNCHRONIZE=true
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false

# User Domain Database (Phase 1 consolidation)
USER_DATABASE_HOST=localhost
USER_DATABASE_PORT=5432
USER_DATABASE_USERNAME=postgres
USER_DATABASE_PASSWORD=postgres
USER_DATABASE_NAME=account_service_db
USER_DATABASE_SYNCHRONIZE=true

# Auth
AUTH_JWT_SECRET=your-super-secret-jwt-key-change-in-production
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=your-super-secret-forgot-key-change-in-production
AUTH_FORGOT_TOKEN_EXPIRES_IN=1h
AUTH_CONFIRM_EMAIL_SECRET=your-super-secret-confirm-email-key-change-in-production
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_OTP_EXPIRES_IN=5m

# Internal service/KYC
IAM_INTERNAL_API_KEY=smile-local-kyc-key
KYC_PRIVATE_STORAGE_DIR=storage/kyc
KYC_FILE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
KYC_RETENTION_DAYS=365
KYC_RETENTION_CLEANUP_BATCH_SIZE=50
KYC_RETENTION_CLEANUP_ENABLED=true
KYC_RETENTION_CLEANUP_INTERVAL_MS=86400000
KYC_OCR_ENABLED=false
KYC_OCR_INTERVAL_MS=5000
KYC_OCR_BATCH_SIZE=2
KYC_OCR_TIMEOUT_MS=30000
KYC_OCR_MAX_ATTEMPTS=3
KYC_OCR_STALE_PROCESSING_MS=60000
KYC_MAX_FILE_SIZE=5242880

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@smile.com

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# KYC
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_FILE_ENCRYPTION_KEY=
KYC_PRIVATE_STORAGE_DIR=storage/kyc
KYC_MAX_FILE_SIZE=5242880
KYC_OCR_ENABLED=false
KYC_RETENTION_DAYS=365
IAM_INTERNAL_API_KEY=smile-local-kyc-key

# Redis (shared instance, logical DB 3 — logout access-token blacklist)
REDIS_URL=redis://localhost:6379/3

# Real SMTP hardening (Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=465 MAIL_SECURE=true)
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

# Twilio SMS gateway
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web push VAPID (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@smile.com

# Server-to-server token guarding POST /v1/notifications (unset = open)
INTERNAL_SERVICE_TOKEN=smile-local-internal-token
