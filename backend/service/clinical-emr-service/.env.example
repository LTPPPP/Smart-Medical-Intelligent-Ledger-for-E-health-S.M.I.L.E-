NODE_ENV=development
APP_PORT=8082
APP_NAME="Clinical EMR Service"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000

# ─── Main Medical Database (PostgreSQL) ──────────────────────────────────────
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=core_medical_service_db
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# ─── Clinic Database (PostgreSQL) ────────────────────────────────────────────
CLINIC_DATABASE_HOST=localhost
CLINIC_DATABASE_PORT=5432
CLINIC_DATABASE_USERNAME=postgres
CLINIC_DATABASE_PASSWORD=postgres
CLINIC_DATABASE_NAME=core_clinic_service_db
CLINIC_DATABASE_SYNCHRONIZE=false

# ─── File Storage ────────────────────────────────────────────────────────────
# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=ClinicalEMR
MAIL_CLIENT_PORT=1080

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=change-me-refresh-secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=change-me-forgot-secret
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=change-me-confirm-email-secret
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# Internal IAM KYC check (disabled unless explicitly enabled)
BOOKING_KYC_ENABLED=false
BOOKING_SKIP_KYC=false
IAM_SERVICE_URL=http://localhost:8081
IAM_INTERNAL_API_KEY=smile-internal-dev-key

# ─── OAuth ────────────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

# ─── Redis (shared instance, logical DB 1 — read cache) ─────────────────────
REDIS_URL=redis://localhost:6379/1
REDIS_CACHE_TTL_SECONDS=300
