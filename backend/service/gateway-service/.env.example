# ── Gateway Service Configuration ─────────────────────────────────────────────
APP_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Downstream Service URLs ──────────────────────────────────────────────────
# For Docker: use container names (e.g. http://iam-service:3001)
# For local dev: use localhost with the service port
# Consolidated services for Phase 1
IAM_SERVICE_URL=http://localhost:3001
CLINICAL_EMR_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3006
BLOCKCHAIN_SERVICE_URL=http://localhost:3007

# ── Proxy Settings ───────────────────────────────────────────────────────────
PROXY_TIMEOUT=30000
