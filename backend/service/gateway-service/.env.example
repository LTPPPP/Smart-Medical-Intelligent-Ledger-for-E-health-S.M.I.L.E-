# ── Gateway Service Configuration ─────────────────────────────────────────────
APP_PORT=8080
CORS_ORIGIN=http://localhost:3000
AUTH_JWT_SECRET=replace-with-a-long-random-local-secret

# ── Downstream Service URLs ──────────────────────────────────────────────────
# For Docker: use container names (e.g. http://iam-service:8081)
# For local dev: use localhost with the service port
# Consolidated services for Phase 1
IAM_SERVICE_URL=http://localhost:8081
CLINICAL_EMR_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
BLOCKCHAIN_SERVICE_URL=http://localhost:8084
AI_ROUTES_ENABLED=false
BOOKING_LANGGRAPH_SERVICE_URL=http://localhost:8030

# ── Proxy Settings ───────────────────────────────────────────────────────────
PROXY_TIMEOUT=30000
