Table payments {
  payment_id uuid [pk]
  appointment_id uuid [not null]
  amount numeric(12,2) [not null]
  currency varchar(10) [not null, default: 'VND']
  status varchar(20) [not null, default: 'pending']
  provider varchar(30) [not null, default: 'vnpay']
  provider_txn_ref varchar(100)
  order_info text
  refund_amount numeric(12,2)
  refunded_at timestamp
  refund_status varchar(20)
  refund_reason text
  refund_requested_by uuid
  refund_requested_at timestamp
  refund_reviewed_by uuid
  refund_reviewed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// ── Logical cross-database references (UUID only — NO physical FK) ──
// payments.appointment_id -> core_clinic_service_db.appointments.appointment_id
