@startuml emr-orders

hide circle
hide methods

top to bottom direction

skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 8
skinparam ranksep 12
skinparam padding 1
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #D5F5E3
  BorderColor #27AE60
  FontSize 10
  AttributeFontSize 9
}

' ── Services: clinical-orders · lab-test-results ──

class "medical_records" as medical_records <<ref>> {
  record_id : uuid <<PK>>
  visit_date : date
  record_status : varchar
}

class "patients" as patients <<ref>> {
  patient_id : uuid <<PK>>
  full_name : varchar
}

class "clinical_orders" as clinical_orders {
  order_id : uuid <<PK>>
  record_id : uuid <<FK>>
  patient_id : uuid <<FK>>
  ordered_by : uuid
  order_type : varchar
  test_type : varchar
  clinical_indication : text
  teeth_numbers : integer
  urgency : varchar
  status : varchar
  ordered_date : timestamp
  scheduled_date : timestamp
  completed_date : timestamp
  result_url : text
  report : text
  created_at : timestamp
  updated_at : timestamp
}

class "lab_test_results" as lab_test_results {
  result_id : uuid <<PK>>
  order_id : uuid <<FK>>
  test_name : varchar
  result_value : text
  result_unit : varchar
  reference_range : varchar
  is_abnormal : boolean
  notes : text
  created_at : timestamp
}

clinical_orders "many" --> "1" medical_records : record_id
clinical_orders "many" --> "1" patients : patient_id
lab_test_results "many" --> "1" clinical_orders : order_id

@enduml
