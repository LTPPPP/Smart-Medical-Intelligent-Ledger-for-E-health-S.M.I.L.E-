@startuml emr-files

hide circle
hide methods

left to right direction

skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 8
skinparam ranksep 12
skinparam padding 1
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #D5F5E3
  BorderColor #27AE60
  FontSize 10
  AttributeFontSize 9
}

' ── Service: files ──

class "file" as file {
  id : uuid <<PK>>
  path : varchar
}

@enduml
