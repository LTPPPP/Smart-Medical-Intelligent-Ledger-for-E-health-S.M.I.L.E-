@startuml db-auth-service
title Database Diagram — auth_service_db (IAM Service, default connection)

hide circle
hide methods

top to bottom direction

skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 8
skinparam ranksep 12
skinparam padding 1
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #D4E6F1
  BorderColor #5B9BD5
  FontSize 10
  AttributeFontSize 9
}

class "accounts" as accounts {
  account_id : uuid <<PK>>
  username : varchar <<UQ>>
  email : varchar <<UQ>>
  phone : varchar <<UQ>>
  full_name : varchar
  gender : varchar
  password_hash : varchar
  role : varchar
  status : varchar
  failed_login_attempts : int
  locked_at : timestamp
  locked_reason : text
  locked_by : uuid
  email_verified : boolean
  phone_verified : boolean
  last_login_at : timestamp
  created_at : timestamp
  updated_at : timestamp
  created_by : uuid
  updated_by : uuid
}

class "oauth_connections" as oauth_connections {
  connection_id : uuid <<PK>>
  account_id : uuid <<FK>>
  provider : varchar
  provider_user_id : varchar
  access_token : text
  refresh_token : text
  token_expires_at : timestamp
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

class "otp_tokens" as otp_tokens {
  otp_id : uuid <<PK>>
  account_id : uuid <<FK>>
  otp_code : varchar
  otp_type : varchar
  expires_at : timestamp
  used_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

class "refresh_tokens" as refresh_tokens {
  token_id : uuid <<PK>>
  account_id : uuid <<FK>>
  token_hash : varchar
  expires_at : timestamp
  revoked_at : timestamp
  device_info : text
  ip_address : varchar
  created_at : timestamp
}

accounts ||--o{ oauth_connections
accounts ||--o{ otp_tokens
accounts ||--o{ refresh_tokens

note bottom of accounts
  account_id is reused as user_id in
  account_service_db.users — logical
  cross-database link, no physical FK.
  Logout access-token blacklist lives
  in Redis db 3, not in this database.
end note

@enduml
