// ============================================================
// S.M.I.L.E — core_clinic_service_db
// Owner: Clinical EMR Service (clinicConnection)
// Generated from TypeORM entities — paste into dbdiagram.io
// ============================================================

Table clinics {
  clinic_id uuid [pk]
  clinic_name varchar(255) [not null]
  clinic_code varchar(50) [unique, not null]
  address text [not null]
  ward varchar(100)
  district varchar(100)
  city varchar(100)
  phone varchar(20)
  email varchar(255)
  website varchar(255)
  logo_url text
  operating_hours jsonb
  status varchar(20) [not null, default: 'ACTIVE']
  license_number varchar(100)
  license_expiry date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table treatment_rooms {
  room_id uuid [pk]
  clinic_id uuid [not null]
  room_name varchar(100) [not null]
  room_code varchar(50) [not null]
  room_type varchar [not null]
  floor_number int
  equipment_list jsonb
  status varchar(20) [not null, default: 'AVAILABLE']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table work_shifts {
  shift_id uuid [pk]
  shift_name varchar(100) [not null]
  start_time time [not null]
  end_time time [not null]
  description text
  created_at timestamp [not null, default: `now()`]
}

Table specialties {
  specialty_id uuid [pk]
  specialty_name varchar(255) [not null]
  specialty_code varchar(50) [unique, not null]
  description text
  icon_url text
  is_active boolean [not null, default: 'true ']
  display_order int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table doctor_specialties {
  doctor_id uuid [pk]
  specialty_id uuid [pk]
  certification_number varchar(100)
  certified_date date
  is_primary boolean [not null, default: 'false ']
  created_at timestamp [not null, default: `now()`]
}

Table doctor_leaves {
  leave_id uuid [pk]
  doctor_id uuid [not null]
  leave_type varchar(50)
  start_date date [not null]
  end_date date [not null]
  reason text
  status varchar(20) [not null, default: 'pending']
  approved_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table doctor_schedules {
  schedule_id uuid [pk]
  doctor_id uuid [not null]
  clinic_id uuid [not null]
  shift_id uuid
  work_date date [not null]
  room_id uuid
  max_patients int [not null, default: '20 ']
  status varchar(20) [not null, default: 'scheduled']
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table schedule_changes {
  change_id uuid [pk]
  schedule_id uuid [not null]
  changed_by uuid [not null]
  change_type varchar(50) [not null]
  old_values jsonb
  new_values jsonb
  reason text
  approved_by uuid
  approval_status varchar(20) [not null, default: 'pending']
  created_at timestamp [not null, default: `now()`]
}

Table service_categories {
  category_id uuid [pk]
  category_name varchar(255) [not null]
  description text
  parent_category_id uuid
  is_active boolean [not null, default: 'true ']
  display_order int
  created_at timestamp [not null, default: `now()`]
}

Table services {
  service_id uuid [pk]
  service_code varchar(50) [unique, not null]
  service_name varchar(255) [not null]
  category_id uuid
  specialty_id uuid
  description text
  duration_minutes int [not null, default: '30 ']
  required_room_type varchar [not null]
  base_price decimal(10,2)
  currency varchar(10) [not null, default: 'VND']
  is_active boolean [not null, default: 'true ']
  requires_appointment boolean [not null, default: 'true ']
  preparation_instructions text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table clinic_services {
  clinic_service_id uuid [pk]
  clinic_id uuid [not null]
  service_id uuid [not null]
  custom_price decimal(10,2)
  is_available boolean [not null, default: 'true ']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table appointments {
  appointment_id uuid [pk]
  appointment_code varchar(50) [unique, not null]
  patient_id uuid [not null]
  doctor_id uuid [not null]
  clinic_id uuid [not null]
  room_id uuid
  service_id uuid
  appointment_date date [not null]
  appointment_time time [not null]
  duration_minutes int [not null, default: '30 ']
  appointment_type varchar(50)
  status varchar(20) [not null, default: 'scheduled']
  chief_complaint text
  notes text
  session_id uuid
  treatment_plan_id uuid
  cancellation_reason text
  cancelled_by uuid
  cancelled_at timestamp
  is_outside_hours boolean [not null, default: 'false ']
  outside_hours_reason text
  approved_by uuid
  payment_id uuid
  payment_status varchar(20) [not null, default: 'unpaid']
  created_by uuid [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table appointment_status_history {
  history_id uuid [pk]
  appointment_id uuid [not null]
  old_status varchar(20)
  new_status varchar(20)
  changed_by uuid [not null]
  reason text
  created_at timestamp [not null, default: `now()`]
}

Table appointment_reminder_preferences {
  preference_id uuid [pk]
  patient_id uuid [not null]
  channel varchar(20) [not null, default: 'APP']
  enabled boolean [not null, default: 'true ']
  reminder_minutes_before int [not null, default: '1440 ']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table appointment_notification_logs {
  log_id uuid [pk]
  appointment_id uuid [not null]
  notification_type varchar(50) [not null]
  channel varchar(20) [not null, default: 'APP']
  status varchar(20) [not null]
  attempt_count int [not null, default: '0 ']
  notification_id varchar(100)
  preference_enabled boolean
  reminder_minutes_before int
  last_attempt_at timestamp
  next_retry_at timestamp
  error_message text
  read_at timestamp
  responded_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table diagnostic_orders {
  order_id uuid [pk]
  appointment_id uuid [not null]
  patient_id uuid [not null]
  doctor_id uuid [not null]
  order_code varchar(50) [unique, not null]
  order_type varchar(50) [not null]
  description text
  priority varchar(20) [not null, default: 'routine']
  tooth_number varchar(10)
  area varchar(100)
  status varchar(20) [not null, default: 'ordered']
  result_summary text
  result_attachment_url text
  notes text
  ordered_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table idempotency_keys {
  idempotency_key varchar(255) [pk]
  method varchar(10) [not null]
  path varchar(512) [not null]
  status varchar(20) [not null, default: 'in_progress']
  response_status int
  response_body jsonb
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
}

// ── Physical foreign keys (within this database) ──
Ref: treatment_rooms.clinic_id > clinics.clinic_id
Ref: doctor_specialties.specialty_id > specialties.specialty_id
Ref: doctor_schedules.clinic_id > clinics.clinic_id
Ref: doctor_schedules.shift_id > work_shifts.shift_id
Ref: doctor_schedules.room_id > treatment_rooms.room_id
Ref: schedule_changes.schedule_id > doctor_schedules.schedule_id
Ref: service_categories.parent_category_id > service_categories.category_id
Ref: services.category_id > service_categories.category_id
Ref: services.specialty_id > specialties.specialty_id
Ref: clinic_services.clinic_id > clinics.clinic_id
Ref: clinic_services.service_id > services.service_id
Ref: appointments.clinic_id > clinics.clinic_id
Ref: appointments.room_id > treatment_rooms.room_id
Ref: appointments.service_id > services.service_id
Ref: appointment_status_history.appointment_id > appointments.appointment_id
Ref: appointment_notification_logs.appointment_id > appointments.appointment_id
Ref: diagnostic_orders.appointment_id > appointments.appointment_id

