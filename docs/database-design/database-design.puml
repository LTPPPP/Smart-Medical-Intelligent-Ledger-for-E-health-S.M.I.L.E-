' ── Layout hints ──────────────────────────────────────────

' ── Intra-group grids ─────────────────────────────────────
' Group 1: Core entities (2×2)
users -[hidden]right- accounts
patients -[hidden]right- clinics
users -[hidden]down- patients
accounts -[hidden]down- clinics

' Group 2: Appointments (2+1)
appointments -[hidden]right- appointment_status_history
appointments -[hidden]down- diagnostic_orders

' Group 3: Medical records (2×2)
medical_records -[hidden]right- medical_record_versions
medical_history -[hidden]right- record_exports
medical_records -[hidden]down- medical_history
medical_record_versions -[hidden]down- record_exports

' Group 4: Examination (2+1)
examination_sessions -[hidden]right- diagnoses
examination_sessions -[hidden]down- symptoms

' Group 5: Treatment (2+1)
treatment_plans -[hidden]right- treatment_history
treatment_plans -[hidden]down- dental_charts

' Group 6: Prescriptions & orders (2×2)
prescriptions -[hidden]right- prescription_items
clinical_orders -[hidden]right- lab_test_results
prescriptions -[hidden]down- clinical_orders
prescription_items -[hidden]down- lab_test_results

' Group 7: Dental images (2×2)
dental_images -[hidden]right- image_annotations
image_categories -[hidden]right- pacs_sync_logs
dental_images -[hidden]down- image_categories
image_annotations -[hidden]down- pacs_sync_logs

' Group 8: Schedules (3+2)
doctor_schedules -[hidden]right- schedule_changes
schedule_changes -[hidden]right- treatment_rooms
doctor_leaves -[hidden]right- work_shifts
doctor_schedules -[hidden]down- doctor_leaves
schedule_changes -[hidden]down- work_shifts

' Group 9: Services & specialties (3+2)
services -[hidden]right- service_categories
service_categories -[hidden]right- clinic_services
specialties -[hidden]right- doctor_specialties
services -[hidden]down- specialties
service_categories -[hidden]down- doctor_specialties

' Group 10: Roles & permissions (2×2)
roles -[hidden]right- permissions
role_permissions -[hidden]right- user_roles
roles -[hidden]down- role_permissions
permissions -[hidden]down- user_roles

' Group 11: Auth & security (3+2)
oauth_connections -[hidden]right- otp_tokens
otp_tokens -[hidden]right- refresh_tokens
kyc_verifications -[hidden]right- audit_logs
oauth_connections -[hidden]down- kyc_verifications
otp_tokens -[hidden]down- audit_logs

' Group 12: Notifications (2×2)
notifications -[hidden]right- notification_templates
notification_delivery_logs -[hidden]right- notification_preferences
notifications -[hidden]down- notification_delivery_logs
notification_templates -[hidden]down- notification_preferences

' ── Cross-group 3-column skeleton ────────────────────────
' Col A vertical spine: IAM core → clinical main flow
users -[hidden]down- appointments
appointments -[hidden]down- medical_records
medical_records -[hidden]down- examination_sessions
examination_sessions -[hidden]down- prescriptions
prescriptions -[hidden]down- notifications

' Col B vertical spine: scheduling → treatment → dental images
roles -[hidden]down- doctor_schedules
doctor_schedules -[hidden]down- treatment_plans
treatment_plans -[hidden]down- dental_images
dental_images -[hidden]down- file

' Col C vertical spine: services → auth tokens
services -[hidden]down- oauth_connections
oauth_connections -[hidden]down- notification_preferences

' Row 0 horizontal: core entities → roles/perms → services
clinics -[hidden]right- roles
permissions -[hidden]right- services

' Row 1 horizontal: appointments → schedules → service details
appointment_status_history -[hidden]right- doctor_schedules
treatment_rooms -[hidden]right- service_categories

' Row 2 horizontal: medical records → treatment → dental images
medical_record_versions -[hidden]right- treatment_plans
dental_charts -[hidden]right- dental_images

' Row 3 horizontal: examination → prescriptions → notifications
diagnoses -[hidden]right- prescriptions
lab_test_results -[hidden]right- notification_delivery_logs

' Row 4 horizontal: auth tokens → notification prefs
refresh_tokens -[hidden]right- notification_preferences

' ── Relationships ─────────────────────────────────────────
users ||--o{ patients
patients ||--o{ appointments
users ||--o{ appointments
