@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentPlanView" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as planSvc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Open treatment plans for patient
activate user
activate form

form -> ctrl : 2. GET /api/v1/treatment-plans/patient/{patient_id}
activate ctrl

ctrl -> planSvc : 3. findByPatientId(patient_id)
activate planSvc

planSvc -> planEntity : 4. findByPatientId(patient_id)
activate planEntity
planEntity -> db : 5. SELECT treatment_plans WHERE patient_id
activate db
db --> planEntity : 6. return result
deactivate db
planEntity --> planSvc : 7. return TreatmentPlanEntity[]
deactivate planEntity

planSvc --> ctrl : 8. return TreatmentPlanEntity[]
deactivate planSvc

ctrl --> form : 9. 200 OK TreatmentPlanEntity[]
deactivate ctrl

form --> user : 10. Display treatment plan list
deactivate form

deactivate user

@enduml
