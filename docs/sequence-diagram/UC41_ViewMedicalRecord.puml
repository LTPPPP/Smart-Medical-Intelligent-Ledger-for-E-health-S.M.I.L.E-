@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "MedicalRecordPage" as page
participant ":MedicalRecordsController" as ctrl
participant ":MedicalRecordsService" as svc
entity "MedicalRecordEntity" as recEntity
entity "MedicalRecordVersionEntity" as verEntity
database "PostgreSQL" as db

user -> page : 1. Enter patient_id to search
activate user
activate page

page -> ctrl : 2. GET /medical-records/patient/{patient_id}
activate ctrl

ctrl -> svc : 3. findByPatient(patient_id)
activate svc

svc -> recEntity : 4. find(patient_id)
activate recEntity
recEntity -> db : 5. SELECT medical_records WHERE patient_id
activate db
db --> recEntity : 6. return result
deactivate db
recEntity --> svc : 7. return MedicalRecordEntity[]
deactivate recEntity

svc --> ctrl : 8. return MedicalRecordEntity[]
deactivate svc

ctrl --> page : 9. 200 OK MedicalRecordEntity[]
deactivate ctrl

page --> user : 10. Display records list
deactivate page

deactivate user

@enduml
