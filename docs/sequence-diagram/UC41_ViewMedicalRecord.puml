@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-041: View Medical Record

actor "Dentist" as user
boundary "MedicalRecordPage" as page
participant ":MedicalRecordsController" as ctrl
participant ":MedicalRecordsService" as svc
participant ":DiagnosesService" as diagSvc
participant ":PrescriptionsService" as presSvc
database "PostgreSQL" as db

user -> page : 1. Enter patient_id to search
activate user
activate page

page -> ctrl : 2. GET /medical-records/patient/:patient_id
activate ctrl

ctrl -> svc : 3. findByPatient(patient_id)
activate svc

svc -> db : 4. find({ where: { patient_id } })
activate db
db --> svc : 5. return MedicalRecordEntity[]
deactivate db

svc --> ctrl : 6. return MedicalRecordEntity[]
deactivate svc

ctrl --> page : 7. 200 OK
deactivate ctrl

page --> user : 8. Display records list

user -> page : 9. Select a record

page -> ctrl : 10. GET /medical-records/:record_id
activate ctrl

ctrl -> svc : 11. findOne(record_id)
activate svc

svc -> db : 12. findOne({ where: { record_id } })
activate db
db --> svc : 13. return MedicalRecordEntity / null
deactivate db

svc -> svc : 14. check record exists
activate svc
deactivate svc
alt record found
  svc --> ctrl : 15. return MedicalRecordEntity
  deactivate svc

  ctrl --> page : 16. 200 OK
  deactivate ctrl

  page -> diagSvc : 17. findBySessionId(session_id)
  activate diagSvc

  diagSvc -> db : 18. find({ where: { session_id } })
  activate db
  db --> diagSvc : 19. return DiagnosisEntity[]
  deactivate db

  diagSvc --> page : 20. return DiagnosisEntity[]
  deactivate diagSvc

  page -> presSvc : 21. findByRecordId(record_id)
  activate presSvc

  presSvc -> db : 22. find({ where: { record_id } })
  activate db
  db --> presSvc : 23. return PrescriptionEntity[]
  deactivate db

  presSvc --> page : 24. return PrescriptionEntity[]
  deactivate presSvc

  page --> user : 25. Display record with\ndiagnoses and prescriptions
  deactivate page
else record not found
  svc --> ctrl : 26. throw NotFoundException
  deactivate svc
  activate ctrl
  ctrl --> page : 27. 404 Not Found
  deactivate ctrl
  activate page
  page --> user : 28. Show error message
  deactivate page
end

deactivate user

@enduml
