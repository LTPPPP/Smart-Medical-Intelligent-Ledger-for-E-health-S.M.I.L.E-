@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC14: Create Diagnosis

actor "Dentist" as user
boundary "DiagnosisForm" as form
participant ":DiagnosesController" as ctrl
participant ":DiagnosesService" as svc
participant ":ExaminationSessionsService" as sessSvc
database "PostgreSQL" as db

user -> form : 1. Fill diagnosis_name, icd_code,\nseverity, diagnosis_type, notes
activate user
activate form

form -> form : 2. validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /diagnoses\n(CreateDiagnosisDto)
  activate ctrl

  ctrl -> svc : 4. create(CreateDiagnosisDto)
  activate svc

  svc -> sessSvc : 5. findOne(session_id)
  activate sessSvc

  sessSvc -> db : 6. findOne({ where: { session_id } })
  activate db
  db --> sessSvc : ExaminationSessionEntity / null
  deactivate db

  sessSvc -> sessSvc : 7. check session exists
  activate sessSvc
  deactivate sessSvc
  alt session found
    sessSvc --> svc : 8. ExaminationSessionEntity
    deactivate sessSvc

    svc -> db : 9. create(DiagnosisEntity)
    activate db
    db --> svc : DiagnosisEntity
    deactivate db

    svc -> db : 10. save(DiagnosisEntity)
    activate db
    db --> svc : DiagnosisEntity
    deactivate db

    svc --> ctrl : 11. DiagnosisEntity
    deactivate svc

    ctrl --> form : 12. 201 Created
    deactivate ctrl

    form --> user : 13. Show diagnosis created
    deactivate form
  else session not found
    activate sessSvc
    sessSvc --> svc : 14. throw NotFoundException
    deactivate sessSvc
    activate svc

    svc --> ctrl : 15. NotFoundException
    deactivate svc
    activate ctrl

    ctrl --> form : 16. 404 Not Found
    deactivate ctrl
    activate form

    form --> user : 17. Show error message
    deactivate form
  end
else validation fails
  form --> user : 18. Show validation errors
  deactivate form
end

deactivate user

@enduml
