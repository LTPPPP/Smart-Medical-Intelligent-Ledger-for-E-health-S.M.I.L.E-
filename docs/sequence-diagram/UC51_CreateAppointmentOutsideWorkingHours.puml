@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select patient, doctor, clinic,\ndate, time, outside hours reason,\napprover and submit
activate user
activate page

page -> page : 2. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 3. POST /api/v1/appointments/outside-hours\nBookOutsideHoursDto
  activate ctrl

  ctrl -> aptSvc : 4. createOutsideHours(BookOutsideHoursDto)
  activate aptSvc

  aptSvc -> kyc : 5. assertCanBook(created_by)
  activate kyc
  kyc --> aptSvc : 6. return eligible
  deactivate kyc

  aptSvc -> aptSvc : 7. generateAppointmentCode()
  activate aptSvc
  deactivate aptSvc

  aptSvc -> aptEntity : 8. save(appointment with\nis_outside_hours: true, outside_hours_reason, approved_by)
  activate aptEntity
  aptEntity -> db : 9. INSERT INTO appointments
  activate db
  db --> aptEntity : 10. return saved row
  deactivate db
  aptEntity --> aptSvc : 11. return Appointment
  deactivate aptEntity

  aptSvc -> histEntity : 12. save(old_status: null, new_status: SCHEDULED)
  activate histEntity
  histEntity -> db : 13. INSERT INTO appointment_status_history
  activate db
  db --> histEntity : 14. return saved row
  deactivate db
  histEntity --> aptSvc : 15. return AppointmentStatusHistory
  deactivate histEntity

  aptSvc --> ctrl : 16. return Appointment
deactivate aptSvc
  ctrl --> page : 17. 201 Created { Appointment }

  deactivate ctrl
  page --> user : 18. Show booking confirmation\n(flagged as outside hours)
else validation fails
  
  page --> user : 19. Show validation errors
  deactivate page
end

deactivate user

@enduml
