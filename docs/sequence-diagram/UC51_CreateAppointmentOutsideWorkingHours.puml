@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select patient, doctor, clinic,\ndate, time, outside hours reason,\napprover
activate user
activate page

user -> page : 2. Click "Request Appointment"
page -> page : 3. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 4. POST /api/v1/appointments/outside-hours\nBookOutsideHoursDto
  activate ctrl

  ctrl -> aptSvc : 5. createOutsideHours(BookOutsideHoursDto)
  activate aptSvc

  aptSvc -> kyc : 6. assertCanBook(created_by)
  activate kyc
  kyc --> aptSvc : 7. return eligible
  deactivate kyc

  aptSvc -> aptSvc : 8. generateAppointmentCode()
  activate aptSvc
  deactivate aptSvc

  aptSvc -> aptEntity : 9. save(appointment with\nis_outside_hours: true, outside_hours_reason, approved_by)
  activate aptEntity
  aptEntity -> db : 10. INSERT INTO appointments
  activate db
  db --> aptEntity : 11. return saved row
  deactivate db
  aptEntity --> aptSvc : 12. return Appointment
  deactivate aptEntity

  aptSvc -> histEntity : 13. save(old_status: null, new_status: SCHEDULED)
  activate histEntity
  histEntity -> db : 14. INSERT INTO appointment_status_history
  activate db
  db --> histEntity : 15. return saved row
  deactivate db
  histEntity --> aptSvc : 16. return AppointmentStatusHistory
  deactivate histEntity

  aptSvc --> ctrl : 17. return Appointment
deactivate aptSvc
  ctrl --> page : 18. 201 Created { Appointment }

  deactivate ctrl
  page --> user : 19. Show booking confirmation\n(flagged as outside hours)
else validation fails

  page --> user : 20. Show validation errors
  deactivate page
end

deactivate user

@enduml
