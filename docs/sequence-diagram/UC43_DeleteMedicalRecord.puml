@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "MedicalRecordDetailPanel" as form
participant ":MedicalRecordsController" as ctrl
participant ":MedicalRecordsService" as recSvc
entity "MedicalRecordEntity" as recEntity
database "PostgreSQL" as db

user -> form : 1. Click "Delete Record" and confirm
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/medical-records/{record_id}
activate ctrl

ctrl -> recSvc : 3. remove(record_id)
activate recSvc

recSvc -> recEntity : 4. findOne(record_id)
activate recEntity
recEntity -> db : 5. SELECT medical_record WHERE record_id
activate db
db --> recEntity : 6. return result
deactivate db
recEntity --> recSvc : 7. return MedicalRecordEntity
deactivate recEntity

recSvc -> recSvc : 8. check record exists
activate recSvc
deactivate recSvc
alt record found
  recSvc -> recEntity : 9. remove(record)
  activate recEntity
  recEntity -> db : 10. DELETE FROM medical_records WHERE record_id
  activate db
  db --> recEntity : 11. return deleted (affectedRows: 1)
  deactivate db
  recEntity --> recSvc : 12. return success
  deactivate recEntity

  recSvc --> ctrl : 13. return success
  ctrl --> form : 14. 204 No Content

  form --> user : 15. Display deletion confirmation
else record not found
  recSvc --> ctrl : 16. throw NotFoundException
  deactivate recSvc
  ctrl --> form : 17. 404 { message: Medical record not found }
  deactivate ctrl
  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
