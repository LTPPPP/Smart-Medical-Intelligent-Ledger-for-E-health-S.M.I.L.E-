@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-030: Create Work Schedule / On-Call Schedule

actor "Admin" as user
boundary "ScheduleManagementPanel" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
database "PostgreSQL" as db

user -> form : 1. Fill doctor, clinic, date, shift, room,\nmax patients and submit
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/doctor-schedules\n{ doctor_id, clinic_id, work_date, shift_id, room_id, max_patients }
  activate ctrl

  ctrl -> schSvc : 4. create(CreateDoctorScheduleDto)
  activate schSvc

  schSvc -> schSvc : 5. check shift_id provided
  activate schSvc
  deactivate schSvc
  opt shift_id provided
    schSvc -> db : 6. SELECT schedule WHERE doctor_id\nAND work_date AND shift_id
    activate db
    db --> schSvc : 7. return DoctorScheduleEntity / null
    deactivate db

    schSvc -> schSvc : 8. check duplicate exists
    activate schSvc
    deactivate schSvc
  end

  alt no duplicate found
    schSvc -> db : 9. INSERT doctor_schedule\n{ doctor_id, clinic_id, work_date, shift_id, room_id, max_patients }
    activate db
    db --> schSvc : 10. return DoctorScheduleEntity
    deactivate db

    schSvc --> ctrl : 11. return DoctorScheduleEntity
    deactivate schSvc

    ctrl --> form : 12. 201 Created DoctorScheduleEntity
    deactivate ctrl

    form --> user : 13. Display created schedule
    deactivate form
  else duplicate schedule exists
    schSvc --> ctrl : 14. throw ConflictException\n("Doctor already has a schedule for this date and shift")
    deactivate schSvc
    activate ctrl
    ctrl --> form : 15. 409 { message: Duplicate schedule }
    deactivate ctrl
    activate form
    form --> user : 16. Show conflict error
    deactivate form
  end
else validation fails
  form --> user : 17. Show validation errors
  deactivate form
end

deactivate user

@enduml
