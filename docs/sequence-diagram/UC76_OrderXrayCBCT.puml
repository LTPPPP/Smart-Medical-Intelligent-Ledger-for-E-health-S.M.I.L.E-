@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ExaminationPanel" as form
participant ":DiagnosticOrdersController" as ctrl
participant ":DiagnosticOrdersService" as orderSvc
entity "DiagnosticOrderEntity" as orderEntity
database "PostgreSQL" as db

user -> form : 1. Select order type X-RAY or CBCT,\nfill description, priority, notes
activate user
activate form

user -> form : 2. Click "Place Order"
form -> form : 3. validate: appointment_id, patient_id\nand doctor_id are not empty,\norder_type is a value of OrderType (XRAY / CBCT),\npriority is a value of OrderPriority if provided
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/diagnostic-orders\n{ appointment_id, patient_id, doctor_id,\norder_type: X-RAY/CBCT, description, priority }
  activate ctrl

  ctrl -> orderSvc : 5. create(CreateDiagnosticOrderDto)
  activate orderSvc

  orderSvc -> orderSvc : 6. generateOrderCode(X-RAY)\n→ DO-XRAY-YYYYMMDD-XXXX
  activate orderSvc
  deactivate orderSvc

  orderSvc -> orderEntity : 7. save(DiagnosticOrderEntity)
  activate orderEntity
  orderEntity -> db : 8. INSERT INTO diagnostic_orders\n{ order_code, order_type: X-RAY/CBCT,\nstatus: ORDERED, ordered_at: NOW() }
  activate db
  db --> orderEntity : 9. return record
  deactivate db
  orderEntity --> orderSvc : 10. return DiagnosticOrderEntity
  deactivate orderEntity

  orderSvc --> ctrl : 11. return DiagnosticOrderEntity
  deactivate orderSvc

  ctrl --> form : 12. 201 Created DiagnosticOrderEntity
  deactivate ctrl

  form --> user : 13. Display created X-ray/CBCT order\n(order code, status: ORDERED)
  deactivate form
else validation fails
  form --> user : 14. Show validation errors
  deactivate form
end

deactivate user

@enduml
