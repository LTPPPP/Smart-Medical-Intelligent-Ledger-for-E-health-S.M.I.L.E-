@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-060: Refund / Cancel Payment

actor "Admin" as user
boundary "PaymentDetailPanel" as form
participant ":PaymentController" as ctrl
participant ":PaymentService" as paySvc
participant "VNPay" as vnpay
database "PostgreSQL" as db

user -> form : 1. Click "Refund" on a completed payment
activate user
activate form

form -> ctrl : 2. POST /api/v1/payments/{id}/refund\n{ reason, refund_amount }
activate ctrl

ctrl -> paySvc : 3. processRefund(id, reason, amount)
activate paySvc

paySvc -> db : 4. SELECT payment WHERE payment_id
activate db
db --> paySvc : 5. return Payment / null
deactivate db

paySvc -> paySvc : 6. Validate payment is COMPLETED\nand refund amount <= original amount
activate paySvc
deactivate paySvc
alt refund valid
  paySvc -> vnpay : 7. Send refund request to VNPay
  activate vnpay
  vnpay --> paySvc : 8. return Refund response { rspCode }
  deactivate vnpay

  paySvc -> db : 9. UPDATE payment SET status = REFUNDED
  activate db
  db --> paySvc : 10. return updated Payment
  deactivate db

  paySvc -> db : 11. INSERT payment_transaction\n{ type: REFUND, amount, status: SUCCESS }
  activate db
  db --> paySvc : 12. return PaymentTransaction
  deactivate db

  paySvc --> ctrl : 13. return { message: "Refund processed", transaction }
  deactivate paySvc

  ctrl --> form : 14. 200 OK { message, transaction }
  deactivate ctrl

  form --> user : 15. Display refund confirmation
  deactivate form
else refund invalid
  paySvc --> ctrl : 16. throw BadRequestException
  deactivate paySvc
  activate ctrl
  ctrl --> form : 17. 400 { message: Invalid refund request }
  deactivate ctrl
  activate form
  form --> user : 18. Show refund error
  deactivate form
end

deactivate user

@enduml
