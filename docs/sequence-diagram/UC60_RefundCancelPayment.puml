@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "AppointmentDetailPanel" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant "VNPay" as vnpay
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Click "Refund" on a completed appointment
activate user
activate page

page -> ctrl : 2. POST /api/v1/appointments/{id}/refund\n{ reason, refund_amount }
activate ctrl

ctrl -> aptSvc : 3. processRefund(id, reason, amount)
activate aptSvc

aptSvc -> aptEntity : 4. findOne(appointment_id)
activate aptEntity
aptEntity -> db : 5. SELECT * FROM appointments WHERE appointment_id
activate db
db --> aptEntity : 6. return row
deactivate db
aptEntity --> aptSvc : 7. return Appointment
deactivate aptEntity

aptSvc -> aptSvc : 8. validate payment is COMPLETED\nand refund amount <= original amount
activate aptSvc
deactivate aptSvc
alt refund valid
  aptSvc -> vnpay : 9. send refund request to VNPay
  activate vnpay
  vnpay --> aptSvc : 10. return Refund response { rspCode }
  deactivate vnpay

  aptSvc -> aptEntity : 11. save(payment_status = REFUNDED)
  activate aptEntity
  aptEntity -> db : 12. UPDATE appointments SET payment_status = REFUNDED
  activate db
  db --> aptEntity : 13. return updated row
  deactivate db
  aptEntity --> aptSvc : 14. return Appointment
  deactivate aptEntity

  aptSvc --> ctrl : 15. return { message: "Refund processed" }

  ctrl --> page : 16. 200 OK { message }

  page --> user : 17. Display refund confirmation
else refund invalid
  aptSvc --> ctrl : 18. throw BadRequestException
  deactivate aptSvc

  ctrl --> page : 19. 400 { Invalid refund request }
  deactivate ctrl

  page --> user : 20. Show refund error
  deactivate page
end

deactivate user

@enduml
