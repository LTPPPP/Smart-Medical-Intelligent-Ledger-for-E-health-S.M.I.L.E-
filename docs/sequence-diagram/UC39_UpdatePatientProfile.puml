@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "PatientDetailPanel" as form
participant ":PatientsController" as ctrl
participant ":PatientsService" as patSvc
entity "PatientEntity" as patEntity
database "PostgreSQL" as db

user -> form : 1. Edit patient fields
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> ctrl : 3. PATCH /api/v1/patients/{patient_id}\nUpdatePatientDto
activate ctrl

ctrl -> patSvc : 4. update(patient_id, UpdatePatientDto)
activate patSvc

patSvc -> patEntity : 5. findOne(patient_id)
activate patEntity
patEntity -> db : 6. SELECT patient WHERE patient_id
activate db
db --> patEntity : 7. return result
deactivate db
patEntity --> patSvc : 8. return PatientEntity
deactivate patEntity

patSvc -> patSvc : 9. check patient exists
activate patSvc
deactivate patSvc
alt patient found
  patSvc -> patEntity : 10. save(updatedPatient)
  activate patEntity
  patEntity -> db : 11. UPDATE patient SET changed fields
  activate db
  db --> patEntity : 12. return updated row
  deactivate db
  patEntity --> patSvc : 13. return PatientEntity
  deactivate patEntity

  patSvc --> ctrl : 14. return PatientEntity

  ctrl --> form : 15. 200 OK PatientEntity
  form --> user : 16. Display updated patient profile
else patient not found
  patSvc --> ctrl : 17. throw NotFoundException
  deactivate patSvc
  ctrl --> form : 18. 404 { message: Patient not found }
  deactivate ctrl
  form --> user : 19. Show not found error
  deactivate form
end

deactivate user

@enduml
