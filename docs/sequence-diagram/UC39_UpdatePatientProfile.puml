@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-039: Update Patient Profile

actor "Staff" as user
boundary "PatientDetailPanel" as form
participant ":PatientsController" as ctrl
participant ":PatientsService" as patSvc
database "PostgreSQL" as db

user -> form : 1. Edit patient fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/patients/{patient_id}\nUpdatePatientDto
activate ctrl

ctrl -> patSvc : 3. update(patient_id, UpdatePatientDto)
activate patSvc

patSvc -> db : 4. SELECT patient WHERE patient_id
activate db
db --> patSvc : 5. return PatientEntity / null
deactivate db

patSvc -> patSvc : 6. check patient exists
activate patSvc
deactivate patSvc
alt patient found
  patSvc -> db : 7. UPDATE patient SET changed fields
  activate db
  db --> patSvc : 8. return updated PatientEntity
  deactivate db

  patSvc --> ctrl : 9. return PatientEntity
  deactivate patSvc

  ctrl --> form : 10. 200 OK PatientEntity
  deactivate ctrl

  form --> user : 11. Display updated patient profile
  deactivate form
else patient not found
  patSvc --> ctrl : 12. throw NotFoundException
  deactivate patSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Patient not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
