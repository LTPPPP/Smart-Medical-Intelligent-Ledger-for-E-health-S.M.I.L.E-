@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-014: View Permissions

actor "Admin" as user
boundary "PermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
database "PostgreSQL" as db

user -> form : 1. Open permissions management page
activate user
activate form

form -> ctrl : 2. GET /api/v1/permissions
activate ctrl

ctrl -> permSvc : 3. findAll()
activate permSvc

permSvc -> db : 4. SELECT permissions
activate db
db --> permSvc : 5. return PermissionEntity[]
deactivate db

permSvc --> ctrl : 6. return PermissionEntity[]
deactivate permSvc

ctrl --> form : 7. 200 OK PermissionEntity[]
deactivate ctrl

form --> user : 8. Display permission list\n(permission_name, resource, action, description)
deactivate form

opt View permissions by role
  user -> form : 9. Select a role to view its permissions
  activate form

  form -> ctrl : 10. GET /api/v1/permissions/role/{roleId}
  activate ctrl

  ctrl -> permSvc : 11. getPermissionsByRole(roleId)
  activate permSvc

  permSvc -> db : 12. SELECT permissions JOIN role_permissions\nWHERE role_id
  activate db
  db --> permSvc : 13. return PermissionEntity[]
  deactivate db

  permSvc --> ctrl : 14. return PermissionEntity[]
  deactivate permSvc

  ctrl --> form : 15. 200 OK PermissionEntity[]
  deactivate ctrl

  form --> user : 16. Display role's permissions
  deactivate form
end

deactivate user

@enduml
