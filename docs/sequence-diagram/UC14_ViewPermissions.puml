@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "PermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
entity "PermissionEntity" as permEntity
database "PostgreSQL" as db

user -> form : 1. Open permissions management page
activate user
activate form

form -> ctrl : 2. GET /api/v1/permissions
activate ctrl

ctrl -> permSvc : 3. findAll()
activate permSvc

permSvc -> permEntity : 4. find()
activate permEntity
permEntity -> db : 5. SELECT permissions
activate db
db --> permEntity : 6. return results
deactivate db
permEntity --> permSvc : 7. return Permission[]
deactivate permEntity

permSvc --> ctrl : 8. return PermissionEntity[]
deactivate permSvc

ctrl --> form : 9. 200 OK PermissionEntity[]
deactivate ctrl

form --> user : 10. Display permission list\n(permission_name, resource, action, description)
deactivate form

opt View permissions by role
  user -> form : 11. Select a role to view its permissions
  activate form

  form -> ctrl : 12. GET /api/v1/permissions/role/{roleId}
  activate ctrl

  ctrl -> permSvc : 13. getPermissionsByRole(roleId)
  activate permSvc

  permSvc -> permEntity : 14. find(roleId)
  activate permEntity
  permEntity -> db : 15. SELECT permissions JOIN role_permissions\nWHERE role_id
  activate db
  db --> permEntity : 16. return results
  deactivate db
  permEntity --> permSvc : 17. return Permission[]
  deactivate permEntity

  permSvc --> ctrl : 18. return PermissionEntity[]
  deactivate permSvc

  ctrl --> form : 19. 200 OK PermissionEntity[]
  deactivate ctrl

  form --> user : 20. Display role's permissions
  deactivate form
end

deactivate user

@enduml
