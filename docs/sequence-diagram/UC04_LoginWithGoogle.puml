@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-004: Login with Google

actor "User" as user
boundary "LoginForm" as form
participant "Google OAuth" as google
participant ":AuthGoogleController" as gCtrl
participant ":AuthGoogleService" as gSvc
participant ":AuthService" as authSvc
participant ":OAuthConnectionsService" as oauthSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
database "PostgreSQL" as db

user -> form : 1. Click "Login with Google"
activate user
activate form

form -> google : 2. Redirect to Google OAuth consent screen
activate google
user -> google : 3. Authorize and grant access
google --> form : 4. return idToken / accessToken
deactivate google

form -> gCtrl : 5. POST /api/v1/auth/google { token }
activate gCtrl

gCtrl -> gSvc : 6. validateLogin({ token })
activate gSvc

gSvc -> google : 7. verifyIdToken(token) or fetch userinfo
activate google
google --> gSvc : 8. return { sub, email, given_name, family_name }
deactivate google

gSvc --> gCtrl : 9. return SocialInterface { id, email, firstName, lastName }
deactivate gSvc

gCtrl -> authSvc : 10. validateSocialLogin("google", socialData)
activate authSvc

authSvc -> oauthSvc : 11. findByProviderAndUserId("google", socialId)
activate oauthSvc
oauthSvc -> db : 12. SELECT oauth_connection WHERE provider AND provider_user_id
activate db
db --> oauthSvc : 13. return OAuthConnection / null
deactivate db
oauthSvc --> authSvc : 14. return OAuthConnection / null
deactivate oauthSvc

alt existing connection found
  authSvc -> accSvc : 15. findById(connection.accountId)
  activate accSvc
  accSvc -> db : 16. SELECT account WHERE accountId
  activate db
  db --> accSvc : 17. return Account
  deactivate db
  accSvc --> authSvc : 18. return Account
  deactivate accSvc
else no connection — check by email
  authSvc -> accSvc : 19. findByEmail(socialEmail)
  activate accSvc
  accSvc -> db : 20. SELECT account WHERE email
  activate db
  db --> accSvc : 21. return Account / null
  deactivate db
  accSvc --> authSvc : 22. return Account / null
  deactivate accSvc

  alt no account exists — create new
    authSvc -> accSvc : 23. create({ email, fullName, role: PATIENT })
    activate accSvc
    accSvc -> db : 24. INSERT account
    activate db
    db --> accSvc : 25. return Account
    deactivate db
    accSvc --> authSvc : 26. return Account
    deactivate accSvc

    authSvc -> profSvc : 27. create({ full_name, email }, accountId)
    activate profSvc
    profSvc -> db : 28. INSERT user_profile
    activate db
    db --> profSvc : 29. return UserProfile
    deactivate db
    profSvc --> authSvc : 30. return UserProfile
    deactivate profSvc
  end

  authSvc -> oauthSvc : 31. create({ accountId, provider, providerUserId })
  activate oauthSvc
  oauthSvc -> db : 32. INSERT oauth_connection
  activate db
  db --> oauthSvc : 33. return OAuthConnection
  deactivate db
  oauthSvc --> authSvc : 34. return OAuthConnection
  deactivate oauthSvc
end

authSvc --> gCtrl : 35. return LoginResponseDto { token, refreshToken, user }
deactivate authSvc

gCtrl --> form : 36. 200 OK LoginResponseDto
deactivate gCtrl

form --> user : 37. Navigate to dashboard
deactivate form

deactivate user

@enduml
