@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "LoginForm" as form
participant "Google OAuth" as google
participant ":AuthGoogleController" as gCtrl
participant ":AuthGoogleService" as gSvc
participant ":AuthService" as authSvc
participant ":OAuthConnectionsService" as oauthSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
entity "OAuthConnectionEntity" as oauthEntity
entity "AccountEntity" as accEntity
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db

user -> form : 1. Click "Login with Google"
activate user
activate form

form -> google : 2. Redirect to Google OAuth consent screen
activate google
google --> user : 3. Display Google login popup
user -> google : 4. Authorize and grant access
google ->> gCtrl : 5. OAuth callback { authorization_code }
deactivate google
activate gCtrl

gCtrl -> gSvc : 6. validateLogin({ code })
activate gSvc

gSvc -> google : 7. verifyIdToken(token) or fetch userinfo
activate google
google --> gSvc : 8. return { sub, email, given_name, family_name }
deactivate google

gSvc --> gCtrl : 9. return SocialInterface { id, email, firstName, lastName }
deactivate gSvc

gCtrl -> authSvc : 10. validateSocialLogin("google", socialData)
activate authSvc

authSvc -> oauthSvc : 11. findByProviderAndUserId("google", socialId)
activate oauthSvc

oauthSvc -> oauthEntity : 12. findOne(provider, providerUserId)
activate oauthEntity
oauthEntity -> db : 13. SELECT oauth_connection WHERE provider AND provider_user_id
activate db
db --> oauthEntity : 14. return result
deactivate db
oauthEntity --> oauthSvc : 15. return OAuthConnection
deactivate oauthEntity

oauthSvc --> authSvc : 16. return OAuthConnection
deactivate oauthSvc

authSvc -> authSvc : 17. check existing connection
activate authSvc
deactivate authSvc
alt existing connection found
  authSvc -> accSvc : 18. findById(connection.accountId)
  activate accSvc

  accSvc -> accEntity : 19. findOne(accountId)
  activate accEntity
  accEntity -> db : 20. SELECT account WHERE accountId
  activate db
  db --> accEntity : 21. return result
  deactivate db
  accEntity --> accSvc : 22. return Account
  deactivate accEntity

  accSvc --> authSvc : 23. return Account
  deactivate accSvc
else no connection — check by email
  authSvc -> accSvc : 24. findByEmail(socialEmail)
  activate accSvc

  accSvc -> accEntity : 25. findByEmail(email)
  activate accEntity
  accEntity -> db : 26. SELECT account WHERE email
  activate db
  db --> accEntity : 27. return result
  deactivate db
  accEntity --> accSvc : 28. return Account
  deactivate accEntity

  accSvc --> authSvc : 29. return Account
  deactivate accSvc

  authSvc -> authSvc : 30. check if account exists
  activate authSvc
  deactivate authSvc
  alt no account exists — create new
    authSvc -> accSvc : 31. create({ email, fullName, role: PATIENT })
    activate accSvc

    accSvc -> accEntity : 32. save(email, fullName, role)
    activate accEntity
    accEntity -> db : 33. INSERT account
    activate db
    db --> accEntity : 34. return saved row
    deactivate db
    accEntity --> accSvc : 35. return Account
    deactivate accEntity

    accSvc --> authSvc : 36. return Account
    deactivate accSvc

    authSvc -> profSvc : 37. create({ full_name, email }, accountId)
    activate profSvc

    profSvc -> profEntity : 38. save(accountId, fullName, email)
    activate profEntity
    profEntity -> db : 39. INSERT user_profile
    activate db
    db --> profEntity : 40. return saved row
    deactivate db
    profEntity --> profSvc : 41. return UserProfile
    deactivate profEntity

    profSvc --> authSvc : 42. return UserProfile
    deactivate profSvc
  end

  authSvc -> oauthSvc : 43. create({ accountId, provider, providerUserId })
  activate oauthSvc

  oauthSvc -> oauthEntity : 44. save(accountId, provider, providerUserId)
  activate oauthEntity
  oauthEntity -> db : 45. INSERT oauth_connection
  activate db
  db --> oauthEntity : 46. return saved row
  deactivate db
  oauthEntity --> oauthSvc : 47. return OAuthConnection
  deactivate oauthEntity

  oauthSvc --> authSvc : 48. return OAuthConnection
  deactivate oauthSvc
end

authSvc --> gCtrl : 49. return LoginResponseDto { token, refreshToken, user }
deactivate authSvc

gCtrl --> form : 50. 200 OK LoginResponseDto
deactivate gCtrl

form --> user : 51. Navigate to dashboard
deactivate form

deactivate user

@enduml
