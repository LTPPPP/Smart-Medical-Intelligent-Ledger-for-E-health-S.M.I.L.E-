@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "LoginForm" as form
participant "Google OAuth" as google
participant ":AuthGoogleController" as gCtrl
participant ":AuthGoogleService" as gSvc
participant ":AuthService" as authSvc
participant ":OAuthConnectionsService" as oauthSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
entity "OAuthConnectionEntity" as oauthEntity
entity "AccountEntity" as accEntity
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db

user -> form : 1. Click "Login with Google"
activate user
activate form

form -> google : 2. Redirect to Google OAuth consent screen
activate google
user -> google : 3. Authorize and grant access
google --> form : 4. return idToken / accessToken
deactivate google

form -> gCtrl : 5. POST /api/v1/auth/google { token }
activate gCtrl

gCtrl -> gSvc : 6. validateLogin({ token })
activate gSvc

gSvc -> google : 7. verifyIdToken(token) or fetch userinfo
activate google
google --> gSvc : 8. return { sub, email, given_name, family_name }
deactivate google

gSvc --> gCtrl : 9. return SocialInterface { id, email, firstName, lastName }
deactivate gSvc

gCtrl -> authSvc : 10. validateSocialLogin("google", socialData)
activate authSvc

authSvc -> oauthSvc : 11. findByProviderAndUserId("google", socialId)
activate oauthSvc

oauthSvc -> oauthEntity : 12. findOne(provider, providerUserId)
activate oauthEntity
oauthEntity -> db : 13. SELECT oauth_connection WHERE provider AND provider_user_id
activate db
db --> oauthEntity : 14. return result
deactivate db
oauthEntity --> oauthSvc : 15. return OAuthConnection
deactivate oauthEntity

oauthSvc --> authSvc : 16. return OAuthConnection
deactivate oauthSvc

alt existing connection found
  authSvc -> accSvc : 17. findById(connection.accountId)
  activate accSvc

  accSvc -> accEntity : 18. findOne(accountId)
  activate accEntity
  accEntity -> db : 19. SELECT account WHERE accountId
  activate db
  db --> accEntity : 20. return result
  deactivate db
  accEntity --> accSvc : 21. return Account
  deactivate accEntity

  accSvc --> authSvc : 22. return Account
  deactivate accSvc
else no connection — check by email
  authSvc -> accSvc : 23. findByEmail(socialEmail)
  activate accSvc

  accSvc -> accEntity : 24. findByEmail(email)
  activate accEntity
  accEntity -> db : 25. SELECT account WHERE email
  activate db
  db --> accEntity : 26. return result
  deactivate db
  accEntity --> accSvc : 27. return Account
  deactivate accEntity

  accSvc --> authSvc : 28. return Account
  deactivate accSvc

  alt no account exists — create new
    authSvc -> accSvc : 29. create({ email, fullName, role: PATIENT })
    activate accSvc

    accSvc -> accEntity : 30. save(email, fullName, role)
    activate accEntity
    accEntity -> db : 31. INSERT account
    activate db
    db --> accEntity : 32. return saved row
    deactivate db
    accEntity --> accSvc : 33. return Account
    deactivate accEntity

    accSvc --> authSvc : 34. return Account
    deactivate accSvc

    authSvc -> profSvc : 35. create({ full_name, email }, accountId)
    activate profSvc

    profSvc -> profEntity : 36. save(accountId, fullName, email)
    activate profEntity
    profEntity -> db : 37. INSERT user_profile
    activate db
    db --> profEntity : 38. return saved row
    deactivate db
    profEntity --> profSvc : 39. return UserProfile
    deactivate profEntity

    profSvc --> authSvc : 40. return UserProfile
    deactivate profSvc
  end

  authSvc -> oauthSvc : 41. create({ accountId, provider, providerUserId })
  activate oauthSvc

  oauthSvc -> oauthEntity : 42. save(accountId, provider, providerUserId)
  activate oauthEntity
  oauthEntity -> db : 43. INSERT oauth_connection
  activate db
  db --> oauthEntity : 44. return saved row
  deactivate db
  oauthEntity --> oauthSvc : 45. return OAuthConnection
  deactivate oauthEntity

  oauthSvc --> authSvc : 46. return OAuthConnection
  deactivate oauthSvc
end

authSvc --> gCtrl : 47. return LoginResponseDto { token, refreshToken, user }
deactivate authSvc

gCtrl --> form : 48. 200 OK LoginResponseDto
deactivate gCtrl

form --> user : 49. Navigate to dashboard
deactivate form

deactivate user

@enduml
