@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ScheduleRegistrationForm" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
entity "DoctorLeaveEntity" as leaveEntity
database "PostgreSQL" as db

user -> form : 1. Select clinic, date, shift, room,\nmax patients and submit
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/doctor-schedules\n{ doctor_id, clinic_id, work_date, shift_id, room_id, max_patients }
  activate ctrl

  ctrl -> schSvc : 4. create(CreateDoctorScheduleDto)
  activate schSvc

  opt shift_id provided
    schSvc -> leaveEntity : 5. findOne(doctorId, workDate, shiftId)
    activate leaveEntity
    leaveEntity -> db : 6. SELECT schedule WHERE doctor_id\nAND work_date AND shift_id
    activate db
    db --> leaveEntity : 7. return result
    deactivate db
    leaveEntity --> schSvc : 8. return DoctorLeaveEntity
    deactivate leaveEntity

    schSvc -> schSvc : 9. check duplicate
    activate schSvc
    deactivate schSvc
  end

  alt no duplicate
    schSvc -> leaveEntity : 10. save(schedule)
    activate leaveEntity
    leaveEntity -> db : 11. INSERT doctor_schedule
    activate db
    db --> leaveEntity : 12. return saved row
    deactivate db
    leaveEntity --> schSvc : 13. return DoctorLeaveEntity
    deactivate leaveEntity

    schSvc --> ctrl : 14. return DoctorLeaveEntity

    ctrl --> form : 15. 201 Created DoctorLeaveEntity

    form --> user : 16. Display registered schedule
  else duplicate exists
    schSvc --> ctrl : 17. throw ConflictException
    deactivate schSvc

    ctrl --> form : 18. 409 { message: Schedule already exists }
    deactivate ctrl

    form --> user : 19. Show conflict error
  end
else validation fails
  form --> user : 20. Show validation errors
  deactivate form
end

deactivate user

@enduml
