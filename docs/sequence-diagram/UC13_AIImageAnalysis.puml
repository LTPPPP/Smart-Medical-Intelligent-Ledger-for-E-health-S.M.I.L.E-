@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC 13: AI Image Analysis

actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":MedicalService" as medSvc
queue "RabbitMQ" as mq
participant ":AIService" as aiSvc
participant ":ExaminationSessionsService" as examSvc
database "PostgreSQL" as db

user -> page : 1. Select uploaded dental image\nand click Analyze
activate user
activate page

page -> medSvc : 2. POST /api/v1/images/:imageId/analyze
activate medSvc

medSvc -> db : 3. findOne(image_id)
activate db
db --> medSvc : DentalImageEntity / null
deactivate db

alt image exists
  medSvc -> mq : 4. publish(image_url, imageId, sessionId)\nto analysis queue
  activate mq
  mq --> medSvc : 5. ack
  deactivate mq

  medSvc --> page : 6. 202 Accepted — analysis queued
  deactivate medSvc

  page --> user : 7. Display analysis in progress
  deactivate page

  mq -> aiSvc : 8. consume(image analysis message)
  activate mq
  activate aiSvc
  deactivate mq

  aiSvc -> aiSvc : 9. Download image from image_url
  activate aiSvc
  deactivate aiSvc

  aiSvc -> aiSvc : 10. Run MobileNetV3 inference
  activate aiSvc
  deactivate aiSvc

  aiSvc -> aiSvc : 11. Generate findings and segmentation masks
  activate aiSvc
  deactivate aiSvc

  aiSvc -> mq : 12. publish(findings JSON, masks)\nto results queue
  activate mq
  deactivate aiSvc
  mq --> mq : 13. enqueue results
  activate mq
  deactivate mq

  mq -> medSvc : 14. consume(AI findings message)
  activate medSvc
  deactivate mq

  medSvc -> examSvc : 15. update(sessionId, {ai_findings})
  activate examSvc

  examSvc -> db : 16. findOne(session_id)
  activate db
  db --> examSvc : ExaminationSessionEntity
  deactivate db

  examSvc -> db : 17. save(ExaminationSessionEntity with ai_findings)
  activate db
  db --> examSvc : ExaminationSessionEntity
  deactivate db

  examSvc --> medSvc : 18. ExaminationSessionEntity
  deactivate examSvc

  medSvc -> page : 19. Stream update via SSE/WebSocket
  activate page
  deactivate medSvc

  page --> user : 20. Display AI overlays\n(caries detection, landmarks)
  deactivate page
else image not found
  activate medSvc
  medSvc --> page : 21. 404 Not Found
  deactivate medSvc
  activate page
  page --> user : 22. Show image not found error
  deactivate page
end

deactivate user

@enduml
