@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC: AI Image Analysis

actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":MedicalService" as medSvc
queue "RabbitMQ" as mq
participant ":AIService" as aiSvc
participant ":ExaminationSessionsService" as examSvc
database "PostgreSQL" as db

user -> page : 1. Select uploaded dental image\nand click Analyze
activate user
activate page

page -> medSvc : 2. POST /api/v1/images/:imageId/analyze
activate medSvc

medSvc -> db : 3. findOne(image_id)
activate db
db --> medSvc : DentalImageEntity / null
deactivate db

medSvc -> medSvc : 4. check image exists
activate medSvc
deactivate medSvc
alt image exists
  medSvc -> mq : 5. publish(image_url, imageId, sessionId)\nto analysis queue
  activate mq
  mq --> medSvc : 6. ack
  deactivate mq

  medSvc --> page : 7. 202 Accepted — analysis queued
  deactivate medSvc

  page --> user : 8. Display analysis in progress
  deactivate page

  mq -> aiSvc : 9. consume(image analysis message)
  activate mq
  activate aiSvc
  deactivate mq

  aiSvc -> aiSvc : 10. Download image from image_url
  activate aiSvc
  deactivate aiSvc

  aiSvc -> aiSvc : 11. Run MobileNetV3 inference
  activate aiSvc
  deactivate aiSvc

  aiSvc -> aiSvc : 12. Generate findings and segmentation masks
  activate aiSvc
  deactivate aiSvc

  aiSvc -> mq : 13. publish(findings JSON, masks)\nto results queue
  activate mq
  deactivate aiSvc
  mq --> mq : 14. enqueue results
  activate mq
  deactivate mq

  mq -> medSvc : 15. consume(AI findings message)
  activate medSvc
  deactivate mq

  medSvc -> examSvc : 16. update(sessionId, {ai_findings})
  activate examSvc

  examSvc -> db : 17. findOne(session_id)
  activate db
  db --> examSvc : ExaminationSessionEntity
  deactivate db

  examSvc -> db : 18. save(ExaminationSessionEntity with ai_findings)
  activate db
  db --> examSvc : ExaminationSessionEntity
  deactivate db

  examSvc --> medSvc : 19. ExaminationSessionEntity
  deactivate examSvc

  medSvc -> page : 20. Stream update via SSE/WebSocket
  activate page
  deactivate medSvc

  page --> user : 21. Display AI overlays\n(caries detection, landmarks)
  deactivate page
else image not found
  medSvc --> page : 22. 404 Not Found
  deactivate medSvc
  activate page
  page --> user : 23. Show image not found error
  deactivate page
end

deactivate user

@enduml
