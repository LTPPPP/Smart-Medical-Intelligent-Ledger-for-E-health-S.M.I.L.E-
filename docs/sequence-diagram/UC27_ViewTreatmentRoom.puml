@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-027: View Treatment Room

actor "Admin" as user
boundary "ClinicDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
database "PostgreSQL" as db

user -> form : 1. Open clinic detail, view treatment rooms tab
activate user
activate form

form -> ctrl : 2. GET /api/v1/clinics/{clinicId}/treatment-rooms\n?page=1&limit=10
activate ctrl

ctrl -> roomSvc : 3. findAllByClinic(clinicId, QueryTreatmentRoomDto)
activate roomSvc

roomSvc -> db : 4. SELECT treatment_rooms WHERE clinic_id\nwith filters (room_type, status)\nORDER BY created_at DESC
activate db
db --> roomSvc : { data: TreatmentRoomEntity[], total }
deactivate db

roomSvc --> ctrl : { data, total }
deactivate roomSvc

ctrl --> form : 5. 200 OK { data, meta }
deactivate ctrl

form --> user : 6. Display treatment rooms list
deactivate form

opt View room detail
  user -> form : 7. Select a room
  activate form

  form -> ctrl : 8. GET /api/v1/treatment-rooms/{id}
  activate ctrl

  ctrl -> roomSvc : 9. findById(id)
  activate roomSvc

  roomSvc -> db : 10. SELECT treatment_room WHERE room_id\nwith clinic relation
  activate db
  db --> roomSvc : TreatmentRoomEntity / null
  deactivate db

  roomSvc --> ctrl : TreatmentRoomEntity / null
  deactivate roomSvc

  ctrl --> form : 11. 200 OK TreatmentRoomEntity
  deactivate ctrl

  form --> user : 12. Display room detail\n(name, type, floor, capacity, equipment, status)
  deactivate form
end

deactivate user

@enduml
