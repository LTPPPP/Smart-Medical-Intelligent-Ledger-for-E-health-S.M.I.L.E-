@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC 24: Manage Clinics

actor "Admin" as user
boundary "ClinicManagementPanel" as form
participant ":ClinicsController" as clinicCtrl
participant ":ClinicsService" as clinicSvc
participant ":ServicesController" as svcCtrl
participant ":ServicesService" as svcSvc
database "PostgreSQL" as db

user -> form : 1. Open clinic management panel
activate user
activate form

form -> clinicCtrl : 2. GET /api/v1/clinics
activate clinicCtrl

clinicCtrl -> clinicSvc : 3. findAll(QueryClinicDto)
activate clinicSvc

clinicSvc -> db : 4. SELECT clinics with filters (name, city, district, status)
activate db
db --> clinicSvc : ClinicEntity[]
deactivate db

clinicSvc --> clinicCtrl : { data: ClinicEntity[], total }
deactivate clinicSvc

clinicCtrl --> form : 5. 200 OK { data, meta }
deactivate clinicCtrl

form --> user : 6. Display clinic list
deactivate form

user -> form : 7. Select a clinic to view details
activate form

form -> clinicCtrl : 8. GET /api/v1/clinics/{id}
activate clinicCtrl

clinicCtrl -> clinicSvc : 9. findById(id)
activate clinicSvc

clinicSvc -> db : 10. SELECT clinic WHERE clinic_id with treatment_rooms relation
activate db
db --> clinicSvc : ClinicEntity / null
deactivate db

clinicSvc --> clinicCtrl : ClinicEntity / null
deactivate clinicSvc

clinicCtrl --> form : 11. 200 OK ClinicEntity
deactivate clinicCtrl

form --> user : 12. Display clinic detail with treatment rooms
deactivate form

alt Admin updates clinic information
  user -> form : 13. Edit clinic fields and submit
  activate form

  form -> clinicCtrl : 14. PATCH /api/v1/clinics/{id} UpdateClinicDto
  activate clinicCtrl

  clinicCtrl -> clinicSvc : 15. update(id, UpdateClinicDto)
  activate clinicSvc

  clinicSvc -> db : 16. SELECT clinic WHERE clinic_id
  activate db
  db --> clinicSvc : ClinicEntity / null
  deactivate db

  alt clinic found
    clinicSvc -> clinicSvc : 17. Merge update fields and parse license_expiry
    activate clinicSvc
    deactivate clinicSvc

    clinicSvc -> db : 18. UPDATE clinic SET changed fields
    activate db
    db --> clinicSvc : ClinicEntity
    deactivate db

    clinicSvc --> clinicCtrl : ClinicEntity
    deactivate clinicSvc

    clinicCtrl --> form : 19. 200 OK ClinicEntity
    deactivate clinicCtrl

    form --> user : 20. Display updated clinic
    deactivate form
  else clinic not found
    activate clinicSvc
    clinicSvc --> clinicCtrl : 21. throw NotFoundException
    deactivate clinicSvc

    activate clinicCtrl
    clinicCtrl --> form : 22. 404 { message: Clinic not found }
    deactivate clinicCtrl

    activate form
    form --> user : 23. Display error message
    deactivate form
  end
else Admin assigns a service to clinic
  user -> form : 24. Select service and set custom price
  activate form

  form -> svcCtrl : 25. POST /api/v1/clinics/{clinicId}/services/{serviceId} { custom_price }
  activate svcCtrl

  svcCtrl -> svcSvc : 26. assignServiceToClinic(clinicId, serviceId, customPrice)
  activate svcSvc

  svcSvc -> db : 27. INSERT INTO clinic_services
  activate db
  db --> svcSvc : ClinicServiceEntity
  deactivate db

  svcSvc --> svcCtrl : ClinicServiceEntity
  deactivate svcSvc

  svcCtrl --> form : 28. 201 Created ClinicServiceEntity
  deactivate svcCtrl

  form --> user : 29. Display service assigned confirmation
  deactivate form
end

deactivate user

@enduml
