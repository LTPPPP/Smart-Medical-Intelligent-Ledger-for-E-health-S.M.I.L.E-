@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentDetailPanel" as form
participant ":TreatmentHistoryController" as ctrl
participant ":TreatmentHistoryService" as treatSvc
entity "TreatmentHistoryEntity" as treatEntity
database "PostgreSQL" as db

user -> form : 1. Edit treatment fields
activate user
activate form

user -> form : 2. Click "Save Changes"
form -> ctrl : 3. PATCH /api/v1/treatment-history/{treatment_id}\nUpdateTreatmentHistoryDto
activate ctrl

ctrl -> treatSvc : 4. update(treatment_id, UpdateTreatmentHistoryDto)
activate treatSvc

treatSvc -> treatEntity : 5. findOne(treatment_id)
activate treatEntity
treatEntity -> db : 6. SELECT treatment_history WHERE treatment_id
activate db
db --> treatEntity : 7. return result
deactivate db
treatEntity --> treatSvc : 8. return TreatmentHistoryEntity
deactivate treatEntity

treatSvc -> treatSvc : 9. check entry exists
activate treatSvc
deactivate treatSvc
alt entry found
  treatSvc -> treatEntity : 10. save(updatedTreatment)
  activate treatEntity
  treatEntity -> db : 11. UPDATE treatment_history SET changed fields
  activate db
  db --> treatEntity : 12. return updated row
  deactivate db
  treatEntity --> treatSvc : 13. return TreatmentHistoryEntity
  deactivate treatEntity

  treatSvc --> ctrl : 14. return TreatmentHistoryEntity
  ctrl --> form : 15. 200 OK TreatmentHistoryEntity
  form --> user : 16. Display updated treatment profile
else entry not found
  treatSvc --> ctrl : 17. throw NotFoundException
  deactivate treatSvc
  ctrl --> form : 18. 404 { message: Treatment not found }
  deactivate ctrl
  form --> user : 19. Show not found error
  deactivate form
end

deactivate user

@enduml
