@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC 20: Verify Record Integrity

actor "Patient" as user
boundary "RecordDetailView" as form
participant ":BlockchainController" as ctrl
participant ":BlockchainService" as blkSvc
participant "FabricLedger" as fabric
participant ":MedicalRecordsService" as medSvc
database "PostgreSQL" as db

user -> form : 1. Click "Verify Integrity" on record
activate user
activate form

form -> ctrl : 2. GET /api/v1/blockchain/verify/{recordId}
activate ctrl

ctrl -> blkSvc : 3. verifyRecordIntegrity(recordId)
activate blkSvc
b
blkSvc -> blkSvc : 4. Lookup anchorId by recordId
activate blkSvc
deactivate blkSvc

blkSvc -> fabric : 5. GetAnchor(anchorId)
activate fabric
fabric --> blkSvc : MedicalAnchor / null
deactivate fabric

alt anchor found on chain
  blkSvc -> blkSvc : 6. Extract on-chain contentHash and TxID
  activate blkSvc
  deactivate blkSvc

  blkSvc -> medSvc : 7. getRecordHash(recordId)
  activate medSvc
  medSvc -> db : 8. SELECT medical_record WHERE id
  activate db
  db --> medSvc : MedicalRecord / null
  deactivate db
  medSvc -> medSvc : 9. Compute SHA-256 of record content
  activate medSvc
  deactivate medSvc
  medSvc --> blkSvc : offChainHash
  deactivate medSvc

  blkSvc -> blkSvc : 10. Compare onChainHash with offChainHash
  activate blkSvc
  deactivate blkSvc

  alt hashes match
    blkSvc --> ctrl : 11. IntegrityResult { status: VALID, txId }
    deactivate blkSvc

    ctrl --> form : 12. 200 OK { status: VALID, txId, verifiedAt }
    deactivate ctrl

    form --> user : 13. Display "Record integrity verified"
    deactivate form
  else hashes do not match
    activate blkSvc
    blkSvc --> ctrl : 14. IntegrityResult { status: TAMPERED, txId }
    deactivate blkSvc

    activate ctrl
    ctrl --> form : 15. 200 OK { status: TAMPERED, txId, verifiedAt }
    deactivate ctrl

    activate form
    form --> user : 16. Display "Record has been tampered with"
    deactivate form
  end
else anchor not found on chain
  blkSvc --> ctrl : 17. throw NotFoundException
  deactivate blkSvc

  activate ctrl
  ctrl --> form : 18. 404 { message: recordNotAnchored }
  deactivate ctrl

  activate form
  form --> user : 19. Display "No blockchain record found"
  deactivate form
end

deactivate user

@enduml
