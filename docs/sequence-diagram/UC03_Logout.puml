@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "Application" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":RefreshTokensService" as refSvc
participant ":AuditLogsService" as auditSvc
entity "RefreshTokenEntity" as refEntity
database "PostgreSQL" as db

user -> form : 1. Click "Logout"
activate user
activate form

form -> ctrl : 2. POST /api/v1/auth/logout\n[Authorization: Bearer {accessToken}]
activate ctrl

ctrl -> ctrl : 3. Validate JWT (AuthGuard)
activate ctrl
deactivate ctrl

ctrl -> ctrl : 4. Extract accountId from JWT
activate ctrl
deactivate ctrl

ctrl -> authSvc : 5. logout(accountId)
activate authSvc

authSvc -> refSvc : 6. revokeByAccountId(accountId)
activate refSvc

refSvc -> refEntity : 7. update(accountId, revokedAt)
activate refEntity
refEntity -> db : 8. UPDATE refresh_tokens SET revokedAt = NOW()\nWHERE account_id
activate db
db --> refEntity : 9. return updated row
deactivate db
refEntity --> refSvc : 10. return result
deactivate refEntity

refSvc --> authSvc : 11. return success
deactivate refSvc

authSvc --> ctrl : 12. return success
deactivate authSvc

ctrl -> auditSvc : 13. create({ action: LOGOUT, resource: auth })
activate auditSvc
auditSvc --> ctrl : 14. return AuditLogEntity
deactivate auditSvc

ctrl --> form : 15. 204 No Content
deactivate ctrl

form -> form : 16. Clear local tokens and session
activate form
deactivate form

form --> user : 17. Redirect to login page
deactivate form

deactivate user

@enduml
