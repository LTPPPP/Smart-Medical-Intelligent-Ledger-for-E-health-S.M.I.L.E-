@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-079: Upload Endodontic Image

actor "Dentist" as user
boundary "DentalImageUploadPage" as page
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as svc
participant "S3Storage" as s3
database "PostgreSQL" as db

user -> page : 1. Select patient record and\nchoose endodontic image file
activate user
activate page

page -> page : 2. Validate file type and size
activate page
deactivate page
alt file is valid
  page -> s3 : 3. Upload endodontic image to S3 bucket
  activate s3

  s3 -> s3 : 4. check upload result
  activate s3
  deactivate s3
  alt upload succeeds
    s3 --> page : 5. return image_url, thumbnail_url
    deactivate s3

    page -> ctrl : 6. POST /api/v1/dental-images\n{ patient_id, record_id, image_url,\ncategory: ENDODONTIC, description }
    activate ctrl

    ctrl -> svc : 7. create(CreateDentalImageDto)
    activate svc

    svc -> db : 8. INSERT dental_image
    activate db
    db --> svc : 9. return DentalImageEntity
    deactivate db

    svc --> ctrl : 10. return DentalImageEntity
    deactivate svc

    ctrl --> page : 11. 201 Created DentalImageEntity
    deactivate ctrl

    page --> user : 12. Display uploaded endodontic image
    deactivate page
  else upload fails
    s3 --> page : 13. return StorageError
    deactivate s3
    activate page
    page --> user : 14. Show upload failed error
    deactivate page
  end
else file is invalid
  page --> user : 15. Show file validation error
  deactivate page
end

deactivate user

@enduml
