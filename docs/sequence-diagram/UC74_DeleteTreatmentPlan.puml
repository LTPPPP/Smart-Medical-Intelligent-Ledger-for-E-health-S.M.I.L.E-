@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentPlanDetailPanel" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as planSvc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Click "Delete Plan" and confirm
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/treatment-plans/{plan_id}
activate ctrl

ctrl -> planSvc : 3. remove(plan_id)
activate planSvc

planSvc -> planEntity : 4. findOne(plan_id)
activate planEntity
planEntity -> db : 5. SELECT treatment_plan WHERE plan_id
activate db
db --> planEntity : 6. return result
deactivate db
planEntity --> planSvc : 7. return TreatmentPlanEntity
deactivate planEntity

planSvc -> planSvc : 8. check plan exists
activate planSvc
deactivate planSvc
alt plan found
  planSvc -> planEntity : 9. delete(plan_id)
  activate planEntity
  planEntity -> db : 10. DELETE FROM treatment_plans WHERE plan_id
  activate db
  db --> planEntity : 11. return deleted (affectedRows: 1)
  deactivate db
  planEntity --> planSvc : 12. return success
  deactivate planEntity

  planSvc --> ctrl : 13. return success
  ctrl --> form : 14. 204 No Content

  form --> user : 15. Display deletion confirmation
else plan not found
  planSvc --> ctrl : 16. throw NotFoundException
  deactivate planSvc

  ctrl --> form : 17. 404 { message: Treatment plan not found }
  deactivate ctrl

  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
