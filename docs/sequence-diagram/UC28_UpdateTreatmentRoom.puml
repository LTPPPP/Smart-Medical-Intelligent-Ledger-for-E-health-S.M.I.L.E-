@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-028: Update Treatment Room

actor "Admin" as user
boundary "RoomDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
database "PostgreSQL" as db

user -> form : 1. Edit room fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/treatment-rooms/{id}\nUpdateTreatmentRoomDto
activate ctrl

ctrl -> roomSvc : 3. update(id, UpdateTreatmentRoomDto)
activate roomSvc

roomSvc -> db : 4. SELECT treatment_room WHERE room_id
activate db
db --> roomSvc : 5. return TreatmentRoomEntity / null
deactivate db

roomSvc -> roomSvc : 6. check room exists
activate roomSvc
deactivate roomSvc
alt room found
  roomSvc -> db : 7. UPDATE treatment_room SET changed fields
  activate db
  db --> roomSvc : 8. return updated TreatmentRoomEntity
  deactivate db

  roomSvc --> ctrl : 9. return TreatmentRoomEntity
  deactivate roomSvc

  ctrl --> form : 10. 200 OK TreatmentRoomEntity
  deactivate ctrl

  form --> user : 11. Display updated room
  deactivate form
else room not found
  roomSvc --> ctrl : 12. throw NotFoundException
  deactivate roomSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Treatment room not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
