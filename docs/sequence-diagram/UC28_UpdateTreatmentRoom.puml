@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RoomDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
entity "TreatmentRoomEntity" as roomEntity
database "PostgreSQL" as db

user -> form : 1. Edit room fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/treatment-rooms/{id}\nUpdateTreatmentRoomDto
activate ctrl

ctrl -> roomSvc : 3. update(id, UpdateTreatmentRoomDto)
activate roomSvc

roomSvc -> roomEntity : 4. findOne(id)
activate roomEntity
roomEntity -> db : 5. SELECT treatment_room WHERE room_id
activate db
db --> roomEntity : 6. return result
deactivate db
roomEntity --> roomSvc : 7. return TreatmentRoomEntity
deactivate roomEntity

roomSvc -> roomSvc : 8. check room exists
activate roomSvc
deactivate roomSvc
alt room found
  roomSvc -> roomEntity : 9. save(updatedRoom)
  activate roomEntity
  roomEntity -> db : 10. UPDATE treatment_room SET changed fields
  activate db
  db --> roomEntity : 11. return updated row
  deactivate db
  roomEntity --> roomSvc : 12. return TreatmentRoomEntity
  deactivate roomEntity

  roomSvc --> ctrl : 13. return TreatmentRoomEntity

  ctrl --> form : 14. 200 OK TreatmentRoomEntity

  form --> user : 15. Display updated room
else room not found
  roomSvc --> ctrl : 16. throw NotFoundException
  deactivate roomSvc
  ctrl --> form : 17. 404 { message: Treatment room not found }
  deactivate ctrl
  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
