@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RoomDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
entity "TreatmentRoomEntity" as roomEntity
database "PostgreSQL" as db

user -> form : 1. Edit room fields
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> ctrl : 3. PATCH /api/v1/treatment-rooms/{id}\nUpdateTreatmentRoomDto
activate ctrl

ctrl -> roomSvc : 4. update(id, UpdateTreatmentRoomDto)
activate roomSvc

roomSvc -> roomEntity : 5. findOne(id)
activate roomEntity
roomEntity -> db : 6. SELECT treatment_room WHERE room_id
activate db
db --> roomEntity : 7. return result
deactivate db
roomEntity --> roomSvc : 8. return TreatmentRoomEntity
deactivate roomEntity

roomSvc -> roomSvc : 9. check room exists
activate roomSvc
deactivate roomSvc
alt room found
  roomSvc -> roomEntity : 10. save(updatedRoom)
  activate roomEntity
  roomEntity -> db : 11. UPDATE treatment_room SET changed fields
  activate db
  db --> roomEntity : 12. return updated row
  deactivate db
  roomEntity --> roomSvc : 13. return TreatmentRoomEntity
  deactivate roomEntity

  roomSvc --> ctrl : 14. return TreatmentRoomEntity

  ctrl --> form : 15. 200 OK TreatmentRoomEntity

  form --> user : 16. Display updated room
else room not found
  roomSvc --> ctrl : 17. throw NotFoundException
  deactivate roomSvc
  ctrl --> form : 18. 404 { message: Treatment room not found }
  deactivate ctrl
  form --> user : 19. Show not found error
  deactivate form
end

deactivate user

@enduml
