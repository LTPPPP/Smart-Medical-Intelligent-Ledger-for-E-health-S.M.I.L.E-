@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC: Forgot Password

actor "User" as user
boundary "ForgotPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Enter email address
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/forgot/password
  activate ctrl

  ctrl -> authSvc : 4. forgotPassword(email)
  activate authSvc

  authSvc -> accSvc : 5. findByEmail(email)
  activate accSvc
  accSvc -> db : 6. SELECT account WHERE email
  activate db
  db --> accSvc : Account / null
  deactivate db
  accSvc --> authSvc : Account / null
  deactivate accSvc

  authSvc -> authSvc : 7. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> config : 8. get(auth.forgotExpires)
    activate config
    config --> authSvc : tokenExpiresIn
    deactivate config

    authSvc -> config : 9. get(auth.forgotSecret)
    activate config
    config --> authSvc : forgotSecret
    deactivate config

    authSvc -> jwt : 10. signAsync({ forgotAccountId }, secret, expiresIn)
    activate jwt
    jwt --> authSvc : resetToken
    deactivate jwt

    authSvc ->> user : 11. Send password reset email with token

    authSvc --> ctrl : 12. { message: "Password reset link sent to your email." }
    deactivate authSvc

    ctrl --> form : 13. 200 OK
    deactivate ctrl

    form --> user : 14. Show success message
    deactivate form
  else account not found
    authSvc --> ctrl : 15. throw UnprocessableEntityException
    deactivate authSvc
    activate ctrl
    ctrl --> form : 16. 422 { email: emailNotExists }
    deactivate ctrl
    activate form
    form --> user : 17. Show email not found message
  end
else validation fails
  form --> user : 18. Show validation errors
  deactivate form
end

deactivate user

@enduml
