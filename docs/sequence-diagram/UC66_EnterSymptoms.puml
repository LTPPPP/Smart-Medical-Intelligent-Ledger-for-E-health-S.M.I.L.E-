@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-066: Enter Symptoms

actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":ExaminationSessionsController" as ctrl
participant ":ExaminationSessionsService" as svc
participant ":PatientsService" as patSvc
database "PostgreSQL" as db

user -> page : 1. Select patient from patient list
activate user
activate page

page -> patSvc : 2. GET /api/v1/patients/:patient_id
activate patSvc

patSvc -> db : 3. findOne(where: {patient_id})
activate db
db --> patSvc : 4. return PatientEntity / null
deactivate db

patSvc -> patSvc : 5. check patient exists
activate patSvc
deactivate patSvc
alt patient exists
  patSvc --> page : 6. return PatientEntity
  deactivate patSvc

  page --> user : 7. Display patient information
  deactivate page

  user -> page : 8. Fill chief complaint, present illness,\nvital signs and click Create Session
  activate page

  page -> ctrl : 9. POST /api/v1/examination-sessions\n(CreateExaminationSessionDto)
  activate ctrl

  ctrl -> svc : 10. create(CreateExaminationSessionDto)
  activate svc

  svc -> db : 11. create(ExaminationSessionEntity)
  activate db
  db --> svc : 12. return ExaminationSessionEntity
  deactivate db

  svc -> db : 13. save(ExaminationSessionEntity)
  activate db
  db --> svc : 14. return ExaminationSessionEntity
  deactivate db

  svc --> ctrl : 15. return ExaminationSessionEntity
  deactivate svc

  ctrl --> page : 16. 201 Created — ExaminationSessionEntity
  deactivate ctrl

  page --> user : 17. Display examination session created
  deactivate page
else patient not found
  patSvc --> page : 18. throw NotFoundException
  deactivate patSvc
  activate page
  page --> user : 19. Show patient not found error
  deactivate page
end

deactivate user

@enduml
