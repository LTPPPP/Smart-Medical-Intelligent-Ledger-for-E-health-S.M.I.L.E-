@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as svc
entity "SymptomEntity" as symptomEntity
database "PostgreSQL" as db

user -> page : 1. Open examination session\nand navigate to symptoms tab
activate user
activate page

page --> user : 2. Display symptom entry form

user -> page : 3. Fill symptom_name, description,\nseverity, location

user -> page : 4. Click "Add Symptom"
page -> page : 5. Validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 6. POST /api/v1/symptoms\n(CreateSymptomDto)
  activate ctrl

  ctrl -> svc : 7. create(CreateSymptomDto)
  activate svc

  svc -> symptomEntity : 8. save(session_id, patient_id, symptom_name,\ndescription, severity, location)
  activate symptomEntity
  symptomEntity -> db : 9. INSERT INTO symptoms
  activate db
  db --> symptomEntity : 10. return saved row
  deactivate db
  symptomEntity --> svc : 11. return SymptomEntity
  deactivate symptomEntity

  svc --> ctrl : 12. return SymptomEntity
  deactivate svc

  ctrl --> page : 13. 201 Created — SymptomEntity
  deactivate ctrl

  page --> user : 14. Display symptom recorded successfully

else validation fails
  page --> user : 15. Show validation errors
  deactivate page
end

deactivate user

@enduml
