@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-066: Enter Symptoms

actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":ExaminationSessionsController" as ctrl
participant ":ExaminationSessionsService" as svc
participant ":PatientsService" as patSvc
database "PostgreSQL" as db

user -> page : 1. Select patient from patient list
activate user
activate page

page -> patSvc : 2. GET /api/v1/patients/:patient_id
activate patSvc

patSvc -> db : 3. findOne(where: {patient_id})
activate db
db --> patSvc : PatientEntity / null
deactivate db

patSvc -> patSvc : 4. check patient exists
activate patSvc
deactivate patSvc
alt patient exists
  patSvc --> page : 5. PatientEntity
  deactivate patSvc

  page --> user : 6. Display patient information
  deactivate page

  user -> page : 7. Fill chief complaint, present illness,\nvital signs and click Create Session
  activate page

  page -> ctrl : 8. POST /api/v1/examination-sessions\n(CreateExaminationSessionDto)
  activate ctrl

  ctrl -> svc : 9. create(CreateExaminationSessionDto)
  activate svc

  svc -> db : 10. create(ExaminationSessionEntity)
  activate db
  db --> svc : ExaminationSessionEntity
  deactivate db

  svc -> db : 11. save(ExaminationSessionEntity)
  activate db
  db --> svc : ExaminationSessionEntity
  deactivate db

  svc --> ctrl : 12. ExaminationSessionEntity
  deactivate svc

  ctrl --> page : 13. 201 Created — ExaminationSessionEntity
  deactivate ctrl

  page --> user : 14. Display examination session created
  deactivate page
else patient not found
  patSvc --> page : 15. throw NotFoundException
  deactivate patSvc
  activate page
  page --> user : 16. Show patient not found error
  deactivate page
end

deactivate user

@enduml
