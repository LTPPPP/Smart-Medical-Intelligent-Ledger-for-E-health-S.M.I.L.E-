@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "ExaminationPage" as page
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as svc
entity "SymptomEntity" as symptomEntity
database "PostgreSQL" as db

user -> page : 1. Open examination session\nand navigate to symptoms tab
activate user
activate page

page --> user : 2. Display symptom entry form

user -> page : 3. Fill symptom_name, description,\nseverity, location and submit

page -> page : 4. Validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 5. POST /api/v1/symptoms\n(CreateSymptomDto)
  activate ctrl

  ctrl -> svc : 6. create(CreateSymptomDto)
  activate svc

  svc -> symptomEntity : 7. save(session_id, patient_id, symptom_name,\ndescription, severity, location)
  activate symptomEntity
  symptomEntity -> db : 8. INSERT INTO symptoms
  activate db
  db --> symptomEntity : 9. return saved row
  deactivate db
  symptomEntity --> svc : 10. return SymptomEntity
  deactivate symptomEntity

  svc --> ctrl : 11. return SymptomEntity
  deactivate svc

  ctrl --> page : 12. 201 Created — SymptomEntity
  deactivate ctrl

  page --> user : 13. Display symptom recorded successfully

else validation fails
  page --> user : 14. Show validation errors
  deactivate page
end

deactivate user

@enduml
