@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "ClinicManagementPanel" as form
participant ":ClinicsController" as ctrl
participant ":ClinicsService" as clinicSvc
entity "ClinicEntity" as clinicEntity
database "PostgreSQL" as db

user -> form : 1. Open clinic management panel
activate user
activate form

form -> ctrl : 2. GET /api/v1/clinics?page=1&limit=20
activate ctrl

ctrl -> clinicSvc : 3. findAll(QueryClinicDto)
activate clinicSvc

clinicSvc -> clinicEntity : 4. findAll(query)
activate clinicEntity
clinicEntity -> db : 5. SELECT clinics with filters\n(name, city, district, status) with pagination
activate db
db --> clinicEntity : 6. return result
deactivate db
clinicEntity --> clinicSvc : 7. return [ClinicEntity[], total]
deactivate clinicEntity

clinicSvc --> ctrl : 8. return { data: ClinicEntity[], total }
deactivate clinicSvc

ctrl --> form : 9. 200 OK { data, meta }
deactivate ctrl

form --> user : 10. Display clinic list\n(name, address, phone, status)
deactivate form

deactivate user

@enduml
