@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ExaminationPanel" as form
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as symSvc
entity "SymptomEntity" as symptomEntity
database "PostgreSQL" as db

user -> form : 1. Open symptoms tab for session
activate user
activate form

form -> ctrl : 2. GET /api/v1/symptoms/session/{session_id}
activate ctrl

ctrl -> symSvc : 3. findBySessionId(session_id)
activate symSvc

symSvc -> symptomEntity : 4. findBySessionId(session_id)
activate symptomEntity
symptomEntity -> db : 5. SELECT * FROM symptoms WHERE session_id
activate db
db --> symptomEntity : 6. return result
deactivate db
symptomEntity --> symSvc : 7. return SymptomEntity[]
deactivate symptomEntity

symSvc --> ctrl : 8. return SymptomEntity[]
deactivate symSvc

ctrl --> form : 9. 200 OK SymptomEntity[]
deactivate ctrl

form --> user : 10. Display symptom list\n(description, severity, location, onset)
deactivate form

deactivate user

@enduml
