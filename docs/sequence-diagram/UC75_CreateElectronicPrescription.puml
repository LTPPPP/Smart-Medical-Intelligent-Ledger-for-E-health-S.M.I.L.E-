@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-075: Create Electronic Prescription

actor "Dentist" as user
boundary "PrescriptionForm" as form
participant ":PrescriptionsController" as ctrl
participant ":PrescriptionsService" as svc
participant ":PrescriptionItemsController" as itemCtrl
participant ":PrescriptionItemsService" as itemSvc
database "PostgreSQL" as db

user -> form : 1. Fill patient_id, doctor_id,\nrecord_id, notes
activate user
activate form

form -> form : 2. validate prescription fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /prescriptions (CreatePrescriptionDto)
  activate ctrl

  ctrl -> svc : 4. create(CreatePrescriptionDto)
  activate svc

  svc -> db : 5. find({ where: { patient_id } })
  activate db
  db --> svc : 6. return PatientEntity / null
  deactivate db

  svc -> svc : 7. check patient exists
  activate svc
  deactivate svc
  alt patient found
    svc -> db : 8. create(PrescriptionEntity)
    activate db
    db --> svc : 9. return PrescriptionEntity
    deactivate db

    svc -> db : 10. save(PrescriptionEntity)
    activate db
    db --> svc : 11. return PrescriptionEntity
    deactivate db

    svc --> ctrl : 12. return PrescriptionEntity
    deactivate svc

    ctrl --> form : 13. 201 Created
    deactivate ctrl

    form --> user : 14. Show prescription created

    loop for each medication item
      user -> form : 15. Fill medication_name, dosage,\nfrequency, quantity, instructions

      form -> itemCtrl : 16. POST /prescription-items\n(CreatePrescriptionItemDto)
      activate itemCtrl

      itemCtrl -> itemSvc : 17. create(CreatePrescriptionItemDto)
      activate itemSvc

      itemSvc -> db : 18. create(PrescriptionItemEntity)
      activate db
      db --> itemSvc : 19. return PrescriptionItemEntity
      deactivate db

      itemSvc -> db : 20. save(PrescriptionItemEntity)
      activate db
      db --> itemSvc : 21. return PrescriptionItemEntity
      deactivate db

      itemSvc --> itemCtrl : 22. return PrescriptionItemEntity
      deactivate itemSvc

      itemCtrl --> form : 23. 201 Created
      deactivate itemCtrl

      form --> user : 24. Show item added
    end

    deactivate form
  else patient not found
    svc --> ctrl : 25. throw NotFoundException
    deactivate svc
    activate ctrl
    ctrl --> form : 26. 404 Not Found
    deactivate ctrl
    activate form
    form --> user : 27. Show error message
  end
else validation fails
  form --> user : 28. Show validation errors
  deactivate form
end

deactivate user

@enduml
