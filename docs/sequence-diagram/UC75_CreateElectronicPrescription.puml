@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "PrescriptionForm" as form
participant ":PrescriptionsController" as ctrl
participant ":PrescriptionsService" as svc
participant ":PrescriptionItemsController" as itemCtrl
participant ":PrescriptionItemsService" as itemSvc
entity "PrescriptionEntity" as prescEntity
entity "PrescriptionItemEntity" as itemEntity
database "PostgreSQL" as db

user -> form : 1. Fill patient_id, doctor_id,\nrecord_id, notes
activate user
activate form

form -> form : 2. validate prescription fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /prescriptions (CreatePrescriptionDto)
  activate ctrl

  ctrl -> svc : 4. create(CreatePrescriptionDto)
  activate svc

  svc -> prescEntity : 5. findByPatientId(patient_id)
  activate prescEntity
  prescEntity -> db : 6. SELECT * FROM patients WHERE id = patient_id
  activate db
  db --> prescEntity : 7. return result
  deactivate db
  prescEntity --> svc : 8. return PatientRecord
  deactivate prescEntity

  svc -> svc : 9. check patient exists
  activate svc
  deactivate svc
  alt patient found
    svc -> prescEntity : 10. create(PrescriptionEntity)
    activate prescEntity
    prescEntity -> db : 11. INSERT INTO prescriptions
    activate db
    db --> prescEntity : 12. return record
    deactivate db
    prescEntity --> svc : 13. return PrescriptionEntity
    deactivate prescEntity

    svc -> prescEntity : 14. save(PrescriptionEntity)
    activate prescEntity
    prescEntity -> db : 15. UPDATE prescriptions
    activate db
    db --> prescEntity : 16. return record
    deactivate db
    prescEntity --> svc : 17. return PrescriptionEntity
    deactivate prescEntity

    svc --> ctrl : 18. return PrescriptionEntity

    ctrl --> form : 19. 201 Created

    form --> user : 20. Show prescription created

    loop for each medication item
      user -> form : 21. Fill medication_name, dosage,\nfrequency, quantity, instructions

      form -> itemCtrl : 22. POST /prescription-items\n(CreatePrescriptionItemDto)
      activate itemCtrl

      itemCtrl -> itemSvc : 23. create(CreatePrescriptionItemDto)
      activate itemSvc

      itemSvc -> itemEntity : 24. create(PrescriptionItemEntity)
      activate itemEntity
      itemEntity -> db : 25. INSERT INTO prescription_items
      activate db
      db --> itemEntity : 26. return record
      deactivate db
      itemEntity --> itemSvc : 27. return PrescriptionItemEntity
      deactivate itemEntity

      itemSvc -> itemEntity : 28. save(PrescriptionItemEntity)
      activate itemEntity
      itemEntity -> db : 29. UPDATE prescription_items
      activate db
      db --> itemEntity : 30. return record
      deactivate db
      itemEntity --> itemSvc : 31. return PrescriptionItemEntity
      deactivate itemEntity

      itemSvc --> itemCtrl : 32. return PrescriptionItemEntity
      deactivate itemSvc

      itemCtrl --> form : 33. 201 Created
      deactivate itemCtrl

      form --> user : 34. Show item added
    end

  else patient not found
    svc --> ctrl : 35. throw NotFoundException
    deactivate svc

    ctrl --> form : 36. 404 Not Found
    deactivate ctrl

    form --> user : 37. Show error message
  end
else validation fails
  form --> user : 38. Show validation errors
  deactivate form
end

deactivate user

@enduml
