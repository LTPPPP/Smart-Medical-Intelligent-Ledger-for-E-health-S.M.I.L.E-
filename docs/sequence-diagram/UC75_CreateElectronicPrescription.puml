@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "PrescriptionForm" as form
participant ":PrescriptionsController" as ctrl
participant ":PrescriptionsService" as svc
participant ":PrescriptionItemsController" as itemCtrl
participant ":PrescriptionItemsService" as itemSvc
entity "PrescriptionEntity" as prescEntity
entity "PrescriptionItemEntity" as itemEntity
database "PostgreSQL" as db

user -> form : 1. Fill patient_id, doctor_id,\nrecord_id, notes
activate user
activate form

user -> form : 2. Click "Create Prescription"
form -> form : 3. validate: patient_id and doctor_id are valid UUIDs,\nprescription_date is a valid ISO date if provided,\nsession_id and record_id are valid UUIDs if provided
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /prescriptions (CreatePrescriptionDto)
  activate ctrl

  ctrl -> svc : 5. create(CreatePrescriptionDto)
  activate svc

  svc -> prescEntity : 6. findByPatientId(patient_id)
  activate prescEntity
  prescEntity -> db : 7. SELECT * FROM patients WHERE id = patient_id
  activate db
  db --> prescEntity : 8. return result
  deactivate db
  prescEntity --> svc : 9. return PatientRecord
  deactivate prescEntity

  svc -> svc : 10. check patient exists
  activate svc
  deactivate svc
  alt patient found
    svc -> prescEntity : 11. create(PrescriptionEntity)
    activate prescEntity
    prescEntity -> db : 12. INSERT INTO prescriptions
    activate db
    db --> prescEntity : 13. return record
    deactivate db
    prescEntity --> svc : 14. return PrescriptionEntity
    deactivate prescEntity

    svc -> prescEntity : 15. save(PrescriptionEntity)
    activate prescEntity
    prescEntity -> db : 16. UPDATE prescriptions
    activate db
    db --> prescEntity : 17. return record
    deactivate db
    prescEntity --> svc : 18. return PrescriptionEntity
    deactivate prescEntity

    svc --> ctrl : 19. return PrescriptionEntity

    ctrl --> form : 20. 201 Created

    form --> user : 21. Show prescription created

    loop for each medication item
      user -> form : 22. Fill medication_name, dosage,\nfrequency, quantity, instructions

      user -> form : 23. Click "Add Medication"
      form -> itemCtrl : 24. POST /prescription-items\n(CreatePrescriptionItemDto)
      activate itemCtrl

      itemCtrl -> itemSvc : 25. create(CreatePrescriptionItemDto)
      activate itemSvc

      itemSvc -> itemEntity : 26. create(PrescriptionItemEntity)
      activate itemEntity
      itemEntity -> db : 27. INSERT INTO prescription_items
      activate db
      db --> itemEntity : 28. return record
      deactivate db
      itemEntity --> itemSvc : 29. return PrescriptionItemEntity
      deactivate itemEntity

      itemSvc -> itemEntity : 30. save(PrescriptionItemEntity)
      activate itemEntity
      itemEntity -> db : 31. UPDATE prescription_items
      activate db
      db --> itemEntity : 32. return record
      deactivate db
      itemEntity --> itemSvc : 33. return PrescriptionItemEntity
      deactivate itemEntity

      itemSvc --> itemCtrl : 34. return PrescriptionItemEntity
      deactivate itemSvc

      itemCtrl --> form : 35. 201 Created
      deactivate itemCtrl

      form --> user : 36. Show item added
    end

  else patient not found
    svc --> ctrl : 37. throw NotFoundException
    deactivate svc

    ctrl --> form : 38. 404 Not Found
    deactivate ctrl

    form --> user : 39. Show error message
  end
else validation fails
  form --> user : 40. Show validation errors
  deactivate form
end

deactivate user

@enduml
