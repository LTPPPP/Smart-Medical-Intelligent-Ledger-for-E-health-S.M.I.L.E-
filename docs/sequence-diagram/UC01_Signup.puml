@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "RegisterForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
entity "AccountEntity" as accEntity
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db
participant "JwtService" as jwt

user -> form : 1. Fill firstName, lastName, username,\nemail, phone, password, confirmPassword, gender
activate user
activate form

user -> form : 2. Click "Sign Up"

form -> form : 3. validate: firstName, lastName and username not empty,\nusername >= 3 characters and matches [a-zA-Z0-9_],\nemail not empty and matches email format,\npassword not empty and >= 8 characters,\nconfirmPassword equals password
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/auth/email/register
  activate ctrl

  ctrl -> authSvc : 5. register(AuthRegisterLoginDto)
  activate authSvc

  authSvc -> accSvc : 6. create(CreateAccountDto)
  activate accSvc

  accSvc -> accEntity : 7. findByEmail(email)
  activate accEntity
  accEntity -> db : 8. SELECT * FROM accounts WHERE email
  activate db
  db --> accEntity : 9. return result
  deactivate db
  accEntity --> accSvc : 10. return Account
  deactivate accEntity

  accSvc -> accEntity : 11. findByPhone(phone)
  activate accEntity
  accEntity -> db : 12. SELECT * FROM accounts WHERE phone
  activate db
  db --> accEntity : 13. return result
  deactivate db
  accEntity --> accSvc : 14. return Account
  deactivate accEntity

  accSvc -> accSvc : 15. check duplicates
  activate accSvc
  deactivate accSvc
  alt no duplicates
    accSvc -> accSvc : 16. hash password
    activate accSvc
    deactivate accSvc

    accSvc -> accEntity : 17. save(email, passwordHash, role, status)
    activate accEntity
    accEntity -> db : 18. INSERT INTO accounts
    activate db
    db --> accEntity : 19. return saved row
    deactivate db
    accEntity --> accSvc : 20. return Account
    deactivate accEntity

    accSvc --> authSvc : 21. return Account

    authSvc -> profSvc : 22. create(CreateUserProfileDto, accountId)
    activate profSvc

    profSvc -> profEntity : 23. save(accountId, fullName, email, phone, gender)
    activate profEntity
    profEntity -> db : 24. INSERT INTO user_profiles
    activate db
    db --> profEntity : 25. return saved row
    deactivate db
    profEntity --> profSvc : 26. return UserProfile
    deactivate profEntity

    profSvc --> authSvc : 27. return UserProfile
    deactivate profSvc

    authSvc -> jwt : 28. sign(confirmEmailPayload)
    activate jwt
    jwt --> authSvc : 29. return confirmEmailToken
    deactivate jwt

    authSvc -> authSvc : 30. Send confirmation email
    activate authSvc
    deactivate authSvc

    authSvc --> ctrl : 31. return { message: "Registration successful" }

    ctrl --> form : 32. 201 Created

    form --> user : 33. toast.success

    user -> form : 34. Input OTP
    user -> form : 35. Click "Verify OTP"
    form -> ctrl : 36. POST /api/v1/auth/email/confirm { hash: JWT }

    ctrl -> authSvc : 37. confirmEmail(hash)

    authSvc -> accSvc : 38. verifyEmail(accountId)

    accSvc -> accEntity : 39. update(accountId, emailVerified: true)
    activate accEntity
    accEntity -> db : 40. UPDATE accounts SET email_verified = true
    activate db
    db --> accEntity : 41. return updated row
    deactivate db
    accEntity --> accSvc : 42. return Account
    deactivate accEntity

    accSvc --> authSvc : 43. return Account

    authSvc --> ctrl : 44. return { message: "Email verified" }

    ctrl --> form : 45. 200 OK
    form --> user : 46. Signup successfully
  else email or phone already exists
    accSvc --> authSvc : 47. throw UnprocessableEntityException
    deactivate accSvc
    authSvc --> ctrl : 48. 422 Unprocessable Entity
    deactivate authSvc

    ctrl --> form : 49. error response
    deactivate ctrl

    form --> user : 50. Show error message
  end
else validation fails
  form --> user : 51. Show validation errors
  deactivate form
end

deactivate user

@enduml
