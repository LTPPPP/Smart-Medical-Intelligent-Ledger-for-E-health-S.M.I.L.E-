@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-001: Signup

actor "User" as user
boundary "RegisterForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
database "PostgreSQL" as db
participant "JwtService" as jwt

user -> form : 1. Fill firstName, lastName,\nemail, phone, password
activate user
activate form

form -> form : 2. validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/email/register
  activate ctrl

  ctrl -> authSvc : 4. register(AuthRegisterLoginDto)
  activate authSvc

  authSvc -> accSvc : 5. create(CreateAccountDto)
  activate accSvc

  accSvc -> db : 6. findByEmail(email)
  activate db
  db --> accSvc : 7. return Account / null
  deactivate db

  accSvc -> db : 8. findByPhone(phone)
  activate db
  db --> accSvc : 9. return Account / null
  deactivate db

  accSvc -> accSvc : 10. check duplicates
  activate accSvc
  deactivate accSvc
  alt no duplicates
    accSvc -> accSvc : 11. hash password
    activate accSvc
    deactivate accSvc
    accSvc -> db : 12. save(Account)
    activate db
    db --> accSvc : 13. return Account
    deactivate db
    accSvc --> authSvc : 14. return Account
    deactivate accSvc

    authSvc -> profSvc : 15. create(CreateUserProfileDto, accountId)
    activate profSvc
    profSvc -> db : 16. save(UserProfile)
    activate db
    db --> profSvc : 17. return UserProfile
    deactivate db
    profSvc --> authSvc : 18. return UserProfile
    deactivate profSvc

    authSvc -> jwt : 19. sign(confirmEmailPayload)
    activate jwt
    jwt --> authSvc : 20. return confirmEmailToken
    deactivate jwt

    authSvc ->> user : 21. Send confirmation email

    authSvc --> ctrl : 22. return { message: "Registration successful" }
    deactivate authSvc

    ctrl --> form : 23. 201 Created
    deactivate ctrl

    form --> user : 24. toast.success
    deactivate form

    user -> ctrl : 25. POST /api/v1/auth/email/confirm { hash: JWT }
    activate ctrl

    ctrl -> authSvc : 26. confirmEmail(hash)
    activate authSvc

    authSvc -> accSvc : 27. verifyEmail(accountId)
    activate accSvc
    accSvc -> db : 28. update emailVerified = true
    activate db
    db --> accSvc : 29. return Account
    deactivate db
    accSvc --> authSvc : 30. return Account

    authSvc --> ctrl : 31. return { message: "Email verified" }
    deactivate authSvc

    ctrl --> user : 32. 200 OK
    deactivate ctrl
  else email or phone already exists
    accSvc --> authSvc : 33. throw UnprocessableEntityException
    deactivate accSvc
    activate authSvc
    authSvc --> ctrl : 34. 422 Unprocessable Entity
    deactivate authSvc
    activate ctrl

    ctrl --> form : 35. error response
    deactivate ctrl
    activate form

    form --> user : 36. Show error message
  end
else validation fails
  form --> user : 37. Show validation errors
  deactivate form
end

deactivate user

@enduml
