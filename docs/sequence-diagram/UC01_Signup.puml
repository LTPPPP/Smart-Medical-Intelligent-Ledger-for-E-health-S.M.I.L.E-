@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "RegisterForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":UserProfilesService" as profSvc
entity "AccountEntity" as accEntity
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db
participant "JwtService" as jwt

user -> form : 1. Fill firstName, lastName,\nemail, phone, password
activate user
activate form

form -> form : 2. validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/email/register
  activate ctrl

  ctrl -> authSvc : 4. register(AuthRegisterLoginDto)
  activate authSvc

  authSvc -> accSvc : 5. create(CreateAccountDto)
  activate accSvc

  accSvc -> accEntity : 6. findByEmail(email)
  activate accEntity
  accEntity -> db : 7. SELECT * FROM accounts WHERE email
  activate db
  db --> accEntity : 8. return result
  deactivate db
  accEntity --> accSvc : 9. return Account
  deactivate accEntity

  accSvc -> accEntity : 10. findByPhone(phone)
  activate accEntity
  accEntity -> db : 11. SELECT * FROM accounts WHERE phone
  activate db
  db --> accEntity : 12. return result
  deactivate db
  accEntity --> accSvc : 13. return Account
  deactivate accEntity

  accSvc -> accSvc : 14. check duplicates
  activate accSvc
  deactivate accSvc
  alt no duplicates
    accSvc -> accSvc : 15. hash password
    activate accSvc
    deactivate accSvc

    accSvc -> accEntity : 16. save(email, passwordHash, role, status)
    activate accEntity
    accEntity -> db : 17. INSERT INTO accounts
    activate db
    db --> accEntity : 18. return saved row
    deactivate db
    accEntity --> accSvc : 19. return Account
    deactivate accEntity

    accSvc --> authSvc : 20. return Account

    authSvc -> profSvc : 21. create(CreateUserProfileDto, accountId)
    activate profSvc

    profSvc -> profEntity : 22. save(accountId, fullName, email, phone, gender)
    activate profEntity
    profEntity -> db : 23. INSERT INTO user_profiles
    activate db
    db --> profEntity : 24. return saved row
    deactivate db
    profEntity --> profSvc : 25. return UserProfile
    deactivate profEntity

    profSvc --> authSvc : 26. return UserProfile
    deactivate profSvc

    authSvc -> jwt : 27. sign(confirmEmailPayload)
    activate jwt
    jwt --> authSvc : 28. return confirmEmailToken
    deactivate jwt

    authSvc ->> user : 29. Send confirmation email

    authSvc --> ctrl : 30. return { message: "Registration successful" }

    ctrl --> form : 31. 201 Created

    form --> user : 32. toast.success

    user -> form : 33. Input OTP
    form -> ctrl : 34. POST /api/v1/auth/email/confirm { hash: JWT }

    ctrl -> authSvc : 35. confirmEmail(hash)

    authSvc -> accSvc : 36. verifyEmail(accountId)

    accSvc -> accEntity : 37. update(accountId, emailVerified: true)
    activate accEntity
    accEntity -> db : 38. UPDATE accounts SET email_verified = true
    activate db
    db --> accEntity : 39. return updated row
    deactivate db
    accEntity --> accSvc : 40. return Account
    deactivate accEntity

    accSvc --> authSvc : 41. return Account

    authSvc --> ctrl : 42. return { message: "Email verified" }

    ctrl --> form : 43. 200 OK
    form --> user : 44. Signup successfully
  else email or phone already exists
    accSvc --> authSvc : 45. throw UnprocessableEntityException
    deactivate accSvc
    authSvc --> ctrl : 46. 422 Unprocessable Entity
    deactivate authSvc

    ctrl --> form : 47. error response
    deactivate ctrl

    form --> user : 48. Show error message
  end
else validation fails
  form --> user : 49. Show validation errors
  deactivate form
end

deactivate user

@enduml
