@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "AppointmentListView" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Open appointments page with filters
activate user
activate page

page -> ctrl : 2. GET /api/v1/appointments\n?patient_id&doctor_id&status&date_from&date_to&page=1&limit=10
activate ctrl

ctrl -> aptSvc : 3. findAll(QueryAppointmentDto)
activate aptSvc

aptSvc -> aptEntity : 4. findAndCount(where, relations, skip, take, order)
activate aptEntity
aptEntity -> db : 5. SELECT appointments WHERE filters\nORDER BY date ASC, time ASC
activate db
db --> aptEntity : 6. return rows and count
deactivate db
aptEntity --> aptSvc : 7. return { data: Appointment[], total }
deactivate aptEntity

aptSvc --> ctrl : 8. return { data, total }
deactivate aptSvc

ctrl --> page : 9. 200 OK { data, meta }
deactivate ctrl

page --> user : 10. Display appointment list
deactivate page

deactivate user

@enduml
