@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "SpecialtyForm" as page
participant ":SpecialtiesController" as ctrl
participant ":SpecialtiesService" as specSvc
entity "SpecialtyEntity" as specEntity
database "PostgreSQL" as db

user -> page : 1. Fill specialty name, description
activate user
activate page

user -> page : 2. Click "Add Specialty"
page -> page : 3. validate: specialty_name is not empty and <= 255 characters,\nspecialty_code is not empty and <= 50 characters,\ndisplay_order is an integer if provided
activate page
deactivate page
alt validation passes
  page -> ctrl : 4. POST /api/v1/specialties\nCreateSpecialtyDto
  activate ctrl

  ctrl -> specSvc : 5. create(CreateSpecialtyDto)
  activate specSvc

  specSvc -> specEntity : 6. save(specialty)
  activate specEntity
  specEntity -> db : 7. INSERT INTO specialties
  activate db
  db --> specEntity : 8. return saved row
  deactivate db
  specEntity --> specSvc : 9. return Specialty
  deactivate specEntity

  specSvc --> ctrl : 10. return Specialty
deactivate specSvc
  ctrl --> page : 11. 201 Created { Specialty }

deactivate ctrl
  page --> user : 12. Display created specialty
else validation fails
  page --> user : 13. Show validation errors
  deactivate page
end


deactivate user

@enduml
