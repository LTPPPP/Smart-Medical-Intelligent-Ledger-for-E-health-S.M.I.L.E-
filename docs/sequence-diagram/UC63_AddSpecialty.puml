@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "SpecialtyForm" as page
participant ":SpecialtiesController" as ctrl
participant ":SpecialtiesService" as specSvc
entity "SpecialtyEntity" as specEntity
database "PostgreSQL" as db

user -> page : 1. Fill specialty name, description and submit
activate user
activate page

page -> page : 2. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 3. POST /api/v1/specialties\nCreateSpecialtyDto
  activate ctrl

  ctrl -> specSvc : 4. create(CreateSpecialtyDto)
  activate specSvc

  specSvc -> specEntity : 5. save(specialty)
  activate specEntity
  specEntity -> db : 6. INSERT INTO specialties
  activate db
  db --> specEntity : 7. return saved row
  deactivate db
  specEntity --> specSvc : 8. return Specialty
  deactivate specEntity

  specSvc --> ctrl : 9. return Specialty
deactivate specSvc
  ctrl --> page : 10. 201 Created { Specialty }

deactivate ctrl
  page --> user : 11. Display created specialty
else validation fails
  page --> user : 12. Show validation errors
  deactivate page
end


deactivate user

@enduml
