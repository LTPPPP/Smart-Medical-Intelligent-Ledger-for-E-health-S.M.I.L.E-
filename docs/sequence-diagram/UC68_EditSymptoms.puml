@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "SymptomDetailPanel" as form
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as symSvc
entity "SymptomEntity" as symptomEntity
database "PostgreSQL" as db

user -> form : 1. Edit symptom fields
activate user
activate form

user -> form : 2. Click "Save Changes"
form -> ctrl : 3. PATCH /api/v1/symptoms/{symptom_id}\nUpdateSymptomDto
activate ctrl

ctrl -> symSvc : 4. update(symptom_id, UpdateSymptomDto)
activate symSvc

symSvc -> symptomEntity : 5. findById(symptom_id)
activate symptomEntity
symptomEntity -> db : 6. SELECT * FROM symptoms WHERE symptom_id
activate db
db --> symptomEntity : 7. return result
deactivate db
symptomEntity --> symSvc : 8. return SymptomEntity
deactivate symptomEntity

symSvc -> symSvc : 9. check exists
activate symSvc
deactivate symSvc
alt found
  symSvc -> symptomEntity : 10. save(updated fields)
  activate symptomEntity
  symptomEntity -> db : 11. UPDATE symptoms SET changed fields
  activate db
  db --> symptomEntity : 12. return updated row
  deactivate db
  symptomEntity --> symSvc : 13. return SymptomEntity
  deactivate symptomEntity

  symSvc --> ctrl : 14. return SymptomEntity


  ctrl --> form : 15. 200 OK SymptomEntity


  form --> user : 16. Display updated symptom

else not found
  symSvc --> ctrl : 17. throw NotFoundException
  deactivate symSvc

  ctrl --> form : 18. 404 { message: Symptom not found }
  deactivate ctrl

  form --> user : 19. Show not found error
  deactivate form
end

deactivate user

@enduml
