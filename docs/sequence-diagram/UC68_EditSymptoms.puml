@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-068: Edit Symptoms

actor "Doctor" as user
boundary "SymptomDetailPanel" as form
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as symSvc
database "PostgreSQL" as db

user -> form : 1. Edit symptom fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/symptoms/{symptom_id}\nUpdateSymptomDto
activate ctrl

ctrl -> symSvc : 3. update(symptom_id, UpdateSymptomDto)
activate symSvc

symSvc -> db : 4. SELECT symptom WHERE symptom_id
activate db
db --> symSvc : 5. return SymptomEntity / null
deactivate db

symSvc -> symSvc : 6. check exists
activate symSvc
deactivate symSvc
alt found
  symSvc -> db : 7. UPDATE symptom SET changed fields
  activate db
  db --> symSvc : 8. return updated SymptomEntity
  deactivate db

  symSvc --> ctrl : 9. return SymptomEntity
  deactivate symSvc

  ctrl --> form : 10. 200 OK SymptomEntity
  deactivate ctrl

  form --> user : 11. Display updated symptom
  deactivate form
else not found
  symSvc --> ctrl : 12. throw NotFoundException
  deactivate symSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Symptom not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
