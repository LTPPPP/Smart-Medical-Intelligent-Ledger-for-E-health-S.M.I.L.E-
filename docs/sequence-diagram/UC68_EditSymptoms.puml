@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "SymptomDetailPanel" as form
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as symSvc
entity "SymptomEntity" as symptomEntity
database "PostgreSQL" as db

user -> form : 1. Edit symptom fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/symptoms/{symptom_id}\nUpdateSymptomDto
activate ctrl

ctrl -> symSvc : 3. update(symptom_id, UpdateSymptomDto)
activate symSvc

symSvc -> symptomEntity : 4. findById(symptom_id)
activate symptomEntity
symptomEntity -> db : 5. SELECT * FROM symptoms WHERE symptom_id
activate db
db --> symptomEntity : 6. return result
deactivate db
symptomEntity --> symSvc : 7. return SymptomEntity
deactivate symptomEntity

symSvc -> symSvc : 8. check exists
activate symSvc
deactivate symSvc
alt found
  symSvc -> symptomEntity : 9. save(updated fields)
  activate symptomEntity
  symptomEntity -> db : 10. UPDATE symptoms SET changed fields
  activate db
  db --> symptomEntity : 11. return updated row
  deactivate db
  symptomEntity --> symSvc : 12. return SymptomEntity
  deactivate symptomEntity

  symSvc --> ctrl : 13. return SymptomEntity


  ctrl --> form : 14. 200 OK SymptomEntity


  form --> user : 15. Display updated symptom

else not found
  symSvc --> ctrl : 16. throw NotFoundException
  deactivate symSvc

  ctrl --> form : 17. 404 { message: Symptom not found }
  deactivate ctrl

  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
