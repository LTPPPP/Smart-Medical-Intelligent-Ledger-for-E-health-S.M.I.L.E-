@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "ChatbotWidget" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
entity "DoctorScheduleEntity" as schedEntity
database "PostgreSQL" as db

user -> page : 1. Ask "What are my upcoming appointments?"
activate user
activate page

page -> page : 2. parse intent -> APPOINTMENT_LOOKUP
activate page
deactivate page

page -> ctrl : 3. GET /api/v1/appointments/patient/{patientId}\n?status=scheduled
activate ctrl

ctrl -> aptSvc : 4. findByPatient(patientId, "scheduled")
activate aptSvc

aptSvc -> aptSvc : 5. build WHERE { patient_id, status }
activate aptSvc
deactivate aptSvc

aptSvc -> aptEntity : 6. find(where, relations, order)
activate aptEntity
aptEntity -> db : 7. SELECT * FROM appointments\nWHERE patient_id AND status = 'scheduled'\nORDER BY appointment_date ASC, appointment_time ASC
activate db
db --> aptEntity : 8. return rows
deactivate db
aptEntity --> aptSvc : 9. return Appointment[]
deactivate aptEntity

aptSvc --> ctrl : 10. return Appointment[]
deactivate aptSvc
ctrl --> page : 11. 200 OK Appointment[]

deactivate ctrl
page -> page : 12. format appointments into\nnatural language response
activate page
deactivate page

page --> user : 13. Display formatted appointment list\n(date, time, clinic, doctor, status)


deactivate page
deactivate user

@enduml
