@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "UserManagementPanel" as form
participant ":UserProfilesController" as ctrl
participant ":UserProfilesService" as profSvc
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db

user -> form : 1. Open user management panel
activate user
activate form

form -> ctrl : 2. GET /api/v1/user-profiles?page=1&limit=20
activate ctrl

ctrl -> profSvc : 3. findAll(QueryUserProfileDto)
activate profSvc

profSvc -> profEntity : 4. findAndCount(filters, pagination)
activate profEntity
profEntity -> db : 5. SELECT user_profiles with filters\n(email, phone, full_name, gender) with pagination
activate db
db --> profEntity : 6. return { data: UserProfile[], total }
deactivate db
profEntity --> profSvc : 7. return { data: UserProfile[], total }
deactivate profEntity

profSvc --> ctrl : 8. return { data, total }
deactivate profSvc

ctrl --> form : 9. 200 OK { data, meta: { page, limit, total } }
deactivate ctrl

form --> user : 10. Display paginated user list\n(name, email, phone, gender, status)
deactivate form

opt View user detail
  user -> form : 11. Select a user
  activate form

  form -> ctrl : 12. GET /api/v1/user-profiles/{id}
  activate ctrl

  ctrl -> profSvc : 13. findOne(id)
  activate profSvc

  profSvc -> profEntity : 14. findOne(userId)
  activate profEntity
  profEntity -> db : 15. SELECT user_profile WHERE user_id
  activate db
  db --> profEntity : 16. return result
  deactivate db
  profEntity --> profSvc : 17. return UserProfile
  deactivate profEntity

  profSvc --> ctrl : 18. return UserProfileEntity
  deactivate profSvc

  ctrl --> form : 19. 200 OK UserProfileEntity
  deactivate ctrl

  form --> user : 20. Display user detail
  deactivate form
end

deactivate user

@enduml
