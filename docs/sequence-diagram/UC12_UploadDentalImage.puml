@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC: Upload Dental Image

actor "Dentist" as user
boundary "DentalImageUploadPage" as page
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as svc
participant "S3Storage" as s3
database "PostgreSQL" as db

user -> page : 1. Select patient record and\nchoose X-ray file to upload
activate user
activate page

page -> page : 2. Validate file type and size
activate page
deactivate page
alt file is valid
  page -> s3 : 3. Upload image file to S3 bucket
  activate s3

  s3 -> s3 : 4. check upload result
  activate s3
  deactivate s3
  alt upload succeeds
    s3 --> page : 5. image_url, thumbnail_url
    deactivate s3

    page -> ctrl : 6. POST /api/v1/dental-images\n(CreateDentalImageDto)
    activate ctrl

    ctrl -> svc : 7. create(CreateDentalImageDto)
    activate svc

    svc -> db : 8. create(DentalImageEntity)
    activate db
    db --> svc : DentalImageEntity
    deactivate db

    svc -> db : 9. save(DentalImageEntity)
    activate db
    db --> svc : DentalImageEntity
    deactivate db

    svc --> ctrl : 10. DentalImageEntity
    deactivate svc

    ctrl --> page : 11. 201 Created — DentalImageEntity
    deactivate ctrl

    page --> user : 12. Display uploaded image with details
    deactivate page
  else upload fails
    s3 --> page : 13. StorageError
    deactivate s3
    activate page
    page --> user : 14. Show upload failed error
  end
else file is invalid
  page --> user : 15. Show file validation error
  deactivate page
end

deactivate user

@enduml
