@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentHistoryPanel" as form
participant ":TreatmentHistoryController" as ctrl
participant ":TreatmentHistoryService" as treatSvc
entity "TreatmentHistoryEntity" as treatEntity
database "PostgreSQL" as db

user -> form : 1. Open treatment history for patient
activate user
activate form

form -> ctrl : 2. GET /api/v1/treatment-history/patient/{patient_id}
activate ctrl

ctrl -> treatSvc : 3. findByPatientId(patient_id)
activate treatSvc

treatSvc -> treatEntity : 4. find(patient_id)
activate treatEntity
treatEntity -> db : 5. SELECT treatment_history WHERE patient_id
activate db
db --> treatEntity : 6. return result
deactivate db
treatEntity --> treatSvc : 7. return TreatmentHistoryEntity[]
deactivate treatEntity

treatSvc --> ctrl : 8. return TreatmentHistoryEntity[]
deactivate treatSvc

ctrl --> form : 9. 200 OK TreatmentHistoryEntity[]
deactivate ctrl

form --> user : 10. Display treatment history list
deactivate form

opt View specific treatment detail
  user -> form : 11. Select a treatment entry
  activate form

  form -> ctrl : 12. GET /api/v1/treatment-history/{treatment_id}
  activate ctrl

  ctrl -> treatSvc : 13. findOne(treatment_id)
  activate treatSvc

  treatSvc -> treatEntity : 14. findOne(treatment_id)
  activate treatEntity
  treatEntity -> db : 15. SELECT treatment_history WHERE treatment_id
  activate db
  db --> treatEntity : 16. return result
  deactivate db
  treatEntity --> treatSvc : 17. return TreatmentHistoryEntity
  deactivate treatEntity

  treatSvc --> ctrl : 18. return TreatmentHistoryEntity
  deactivate treatSvc

  ctrl --> form : 19. 200 OK TreatmentHistoryEntity
  deactivate ctrl

  form --> user : 20. Display treatment detail\n(tooth number, procedure, materials, notes)
  deactivate form
end

deactivate user

@enduml
