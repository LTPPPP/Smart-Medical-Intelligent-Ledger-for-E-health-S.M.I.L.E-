@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-045: View Treatment Profile

actor "Doctor" as user
boundary "TreatmentHistoryPanel" as form
participant ":TreatmentHistoryController" as ctrl
participant ":TreatmentHistoryService" as treatSvc
database "PostgreSQL" as db

user -> form : 1. Open treatment history for patient
activate user
activate form

form -> ctrl : 2. GET /api/v1/treatment-history/patient/{patient_id}
activate ctrl

ctrl -> treatSvc : 3. findByPatientId(patient_id)
activate treatSvc

treatSvc -> db : 4. SELECT treatment_history WHERE patient_id
activate db
db --> treatSvc : 5. return TreatmentHistoryEntity[]
deactivate db

treatSvc --> ctrl : 6. return TreatmentHistoryEntity[]
deactivate treatSvc

ctrl --> form : 7. 200 OK TreatmentHistoryEntity[]
deactivate ctrl

form --> user : 8. Display treatment history list
deactivate form

opt View specific treatment detail
  user -> form : 9. Select a treatment entry
  activate form

  form -> ctrl : 10. GET /api/v1/treatment-history/{treatment_id}
  activate ctrl

  ctrl -> treatSvc : 11. findOne(treatment_id)
  activate treatSvc

  treatSvc -> db : 12. SELECT treatment_history WHERE treatment_id
  activate db
  db --> treatSvc : 13. return TreatmentHistoryEntity / null
  deactivate db

  treatSvc --> ctrl : 14. return TreatmentHistoryEntity / null
  deactivate treatSvc

  ctrl --> form : 15. 200 OK TreatmentHistoryEntity
  deactivate ctrl

  form --> user : 16. Display treatment detail\n(tooth number, procedure, materials, notes)
  deactivate form
end

deactivate user

@enduml
