@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-048: Create Appointment at Facility

actor "Receptionist" as user
boundary "AppointmentBookingForm" as form
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
database "PostgreSQL" as db
participant ":AppointmentNotificationPublisher" as notifPub

user -> form : 1. Fill patient info, specialty,\ndate, time, chief complaint
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/appointments/by-specialty\nBookBySpecialtyDto
  activate ctrl

  ctrl -> aptSvc : 4. createBySpecialty(BookBySpecialtyDto)
  activate aptSvc

  aptSvc -> db : 5. SELECT DoctorSpecialty WHERE specialty_id
  activate db
  db --> aptSvc : 6. return DoctorSpecialty[]
  deactivate db

  aptSvc -> aptSvc : 7. check doctors found for specialty
  activate aptSvc
  deactivate aptSvc
  alt doctors found
    aptSvc -> db : 8. SELECT DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status
    activate db
    db --> aptSvc : 9. return DoctorSchedule / null
    deactivate db

    aptSvc -> aptSvc : 10. check available doctor found
    activate aptSvc
    deactivate aptSvc
    alt available doctor found
      aptSvc -> aptSvc : 11. Generate appointment code
      activate aptSvc
      deactivate aptSvc

      aptSvc -> db : 12. INSERT Appointment
      activate db
      db --> aptSvc : 13. return Appointment
      deactivate db

      aptSvc -> db : 14. INSERT AppointmentStatusHistory
      activate db
      db --> aptSvc : 15. return AppointmentStatusHistory
      deactivate db

      aptSvc --> ctrl : 16. return Appointment
      deactivate aptSvc

      ctrl --> form : 17. 201 Created { Appointment }
      deactivate ctrl

      form --> user : 18. Show booking confirmation\n(appointment code, doctor, time)
      deactivate form
    else no available doctor
      aptSvc --> ctrl : 19. throw BadRequestException
      deactivate aptSvc
      ctrl --> form : 20. 400 { No scheduled doctors found }
      deactivate ctrl
      form --> user : 21. Show no availability message
      deactivate form
    end
  else no doctors for specialty
    aptSvc --> ctrl : 22. throw BadRequestException
    deactivate aptSvc
    ctrl --> form : 23. 400 { No doctors found for specialty }
    deactivate ctrl
    form --> user : 24. Show no doctors message
    deactivate form
  end
else validation fails
  form --> user : 25. Show validation errors
  deactivate form
end

deactivate user

@enduml
