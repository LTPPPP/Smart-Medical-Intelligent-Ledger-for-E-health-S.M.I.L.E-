@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "AccountDetailPanel" as form
participant ":AccountsController" as ctrl
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

user -> form : 1. Click "Lock Account" and enter reason
activate user
activate form

form -> ctrl : 2. POST /api/v1/accounts/{id}/lock\n{ reason }
activate ctrl

ctrl -> accSvc : 3. lockAccount(id, reason, adminId)
activate accSvc

accSvc -> accEntity : 4. findOne(id)
activate accEntity
accEntity -> db : 5. SELECT account WHERE id
activate db
db --> accEntity : 6. return result
deactivate db
accEntity --> accSvc : 7. return Account
deactivate accEntity

accSvc -> accSvc : 8. check account exists
activate accSvc
deactivate accSvc
alt account found
  accSvc -> accEntity : 9. save(id, status: LOCKED, lockedAt, lockedReason, lockedBy)
  activate accEntity
  accEntity -> db : 10. UPDATE account SET\nstatus = LOCKED, lockedAt = NOW(),\nlockedReason = reason, lockedBy = adminId
  activate db
  db --> accEntity : 11. return updated row
  deactivate db
  accEntity --> accSvc : 12. return Account
  deactivate accEntity

  accSvc --> ctrl : 13. return success

  ctrl --> form : 14. 200 OK { message: Account locked successfully }
  form --> user : 15. Display lock confirmation
else account not found
  accSvc --> ctrl : 16. throw NotFoundException
  deactivate accSvc

  ctrl --> form : 17. 404 { message: Account not found }
  deactivate ctrl

  form --> user : 18. Display error message
  deactivate form
end

deactivate user

@enduml
