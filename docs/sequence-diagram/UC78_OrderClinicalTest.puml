@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ExaminationPanel" as form
participant ":ClinicalOrdersController" as ctrl
participant ":ClinicalOrdersService" as orderSvc
entity "ClinicalOrderEntity" as orderEntity
database "PostgreSQL" as db

user -> form : 1. Select order type CLINICAL,\nfill test name, description, priority
activate user
activate form

user -> form : 2. Click "Place Order"
form -> form : 3. validate: patient_id, ordered_by, order_type\nand test_type are not empty,\nteeth_numbers is an array of integers if provided,\nordered_date and scheduled_date are ISO dates if provided
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/clinical-orders\n{ record_id, patient_id, ordered_by,\norder_type: CLINICAL, description, priority }
  activate ctrl

  ctrl -> orderSvc : 5. create(CreateClinicalOrderDto)
  activate orderSvc

  orderSvc -> orderEntity : 6. save(ClinicalOrderEntity)
  activate orderEntity
  orderEntity -> db : 7. INSERT INTO clinical_orders\n{ order_type: CLINICAL,\nstatus: ORDERED, ordered_at: NOW() }
  activate db
  db --> orderEntity : 8. return record
  deactivate db
  orderEntity --> orderSvc : 9. return ClinicalOrderEntity
  deactivate orderEntity

  orderSvc --> ctrl : 10. return ClinicalOrderEntity
  deactivate orderSvc

  ctrl --> form : 11. 201 Created ClinicalOrderEntity
  deactivate ctrl

  form --> user : 12. Display created clinical test order\n(status: ORDERED)
else validation fails
  form --> user : 13. Show validation errors
  deactivate form
end

deactivate user

@enduml
