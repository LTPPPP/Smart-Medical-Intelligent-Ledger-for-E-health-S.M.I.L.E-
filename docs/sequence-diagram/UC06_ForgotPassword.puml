@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ForgotPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":OtpTokensService" as otpSvc
entity "AccountEntity" as accEntity
entity "OtpTokenEntity" as otpEntity
database "PostgreSQL" as db

user -> form : 1. Enter email or phone number
activate user
activate form

user -> form : 2. Click "Send Reset Code"

form -> form : 3. validate: emailOrPhone is not empty
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/auth/forgot/password\n{ emailOrPhone }
  activate ctrl

  ctrl -> authSvc : 5. forgotPassword(emailOrPhone)
  activate authSvc

  authSvc -> accSvc : 6. findByEmail(emailOrPhone)
  activate accSvc

  accSvc -> accEntity : 7. findByEmail(email)
  activate accEntity
  accEntity -> db : 8. SELECT account WHERE email
  activate db
  db --> accEntity : 9. return result
  deactivate db
  accEntity --> accSvc : 10. return Account
  deactivate accEntity

  accSvc --> authSvc : 11. return Account
  deactivate accSvc

  authSvc -> authSvc : 12. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    ref over authSvc, otpSvc, otpEntity, db : UC-10 Send OTP

    authSvc --> ctrl : 13. return { message: "Reset code sent." }

    ctrl --> form : 14. 200 OK

    form --> user : 15. Switch to OTP step, show\n"code sent to <emailOrPhone>"
  else account not found
    authSvc --> ctrl : 16. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 17. 422 { email: emailNotExists }
    deactivate ctrl

    form --> user : 18. Show "Failed to send OTP. Please\ncheck your email or phone and try again"
  end
else emailOrPhone is empty
  form --> user : 19. Show "Please enter your email or phone"
  deactivate form
end

deactivate user

@enduml
