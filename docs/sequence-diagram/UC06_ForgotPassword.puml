@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ForgotPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Enter email address
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/forgot/password
  activate ctrl

  ctrl -> authSvc : 4. forgotPassword(email)
  activate authSvc

  authSvc -> accSvc : 5. findByEmail(email)
  activate accSvc

  accSvc -> accEntity : 6. findByEmail(email)
  activate accEntity
  accEntity -> db : 7. SELECT account WHERE email
  activate db
  db --> accEntity : 8. return result
  deactivate db
  accEntity --> accSvc : 9. return Account
  deactivate accEntity

  accSvc --> authSvc : 10. return Account
  deactivate accSvc

  authSvc -> authSvc : 11. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> config : 12. get(auth.forgotExpires)
    activate config
    config --> authSvc : 13. return tokenExpiresIn
    deactivate config

    authSvc -> config : 14. get(auth.forgotSecret)
    activate config
    config --> authSvc : 15. return forgotSecret
    deactivate config

    authSvc -> jwt : 16. signAsync({ forgotAccountId }, secret, expiresIn)
    activate jwt
    jwt --> authSvc : 17. return resetToken
    deactivate jwt

    authSvc ->> user : 18. Send password reset email with token

    authSvc --> ctrl : 19. return { message: "Password reset link sent to your email." }

    ctrl --> form : 20. 200 OK

    form --> user : 21. Show success message
  else account not found
    authSvc --> ctrl : 22. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 23. 422 { email: emailNotExists }
    deactivate ctrl

    form --> user : 24. Show email not found message
  end
else validation fails
  form --> user : 25. Show validation errors
  deactivate form
end

deactivate user

@enduml
