@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ForgotPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Enter email address
activate user
activate form

user -> form : 2. Click "Reset Password"

form -> form : 3. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/auth/forgot/password
  activate ctrl

  ctrl -> authSvc : 5. forgotPassword(email)
  activate authSvc

  authSvc -> accSvc : 6. findByEmail(email)
  activate accSvc

  accSvc -> accEntity : 7. findByEmail(email)
  activate accEntity
  accEntity -> db : 8. SELECT account WHERE email
  activate db
  db --> accEntity : 9. return result
  deactivate db
  accEntity --> accSvc : 10. return Account
  deactivate accEntity

  accSvc --> authSvc : 11. return Account
  deactivate accSvc

  authSvc -> authSvc : 12. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> config : 13. get(auth.forgotExpires)
    activate config
    config --> authSvc : 14. return tokenExpiresIn
    deactivate config

    authSvc -> config : 15. get(auth.forgotSecret)
    activate config
    config --> authSvc : 16. return forgotSecret
    deactivate config

    authSvc -> jwt : 17. signAsync({ forgotAccountId }, secret, expiresIn)
    activate jwt
    jwt --> authSvc : 18. return resetToken
    deactivate jwt

    authSvc -> authSvc : 19. Send password reset email
    activate authSvc
    deactivate authSvc

    authSvc --> ctrl : 20. return { message: "Password reset link sent to your email." }

    ctrl --> form : 21. 200 OK

    form --> user : 22. Show success message
  else account not found
    authSvc --> ctrl : 23. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 24. 422 { email: emailNotExists }
    deactivate ctrl

    form --> user : 25. Show email not found message
  end
else validation fails
  form --> user : 26. Show validation errors
  deactivate form
end

deactivate user

@enduml
