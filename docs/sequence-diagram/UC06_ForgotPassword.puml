@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-006: Forgot Password

actor "User" as user
boundary "ForgotPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Enter email address
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/forgot/password
  activate ctrl

  ctrl -> authSvc : 4. forgotPassword(email)
  activate authSvc

  authSvc -> accSvc : 5. findByEmail(email)
  activate accSvc
  accSvc -> db : 6. SELECT account WHERE email
  activate db
  db --> accSvc : 7. return Account / null
  deactivate db
  accSvc --> authSvc : 8. return Account / null
  deactivate accSvc

  authSvc -> authSvc : 9. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> config : 10. get(auth.forgotExpires)
    activate config
    config --> authSvc : 11. return tokenExpiresIn
    deactivate config

    authSvc -> config : 12. get(auth.forgotSecret)
    activate config
    config --> authSvc : 13. return forgotSecret
    deactivate config

    authSvc -> jwt : 14. signAsync({ forgotAccountId }, secret, expiresIn)
    activate jwt
    jwt --> authSvc : 15. return resetToken
    deactivate jwt

    authSvc ->> user : 16. Send password reset email with token

    authSvc --> ctrl : 17. return { message: "Password reset link sent to your email." }
    deactivate authSvc

    ctrl --> form : 18. 200 OK
    deactivate ctrl

    form --> user : 19. Show success message
    deactivate form
  else account not found
    authSvc --> ctrl : 20. throw UnprocessableEntityException
    deactivate authSvc
    activate ctrl
    ctrl --> form : 21. 422 { email: emailNotExists }
    deactivate ctrl
    activate form
    form --> user : 22. Show email not found message
  end
else validation fails
  form --> user : 23. Show validation errors
  deactivate form
end

deactivate user

@enduml
