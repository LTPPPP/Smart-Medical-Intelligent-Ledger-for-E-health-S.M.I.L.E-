@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentHistoryPanel" as form
participant ":TreatmentHistoryController" as ctrl
participant ":TreatmentHistoryService" as treatSvc
entity "TreatmentHistoryEntity" as treatEntity
database "PostgreSQL" as db

user -> form : 1. Fill treatment details\n(patient, record, tooth number, procedure,\nmaterials, notes)
activate user
activate form

user -> form : 2. Click "Add Treatment"

form -> ctrl : 3. POST /api/v1/treatment-history\nCreateTreatmentHistoryDto
activate ctrl

ctrl -> treatSvc : 4. create(CreateTreatmentHistoryDto)
activate treatSvc

treatSvc -> treatEntity : 5. save(treatmentHistory)
activate treatEntity
treatEntity -> db : 6. INSERT treatment_history\n{ patient_id, record_id, tooth_number,\nprocedure, materials, notes }
activate db
db --> treatEntity : 7. return saved row
deactivate db
treatEntity --> treatSvc : 8. return TreatmentHistoryEntity
deactivate treatEntity

treatSvc --> ctrl : 9. return TreatmentHistoryEntity
deactivate treatSvc

ctrl --> form : 10. 201 Created TreatmentHistoryEntity
deactivate ctrl

form --> user : 11. Display created treatment profile
deactivate form

deactivate user

@enduml
