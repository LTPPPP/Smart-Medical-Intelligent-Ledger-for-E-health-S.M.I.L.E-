@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentHistoryPanel" as form
participant ":TreatmentHistoryController" as ctrl
participant ":TreatmentHistoryService" as treatSvc
entity "TreatmentHistoryEntity" as treatEntity
database "PostgreSQL" as db

user -> form : 1. Fill treatment details\n(patient, record, tooth number, procedure,\nmaterials, notes) and submit
activate user
activate form

form -> ctrl : 2. POST /api/v1/treatment-history\nCreateTreatmentHistoryDto
activate ctrl

ctrl -> treatSvc : 3. create(CreateTreatmentHistoryDto)
activate treatSvc

treatSvc -> treatEntity : 4. save(treatmentHistory)
activate treatEntity
treatEntity -> db : 5. INSERT treatment_history\n{ patient_id, record_id, tooth_number,\nprocedure, materials, notes }
activate db
db --> treatEntity : 6. return saved row
deactivate db
treatEntity --> treatSvc : 7. return TreatmentHistoryEntity
deactivate treatEntity

treatSvc --> ctrl : 8. return TreatmentHistoryEntity
deactivate treatSvc

ctrl --> form : 9. 201 Created TreatmentHistoryEntity
deactivate ctrl

form --> user : 10. Display created treatment profile
deactivate form

deactivate user

@enduml
