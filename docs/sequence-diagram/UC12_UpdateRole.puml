@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RoleDetailPanel" as form
participant ":RolesController" as ctrl
participant ":RolesService" as roleSvc
entity "RoleEntity" as roleEntity
database "PostgreSQL" as db

user -> form : 1. Edit role name or description and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/roles/{id} UpdateRoleDto
activate ctrl

ctrl -> roleSvc : 3. update(id, UpdateRoleDto)
activate roleSvc

roleSvc -> roleEntity : 4. save(id, updatedFields)
activate roleEntity
roleEntity -> db : 5. UPDATE role SET changed fields WHERE role_id
activate db
db --> roleEntity : 6. return updated row
deactivate db
roleEntity --> roleSvc : 7. return Role
deactivate roleEntity

roleSvc --> ctrl : 8. return RoleEntity
deactivate roleSvc

ctrl --> form : 9. 200 OK RoleEntity
deactivate ctrl

form --> user : 10. Display updated role
deactivate form

deactivate user

@enduml
