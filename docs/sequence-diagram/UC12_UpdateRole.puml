@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RoleDetailPanel" as form
participant ":RolesController" as ctrl
participant ":RolesService" as roleSvc
entity "RoleEntity" as roleEntity
database "PostgreSQL" as db

user -> form : 1. Edit role name or description
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> ctrl : 3. PATCH /api/v1/roles/{id} UpdateRoleDto
activate ctrl

ctrl -> roleSvc : 4. update(id, UpdateRoleDto)
activate roleSvc

roleSvc -> roleEntity : 5. save(id, updatedFields)
activate roleEntity
roleEntity -> db : 6. UPDATE role SET changed fields WHERE role_id
activate db
db --> roleEntity : 7. return updated row
deactivate db
roleEntity --> roleSvc : 8. return Role
deactivate roleEntity

roleSvc --> ctrl : 9. return RoleEntity
deactivate roleSvc

ctrl --> form : 10. 200 OK RoleEntity
deactivate ctrl

form --> user : 11. Display updated role
deactivate form

deactivate user

@enduml
