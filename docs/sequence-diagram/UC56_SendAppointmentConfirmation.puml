@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Receptionist" as user
boundary "AppointmentDetailPanel" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":AppointmentNotificationPublisher" as notifPub
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Click "Send Confirmation" on appointment
activate user
activate page

page -> ctrl : 2. POST /api/v1/appointments/{id}/notifications/confirmation
activate ctrl

ctrl -> aptSvc : 3. sendConfirmation(appointmentId)
activate aptSvc

aptSvc -> aptEntity : 4. findOne(appointment_id, relations)
activate aptEntity
aptEntity -> db : 5. SELECT * FROM appointments WHERE appointment_id
activate db
db --> aptEntity : 6. return row
deactivate db
aptEntity --> aptSvc : 7. return Appointment
deactivate aptEntity

aptSvc -> aptSvc : 8. check appointment exists
activate aptSvc
deactivate aptSvc
alt appointment found
  aptSvc -> aptSvc : 9. buildNotificationPayload\n(appointment, APPOINTMENT_CONFIRMATION)
  activate aptSvc
  deactivate aptSvc

  aptSvc -> notifPub : 10. sendAppointmentConfirmation(payload)
  activate notifPub
  notifPub --> aptSvc : 11. return AppointmentNotificationPayload
  deactivate notifPub

  aptSvc --> ctrl : 12. return AppointmentNotificationPayload

  ctrl --> page : 13. 202 Accepted

  page --> user : 14. Display confirmation sent success
else appointment not found
  aptSvc --> ctrl : 15. throw NotFoundException
  deactivate aptSvc

  ctrl --> page : 16. 404 { Appointment not found }
  deactivate ctrl

  page --> user : 17. Display error message
  deactivate page
end

deactivate user

@enduml
