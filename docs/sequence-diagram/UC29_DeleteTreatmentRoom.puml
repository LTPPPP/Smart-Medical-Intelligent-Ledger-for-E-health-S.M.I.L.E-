@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RoomDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
entity "TreatmentRoomEntity" as roomEntity
database "PostgreSQL" as db

user -> form : 1. Click "Delete Room" and confirm
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/treatment-rooms/{id}
activate ctrl

ctrl -> roomSvc : 3. remove(id)
activate roomSvc

roomSvc -> roomEntity : 4. findOne(id)
activate roomEntity
roomEntity -> db : 5. SELECT treatment_room WHERE room_id
activate db
db --> roomEntity : 6. return result
deactivate db
roomEntity --> roomSvc : 7. return TreatmentRoomEntity
deactivate roomEntity

roomSvc -> roomSvc : 8. check room exists
activate roomSvc
deactivate roomSvc
alt room found
  roomSvc -> roomEntity : 9. remove(room)
  activate roomEntity
  roomEntity -> db : 10. DELETE FROM treatment_rooms WHERE room_id
  activate db
  db --> roomEntity : 11. return deleted (affectedRows: 1)
  deactivate db
  roomEntity --> roomSvc : 12. return success
  deactivate roomEntity

  roomSvc --> ctrl : 13. return success
  ctrl --> form : 14. 204 No Content
  form --> user : 15. Display deletion confirmation
else room not found
  roomSvc --> ctrl : 16. throw NotFoundException
  deactivate roomSvc
  ctrl --> form : 17. 404 { message: Treatment room not found }
  deactivate ctrl
  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
