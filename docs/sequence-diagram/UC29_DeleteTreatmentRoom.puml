@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-029: Delete Treatment Room

actor "Admin" as user
boundary "RoomDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
database "PostgreSQL" as db

user -> form : 1. Click "Delete Room" and confirm
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/treatment-rooms/{id}
activate ctrl

ctrl -> roomSvc : 3. remove(id)
activate roomSvc

roomSvc -> db : 4. SELECT treatment_room WHERE room_id
activate db
db --> roomSvc : TreatmentRoomEntity / null
deactivate db

roomSvc -> roomSvc : 5. check room exists
activate roomSvc
deactivate roomSvc
alt room found
  roomSvc -> db : 6. DELETE FROM treatment_rooms WHERE room_id
  activate db
  db --> roomSvc : void
  deactivate db

  roomSvc --> ctrl : void
  deactivate roomSvc

  ctrl --> form : 7. 204 No Content
  deactivate ctrl

  form --> user : 8. Display deletion confirmation
  deactivate form
else room not found
  roomSvc --> ctrl : 9. throw NotFoundException
  deactivate roomSvc
  activate ctrl
  ctrl --> form : 10. 404 { message: Treatment room not found }
  deactivate ctrl
  activate form
  form --> user : 11. Show not found error
  deactivate form
end

deactivate user

@enduml
