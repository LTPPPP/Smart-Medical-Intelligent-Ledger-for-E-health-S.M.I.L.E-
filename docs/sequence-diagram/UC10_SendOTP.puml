@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
title UC-10 Send OTP\n(sub-flow referenced by UC-05 Reset Password and UC-06 Forgot Password)
participant ":AuthService / :AccountsService" as authSvc
participant ":OtpTokensService" as otpSvc
entity "OtpTokenEntity" as otpEntity
database "PostgreSQL" as db

authSvc -> otpSvc : 1. create(accountId, otpType)\notpType = PASSWORD_RESET (UC-05, UC-06)\nor IDENTITY_VERIFY (phone verification)
activate authSvc
activate otpSvc

otpSvc -> otpSvc : 2. generateOtpCode()\nrandom 6-digit code 100000-999999
activate otpSvc
deactivate otpSvc

otpSvc -> otpSvc : 3. expiresAt = now + AUTH_OTP_EXPIRES_IN\n(default 5m)
activate otpSvc
deactivate otpSvc

otpSvc -> otpEntity : 4. create(accountId, otpCode,\notpType, expiresAt)
activate otpEntity
otpEntity -> db : 5. INSERT INTO otp_tokens\n{ accountId, otpCode, otpType, expiresAt }
activate db
db --> otpEntity : 6. return saved row
deactivate db
otpEntity --> otpSvc : 7. return OtpToken
deactivate otpEntity

otpSvc --> authSvc : 8. return OtpToken
deactivate otpSvc

authSvc -> authSvc : 9. dispatch otpCode to the\naccount's email or phone
activate authSvc
deactivate authSvc

deactivate authSvc

@enduml
