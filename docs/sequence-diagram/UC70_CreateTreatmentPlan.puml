@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "TreatmentPlanForm" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as svc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Fill plan_name, objectives,\nduration_weeks, patient_id, record_id
activate user
activate form

user -> form : 2. Click "Create Plan"
form -> form : 3. validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /treatment-plans (CreateTreatmentPlanDto)
  activate ctrl

  ctrl -> svc : 5. create(CreateTreatmentPlanDto)
  activate svc

  svc -> planEntity : 6. create(TreatmentPlanEntity)
  activate planEntity
  planEntity -> db : 7. INSERT INTO treatment_plans
  activate db
  db --> planEntity : 8. return created row
  deactivate db
  planEntity --> svc : 9. return TreatmentPlanEntity
  deactivate planEntity

  svc -> planEntity : 10. save(TreatmentPlanEntity)
  activate planEntity
  planEntity -> db : 11. INSERT/UPDATE treatment_plans
  activate db
  db --> planEntity : 12. return saved row
  deactivate db
  planEntity --> svc : 13. return TreatmentPlanEntity
  deactivate planEntity

  svc --> ctrl : 14. return TreatmentPlanEntity
  deactivate svc

  ctrl --> form : 15. 201 Created
  deactivate ctrl

  form --> user : 16. Show treatment plan created
else validation fails
  form --> user : 17. Show validation errors
  deactivate form
end

deactivate user

@enduml
