@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "TreatmentPlanForm" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as svc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Fill plan_name, objectives,\nduration_weeks, patient_id, record_id
activate user
activate form

form -> form : 2. validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /treatment-plans (CreateTreatmentPlanDto)
  activate ctrl

  ctrl -> svc : 4. create(CreateTreatmentPlanDto)
  activate svc

  svc -> planEntity : 5. create(TreatmentPlanEntity)
  activate planEntity
  planEntity -> db : 6. INSERT INTO treatment_plans
  activate db
  db --> planEntity : 7. return created row
  deactivate db
  planEntity --> svc : 8. return TreatmentPlanEntity
  deactivate planEntity

  svc -> planEntity : 9. save(TreatmentPlanEntity)
  activate planEntity
  planEntity -> db : 10. INSERT/UPDATE treatment_plans
  activate db
  db --> planEntity : 11. return saved row
  deactivate db
  planEntity --> svc : 12. return TreatmentPlanEntity
  deactivate planEntity

  svc --> ctrl : 13. return TreatmentPlanEntity
  deactivate svc

  ctrl --> form : 14. 201 Created
  deactivate ctrl

  form --> user : 15. Show treatment plan created
else validation fails
  form --> user : 16. Show validation errors
  deactivate form
end

deactivate user

@enduml
