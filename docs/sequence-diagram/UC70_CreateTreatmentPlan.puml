@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-070: Create Treatment Plan

actor "Dentist" as user
boundary "TreatmentPlanForm" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as svc
participant ":MedicalRecordsService" as recSvc
database "PostgreSQL" as db

user -> form : 1. Fill plan_name, objectives,\nduration_weeks, patient_id, record_id
activate user
activate form

form -> form : 2. validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /treatment-plans (CreateTreatmentPlanDto)
  activate ctrl

  ctrl -> svc : 4. create(CreateTreatmentPlanDto)
  activate svc

  svc -> recSvc : 5. findOne(record_id)
  activate recSvc

  recSvc -> db : 6. findOne({ where: { record_id } })
  activate db
  db --> recSvc : 7. return MedicalRecordEntity / null
  deactivate db

  recSvc -> recSvc : 8. check record exists
  activate recSvc
  deactivate recSvc
  alt record found
    recSvc --> svc : 9. return MedicalRecordEntity
    deactivate recSvc

    svc -> db : 10. create(TreatmentPlanEntity)
    activate db
    db --> svc : 11. return TreatmentPlanEntity
    deactivate db

    svc -> db : 12. save(TreatmentPlanEntity)
    activate db
    db --> svc : 13. return TreatmentPlanEntity
    deactivate db

    svc --> ctrl : 14. return TreatmentPlanEntity
    deactivate svc

    ctrl --> form : 15. 201 Created
    deactivate ctrl

    form --> user : 16. Show treatment plan created
    deactivate form
  else record not found
    recSvc --> svc : 17. throw NotFoundException
    deactivate recSvc
    activate svc
    svc --> ctrl : 18. NotFoundException
    deactivate svc
    activate ctrl
    ctrl --> form : 19. 404 Not Found
    deactivate ctrl
    activate form
    form --> user : 20. Show error message
  end
else validation fails
  form --> user : 21. Show validation errors
  deactivate form
end

deactivate user

@enduml
