@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "ClinicEditForm" as form
participant ":ClinicsController" as ctrl
participant ":ClinicsService" as clinicSvc
entity "ClinicEntity" as clinicEntity
database "PostgreSQL" as db

user -> form : 1. Edit clinic fields
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> ctrl : 3. PATCH /api/v1/clinics/{id}\nUpdateClinicDto
activate ctrl

ctrl -> clinicSvc : 4. update(id, UpdateClinicDto)
activate clinicSvc

clinicSvc -> clinicEntity : 5. findOne(id)
activate clinicEntity
clinicEntity -> db : 6. SELECT clinic WHERE clinic_id
activate db
db --> clinicEntity : 7. return result
deactivate db
clinicEntity --> clinicSvc : 8. return ClinicEntity
deactivate clinicEntity

clinicSvc -> clinicSvc : 9. check clinic exists
activate clinicSvc
deactivate clinicSvc
alt clinic found
  clinicSvc -> clinicSvc : 10. Merge update fields\nand parse license_expiry
  activate clinicSvc
  deactivate clinicSvc

  clinicSvc -> clinicEntity : 11. save(updatedClinic)
  activate clinicEntity
  clinicEntity -> db : 12. UPDATE clinic SET changed fields
  activate db
  db --> clinicEntity : 13. return updated row
  deactivate db
  clinicEntity --> clinicSvc : 14. return ClinicEntity
  deactivate clinicEntity

  clinicSvc --> ctrl : 15. return ClinicEntity

  ctrl --> form : 16. 200 OK ClinicEntity
  form --> user : 17. Display updated clinic
else clinic not found
  clinicSvc --> ctrl : 18. throw NotFoundException
  deactivate clinicSvc
  ctrl --> form : 19. 404 { message: Clinic not found }
  deactivate ctrl
  form --> user : 20. Display error message
  deactivate form
end

deactivate user

@enduml
