@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-025: Update Clinic Information

actor "Admin" as user
boundary "ClinicEditForm" as form
participant ":ClinicsController" as ctrl
participant ":ClinicsService" as clinicSvc
database "PostgreSQL" as db

user -> form : 1. Edit clinic fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/clinics/{id}\nUpdateClinicDto
activate ctrl

ctrl -> clinicSvc : 3. update(id, UpdateClinicDto)
activate clinicSvc

clinicSvc -> db : 4. SELECT clinic WHERE clinic_id
activate db
db --> clinicSvc : 5. return ClinicEntity / null
deactivate db

clinicSvc -> clinicSvc : 6. check clinic exists
activate clinicSvc
deactivate clinicSvc
alt clinic found
  clinicSvc -> clinicSvc : 7. Merge update fields\nand parse license_expiry
  activate clinicSvc
  deactivate clinicSvc

  clinicSvc -> db : 8. UPDATE clinic SET changed fields
  activate db
  db --> clinicSvc : 9. return updated ClinicEntity
  deactivate db

  clinicSvc --> ctrl : 10. return ClinicEntity
  deactivate clinicSvc

  ctrl --> form : 11. 200 OK ClinicEntity
  deactivate ctrl

  form --> user : 12. Display updated clinic
  deactivate form
else clinic not found
  clinicSvc --> ctrl : 13. throw NotFoundException
  deactivate clinicSvc
  activate ctrl
  ctrl --> form : 14. 404 { message: Clinic not found }
  deactivate ctrl
  activate form
  form --> user : 15. Display error message
  deactivate form
end

deactivate user

@enduml
