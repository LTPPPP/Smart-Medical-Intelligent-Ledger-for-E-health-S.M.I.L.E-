@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "MedicalRecordDetailPanel" as form
participant ":MedicalRecordsController" as ctrl
participant ":MedicalRecordsService" as recSvc
entity "MedicalRecordEntity" as recEntity
entity "MedicalRecordVersionEntity" as verEntity
database "PostgreSQL" as db

user -> form : 1. Edit medical record fields
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> ctrl : 3. PATCH /api/v1/medical-records/{record_id}\nUpdateMedicalRecordDto
activate ctrl

ctrl -> recSvc : 4. update(record_id, UpdateMedicalRecordDto)
activate recSvc

recSvc -> recEntity : 5. findOne(record_id)
activate recEntity
recEntity -> db : 6. SELECT medical_record WHERE record_id
activate db
db --> recEntity : 7. return result
deactivate db
recEntity --> recSvc : 8. return MedicalRecordEntity
deactivate recEntity

recSvc -> recSvc : 9. check record exists
activate recSvc
deactivate recSvc
alt record found
  recSvc -> verEntity : 10. save(versionSnapshot)
  activate verEntity
  verEntity -> db : 11. INSERT medical_record_version\n{ record_id, snapshot, version_number }
  activate db
  db --> verEntity : 12. return saved row
  deactivate db
  verEntity --> recSvc : 13. return MedicalRecordVersionEntity
  deactivate verEntity

  recSvc -> recEntity : 14. save(updatedRecord)
  activate recEntity
  recEntity -> db : 15. UPDATE medical_record SET changed fields
  activate db
  db --> recEntity : 16. return updated row
  deactivate db
  recEntity --> recSvc : 17. return MedicalRecordEntity
  deactivate recEntity

  recSvc --> ctrl : 18. return MedicalRecordEntity

  ctrl --> form : 19. 200 OK MedicalRecordEntity
  form --> user : 20. Display updated medical record
else record not found
  recSvc --> ctrl : 21. throw NotFoundException
  deactivate recSvc
  ctrl --> form : 22. 404 { message: Medical record not found }
  deactivate ctrl
  form --> user : 23. Show not found error
  deactivate form
end

deactivate user

@enduml
