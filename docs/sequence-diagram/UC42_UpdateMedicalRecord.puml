@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-042: Update Medical Record

actor "Doctor" as user
boundary "MedicalRecordDetailPanel" as form
participant ":MedicalRecordsController" as ctrl
participant ":MedicalRecordsService" as recSvc
database "PostgreSQL" as db

user -> form : 1. Edit medical record fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/medical-records/{record_id}\nUpdateMedicalRecordDto
activate ctrl

ctrl -> recSvc : 3. update(record_id, UpdateMedicalRecordDto)
activate recSvc

recSvc -> db : 4. SELECT medical_record WHERE record_id
activate db
db --> recSvc : 5. return MedicalRecordEntity / null
deactivate db

recSvc -> recSvc : 6. check record exists
activate recSvc
deactivate recSvc
alt record found
  recSvc -> db : 7. UPDATE medical_record SET changed fields
  activate db
  db --> recSvc : 8. return updated MedicalRecordEntity
  deactivate db

  recSvc --> ctrl : 9. return MedicalRecordEntity
  deactivate recSvc

  ctrl --> form : 10. 200 OK MedicalRecordEntity
  deactivate ctrl

  form --> user : 11. Display updated medical record
  deactivate form
else record not found
  recSvc --> ctrl : 12. throw NotFoundException
  deactivate recSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Medical record not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
