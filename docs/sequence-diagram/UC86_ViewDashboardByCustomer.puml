@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-086: View Dashboard by Customer

actor "Patient" as user
boundary "PatientDashboardView" as form
participant ":ReportsController" as ctrl
participant ":ReportsService" as rptSvc
database "PostgreSQL\n(appointments)" as aptDb
database "PostgreSQL\n(treatment_plans)" as planDb
database "PostgreSQL\n(examination_sessions)" as sessDb

user -> form : 1. Open Patient Dashboard
activate user
activate form

form -> ctrl : 2. GET /api/v1/reports/dashboard/patient\n?patient_id={patientId}
activate ctrl

ctrl -> rptSvc : 3. getPatientDashboard({ patient_id })
activate rptSvc

rptSvc -> aptDb : 4. SELECT appointments WHERE patient_id\nORDER BY date ASC, time ASC LIMIT 10\nwith clinic, service relations
activate aptDb
aptDb --> rptSvc : 5. return AppointmentEntity[]
deactivate aptDb

rptSvc -> planDb : 6. SELECT treatment_plans WHERE patient_id\nAND status = 'active'\nORDER BY created_at DESC LIMIT 5
activate planDb
planDb --> rptSvc : 7. return TreatmentPlanEntity[]
deactivate planDb

rptSvc -> sessDb : 8. SELECT examination_sessions WHERE patient_id\nORDER BY created_at DESC LIMIT 5
activate sessDb
sessDb --> rptSvc : 9. return ExaminationSessionEntity[]
deactivate sessDb

rptSvc -> rptSvc : 10. Filter appointments to upcoming\n(date >= today AND status IN [scheduled, confirmed])
activate rptSvc
deactivate rptSvc

rptSvc --> ctrl : 11. return { patient_id, upcoming_appointments,\nactive_treatment_plans, recent_sessions }
deactivate rptSvc

ctrl --> form : 12. 200 OK PatientDashboardResponse
deactivate ctrl

form --> user : 13. Display dashboard:\n- Upcoming appointments\n- Active treatment plans\n- Recent examination sessions
deactivate form

deactivate user

@enduml
