@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "SpecialtyListView" as page
participant ":SpecialtiesController" as ctrl
participant ":SpecialtiesService" as specSvc
entity "SpecialtyEntity" as specEntity
database "PostgreSQL" as db

user -> page : 1. Open specialties page
activate user
activate page

page -> ctrl : 2. GET /api/v1/specialties?active_only=true
activate ctrl

ctrl -> specSvc : 3. findAll(activeOnly)
activate specSvc

specSvc -> specEntity : 4. find(where, order)
activate specEntity
specEntity -> db : 5. SELECT * FROM specialties\nWHERE is_active = true\nORDER BY display_order ASC, created_at DESC
activate db
db --> specEntity : 6. return rows
deactivate db
specEntity --> specSvc : 7. return Specialty[]
deactivate specEntity

specSvc --> ctrl : 8. return Specialty[]
deactivate specSvc

ctrl --> page : 9. 200 OK Specialty[]
deactivate ctrl

page --> user : 10. Display specialty list\n(name, description, status)
deactivate page

deactivate user

@enduml
