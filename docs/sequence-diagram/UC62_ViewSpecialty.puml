@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "SpecialtyListView" as page
participant ":SpecialtiesController" as ctrl
participant ":SpecialtiesService" as specSvc
entity "SpecialtyEntity" as specEntity
database "PostgreSQL" as db

user -> page : 1. Open specialties page
activate user
activate page

page -> ctrl : 2. GET /api/v1/specialties?active_only=true
activate ctrl

ctrl -> specSvc : 3. findAll(activeOnly)
activate specSvc

specSvc -> specEntity : 4. find(where, order)
activate specEntity
specEntity -> db : 5. SELECT * FROM specialties\nWHERE is_active = true\nORDER BY display_order ASC, created_at DESC
activate db
db --> specEntity : 6. return rows
deactivate db
specEntity --> specSvc : 7. return Specialty[]
deactivate specEntity

specSvc --> ctrl : 8. return Specialty[]

ctrl --> page : 9. 200 OK Specialty[]

page --> user : 10. Display specialty list\n(name, description, status)

opt View specialty detail
  user -> page : 11. Select a specialty

  page -> ctrl : 12. GET /api/v1/specialties/{id}

  ctrl -> specSvc : 13. findById(id)

  specSvc -> specEntity : 14. findOne(specialty_id)
  activate specEntity
  specEntity -> db : 15. SELECT * FROM specialties WHERE specialty_id
  activate db
  db --> specEntity : 16. return row
  deactivate db
  specEntity --> specSvc : 17. return Specialty
  deactivate specEntity

  specSvc --> ctrl : 18. return Specialty
deactivate specSvc
  ctrl --> page : 19. 200 OK Specialty

deactivate ctrl
  page --> user : 20. Display specialty detail
  deactivate page
end



deactivate user

@enduml
