@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Receptionist" as user
boundary "AppointmentListPage" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as svc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. View pending appointments list
activate user
activate page

page -> ctrl : 2. GET /api/v1/appointments?status=scheduled
activate ctrl

ctrl -> svc : 3. findAll(QueryAppointmentDto)
activate svc

svc -> aptEntity : 4. findAndCount(where: {status: scheduled})
activate aptEntity
aptEntity -> db : 5. SELECT appointments WHERE status = scheduled
activate db
db --> aptEntity : 6. return rows and count
deactivate db
aptEntity --> svc : 7. return { data: Appointment[], total }
deactivate aptEntity

svc --> ctrl : 8. return { data, total }

ctrl --> page : 9. 200 OK { appointment list }

page --> user : 10. Display pending appointments

user -> page : 11. Select appointment and click Confirm

page -> ctrl : 12. PATCH /api/v1/appointments/:id/confirm\n{ changed_by: receptionistId }

ctrl -> ctrl : 13. validate changed_by is present
activate ctrl
deactivate ctrl
alt changed_by is provided
  ctrl -> svc : 14. confirm(id, changedBy)

  svc -> aptEntity : 15. findOne(appointment_id, relations)
  activate aptEntity
  aptEntity -> db : 16. SELECT * FROM appointments WHERE appointment_id
  activate db
  db --> aptEntity : 17. return row
  deactivate db
  aptEntity --> svc : 18. return Appointment
  deactivate aptEntity

  svc -> svc : 19. check appointment exists
  activate svc
  deactivate svc
  alt appointment exists
    svc -> aptEntity : 20. save(appointment with status = CONFIRMED)
    activate aptEntity
    aptEntity -> db : 21. UPDATE appointments SET status = CONFIRMED
    activate db
    db --> aptEntity : 22. return updated row
    deactivate db
    aptEntity --> svc : 23. return Appointment
    deactivate aptEntity

    svc -> histEntity : 24. save(old_status: SCHEDULED,\nnew_status: CONFIRMED, changed_by, reason)
    activate histEntity
    histEntity -> db : 25. INSERT INTO appointment_status_history
    activate db
    db --> histEntity : 26. return saved row
    deactivate db
    histEntity --> svc : 27. return AppointmentStatusHistory
    deactivate histEntity

    svc --> ctrl : 28. return Appointment

    ctrl --> page : 29. 200 OK { confirmed Appointment }

    page --> user : 30. Display confirmation success
  else appointment not found
    svc --> ctrl : 31. throw NotFoundException
    deactivate svc
    ctrl --> page : 32. 404 Not Found

    page --> user : 33. Show error message
  end
else changed_by is missing
  
  ctrl --> page : 34. 400 Bad Request
  deactivate ctrl

  page --> user : 35. Show validation error
  deactivate page
end

deactivate user

@enduml
