@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-055: Confirm Appointment

actor "Receptionist" as user
boundary "AppointmentListPage" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as svc
database "PostgreSQL" as db
participant ":AppointmentNotificationPublisher" as notifPub

user -> page : 1. View pending appointments list
activate user
activate page

page -> ctrl : 2. GET /api/v1/appointments?status=scheduled
activate ctrl

ctrl -> svc : 3. findAll(QueryAppointmentDto)
activate svc

svc -> db : 4. findAndCount(where: {status: scheduled})
activate db
db --> svc : 5. return [AppointmentEntity[], total]
deactivate db

svc --> ctrl : 6. return {data: AppointmentEntity[], total}
deactivate svc

ctrl --> page : 7. 200 OK — appointment list
deactivate ctrl

page --> user : 8. Display pending appointments
deactivate page

user -> page : 9. Select appointment and click Confirm
activate page

page -> ctrl : 10. PATCH /api/v1/appointments/:id/confirm\n{changed_by: receptionistId}
activate ctrl

ctrl -> ctrl : 11. validate changed_by is present
activate ctrl
deactivate ctrl
alt changed_by is provided
  ctrl -> svc : 12. confirm(id, changedBy)
  activate svc

  svc -> svc : 13. changeStatus(id, {status: CONFIRMED, changed_by, reason})
  activate svc
  deactivate svc

  svc -> db : 14. findOne(appointment_id)
  activate db
  db --> svc : 15. return AppointmentEntity / null
  deactivate db

  svc -> svc : 16. check appointment exists
  activate svc
  deactivate svc
  alt appointment exists
    svc -> db : 17. save(appointment with status = CONFIRMED)
    activate db
    db --> svc : 18. return AppointmentEntity
    deactivate db

    svc -> db : 19. save(AppointmentStatusHistoryEntity)
    activate db
    db --> svc : 20. return AppointmentStatusHistoryEntity
    deactivate db

    svc --> ctrl : 21. return AppointmentEntity

    ctrl -> svc : 22. sendConfirmation(id)

    svc -> db : 23. findOne(appointment_id)
    activate db
    db --> svc : 24. return AppointmentEntity
    deactivate db

    svc -> notifPub : 25. sendAppointmentConfirmation(payload)
    activate notifPub
    notifPub --> svc : 26. return AppointmentNotificationPayload
    deactivate notifPub

    svc --> ctrl : 27. return AppointmentNotificationPayload
    deactivate svc

    ctrl --> page : 28. 200 OK — confirmed appointment
    deactivate ctrl

    page --> user : 29. Display confirmation success
    deactivate page
  else appointment not found
    svc --> ctrl : 30. throw NotFoundException
    deactivate svc
    ctrl --> page : 31. 404 Not Found
    deactivate ctrl
    page --> user : 32. Show error message
  end
else changed_by is missing
  ctrl --> page : 33. 400 Bad Request
  deactivate ctrl
  activate page
  page --> user : 34. Show validation error
  deactivate page
end

deactivate user

@enduml
