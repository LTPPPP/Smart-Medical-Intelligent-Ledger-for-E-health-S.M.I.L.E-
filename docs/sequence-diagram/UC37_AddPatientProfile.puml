@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Receptionist" as user
boundary "PatientRegistrationForm" as form
participant ":PatientsController" as ctrl
participant ":PatientsService" as svc
entity "PatientEntity" as patEntity
database "PostgreSQL" as db

user -> form : 1. Fill patient registration form\n(patient_code, full_name, phone, email, ...)
activate user
activate form

form -> form : 2. Validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/patients (CreatePatientDto)
  activate ctrl

  ctrl -> svc : 4. create(CreatePatientDto)
  activate svc

  svc -> patEntity : 5. findByPhone(phone)
  activate patEntity
  patEntity -> db : 6. SELECT patient WHERE phone
  activate db
  db --> patEntity : 7. return result
  deactivate db
  patEntity --> svc : 8. return PatientEntity
  deactivate patEntity

  svc -> patEntity : 9. findByEmail(email)
  activate patEntity
  patEntity -> db : 10. SELECT patient WHERE email
  activate db
  db --> patEntity : 11. return result
  deactivate db
  patEntity --> svc : 12. return PatientEntity
  deactivate patEntity

  svc -> svc : 13. Check for duplicate phone or email
  activate svc
  deactivate svc
  alt no duplicates
    svc -> patEntity : 14. save(patient)
    activate patEntity
    patEntity -> db : 15. INSERT INTO patients
    activate db
    db --> patEntity : 16. return saved row
    deactivate db
    patEntity --> svc : 17. return PatientEntity
    deactivate patEntity

    svc --> ctrl : 18. return PatientEntity

    ctrl --> form : 19. 201 Created PatientEntity

    form --> user : 20. Display registration success
  else duplicate phone or email exists
    svc --> ctrl : 21. throw ConflictException
    deactivate svc

    ctrl --> form : 22. 409 Conflict
    deactivate ctrl

    form --> user : 23. Show duplicate error message
  end
else validation fails
  form --> user : 24. Show validation errors
  deactivate form
end

deactivate user

@enduml
