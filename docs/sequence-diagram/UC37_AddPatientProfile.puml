@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Receptionist" as user
boundary "PatientRegistrationForm" as form
participant ":PatientsController" as ctrl
participant ":PatientsService" as svc
entity "PatientEntity" as patEntity
database "PostgreSQL" as db

user -> form : 1. Fill patient registration form\n(patient_code, full_name, phone, email, ...)
activate user
activate form

user -> form : 2. Click "Add Patient"

form -> form : 3. validate: patient_code and full_name are not empty,\ndate_of_birth is an ISO date if provided,\nemail matches email format if provided,\nallergies and chronic_diseases are arrays if provided
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/patients (CreatePatientDto)
  activate ctrl

  ctrl -> svc : 5. create(CreatePatientDto)
  activate svc

  svc -> patEntity : 6. findByPhone(phone)
  activate patEntity
  patEntity -> db : 7. SELECT patient WHERE phone
  activate db
  db --> patEntity : 8. return result
  deactivate db
  patEntity --> svc : 9. return PatientEntity
  deactivate patEntity

  svc -> patEntity : 10. findByEmail(email)
  activate patEntity
  patEntity -> db : 11. SELECT patient WHERE email
  activate db
  db --> patEntity : 12. return result
  deactivate db
  patEntity --> svc : 13. return PatientEntity
  deactivate patEntity

  svc -> svc : 14. Check for duplicate phone or email
  activate svc
  deactivate svc
  alt no duplicates
    svc -> patEntity : 15. save(patient)
    activate patEntity
    patEntity -> db : 16. INSERT INTO patients
    activate db
    db --> patEntity : 17. return saved row
    deactivate db
    patEntity --> svc : 18. return PatientEntity
    deactivate patEntity

    svc --> ctrl : 19. return PatientEntity

    ctrl --> form : 20. 201 Created PatientEntity

    form --> user : 21. Display registration success
  else duplicate phone or email exists
    svc --> ctrl : 22. throw ConflictException
    deactivate svc

    ctrl --> form : 23. 409 Conflict
    deactivate ctrl

    form --> user : 24. Show duplicate error message
  end
else validation fails
  form --> user : 25. Show validation errors
  deactivate form
end

deactivate user

@enduml
