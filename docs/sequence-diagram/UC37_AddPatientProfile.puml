@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-037: Add Patient Profile

actor "Receptionist" as user
boundary "PatientRegistrationForm" as form
participant ":PatientsController" as ctrl
participant ":PatientsService" as svc
database "PostgreSQL" as db

user -> form : 1. Fill patient registration form\n(patient_code, full_name, phone, email, ...)
activate user
activate form

form -> form : 2. Validate input fields
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/patients (CreatePatientDto)
  activate ctrl

  ctrl -> svc : 4. create(CreatePatientDto)
  activate svc

  svc -> db : 5. findOne(where: {phone})
  activate db
  db --> svc : 6. return PatientEntity / null
  deactivate db

  svc -> db : 7. findOne(where: {email})
  activate db
  db --> svc : 8. return PatientEntity / null
  deactivate db

  svc -> svc : 9. Check for duplicate phone or email
  activate svc
  deactivate svc
  alt no duplicates
    svc -> db : 10. create(PatientEntity)
    activate db
    db --> svc : 11. return PatientEntity
    deactivate db

    svc -> db : 12. save(PatientEntity)
    activate db
    db --> svc : 13. return PatientEntity
    deactivate db

    svc --> ctrl : 14. return PatientEntity
    deactivate svc

    ctrl --> form : 15. 201 Created — PatientEntity
    deactivate ctrl

    form --> user : 16. Display registration success
    deactivate form
  else duplicate phone or email exists
    svc --> ctrl : 17. throw ConflictException
    deactivate svc
    activate ctrl
    ctrl --> form : 18. 409 Conflict
    deactivate ctrl
    activate form
    form --> user : 19. Show duplicate error message
  end
else validation fails
  form --> user : 20. Show validation errors
  deactivate form
end

deactivate user

@enduml
