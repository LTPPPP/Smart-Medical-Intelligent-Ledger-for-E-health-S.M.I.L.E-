@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentPlanDetailPanel" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as planSvc
participant ":NotificationsService" as notifSvc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Click "Send Plan to Patient"
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/treatment-plans/{plan_id}\n{ status: SENT }
activate ctrl

ctrl -> planSvc : 3. update(plan_id, { status: SENT })
activate planSvc

planSvc -> planEntity : 4. findOne(plan_id)
activate planEntity
planEntity -> db : 5. SELECT treatment_plan WHERE plan_id
activate db
db --> planEntity : 6. return result
deactivate db
planEntity --> planSvc : 7. return TreatmentPlanEntity
deactivate planEntity

planSvc -> planEntity : 8. save(status: SENT)
activate planEntity
planEntity -> db : 9. UPDATE treatment_plan SET status = SENT
activate db
db --> planEntity : 10. return updated row
deactivate db
planEntity --> planSvc : 11. return TreatmentPlanEntity
deactivate planEntity

planSvc --> ctrl : 12. return TreatmentPlanEntity
deactivate planSvc

ctrl -> notifSvc : 13. sendTreatmentPlanNotification\n({ patientId, planId })
activate notifSvc
notifSvc --> ctrl : 14. return acknowledged
deactivate notifSvc

ctrl --> form : 15. 200 OK TreatmentPlanEntity
deactivate ctrl

form --> user : 16. Display plan sent confirmation
deactivate form

deactivate user

@enduml
