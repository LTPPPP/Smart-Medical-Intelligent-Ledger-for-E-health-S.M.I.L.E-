@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "SpecialtyDetailPanel" as page
participant ":SpecialtiesController" as ctrl
participant ":SpecialtiesService" as specSvc
entity "SpecialtyEntity" as specEntity
database "PostgreSQL" as db

user -> page : 1. Edit specialty fields
activate user
activate page

user -> page : 2. Click "Save Changes"
page -> ctrl : 3. PATCH /api/v1/specialties/{id}\nUpdateSpecialtyDto
activate ctrl

ctrl -> specSvc : 4. update(id, UpdateSpecialtyDto)
activate specSvc

specSvc -> specEntity : 5. findOne(specialty_id)
activate specEntity
specEntity -> db : 6. SELECT * FROM specialties WHERE specialty_id
activate db
db --> specEntity : 7. return row
deactivate db
specEntity --> specSvc : 8. return Specialty
deactivate specEntity

specSvc -> specSvc : 9. check specialty exists
activate specSvc
deactivate specSvc
alt specialty found
  specSvc -> specEntity : 10. save(updated specialty)
  activate specEntity
  specEntity -> db : 11. UPDATE specialties SET changed fields
  activate db
  db --> specEntity : 12. return updated row
  deactivate db
  specEntity --> specSvc : 13. return Specialty
  deactivate specEntity

  specSvc --> ctrl : 14. return Specialty

  ctrl --> page : 15. 200 OK { Specialty }

  page --> user : 16. Display updated specialty
else specialty not found
  specSvc --> ctrl : 17. throw NotFoundException
  deactivate specSvc
  ctrl --> page : 18. 404 { Specialty not found }

deactivate ctrl
  page --> user : 19. Show not found error

deactivate page
end


deactivate user

@enduml
