@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "PatientMedicalHistoryPanel" as form
participant ":MedicalHistoryController" as ctrl
participant ":MedicalHistoryService" as histSvc
entity "MedicalHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> form : 1. Fill medical history entry\n(condition, description, onset date, status)
activate user
activate form

user -> form : 2. Click "Add History"

form -> ctrl : 3. POST /api/v1/patients/{patient_id}/history\nCreateMedicalHistoryDto
activate ctrl

ctrl -> histSvc : 4. create(CreateMedicalHistoryDto)
activate histSvc

histSvc -> histEntity : 5. save(medicalHistory)
activate histEntity
histEntity -> db : 6. INSERT medical_history\n{ patient_id, condition, description, onset_date, status }
activate db
db --> histEntity : 7. return saved row
deactivate db
histEntity --> histSvc : 8. return MedicalHistoryEntity
deactivate histEntity

histSvc --> ctrl : 9. return MedicalHistoryEntity
deactivate histSvc

ctrl --> form : 10. 201 Created MedicalHistoryEntity
deactivate ctrl

form --> user : 11. Display added medical history entry
deactivate form

deactivate user

@enduml
