@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-040: Add Medical History

actor "Doctor" as user
boundary "PatientMedicalHistoryPanel" as form
participant ":MedicalHistoryController" as ctrl
participant ":MedicalHistoryService" as histSvc
database "PostgreSQL" as db

user -> form : 1. Fill medical history entry\n(condition, description, onset date, status) and submit
activate user
activate form

form -> ctrl : 2. POST /api/v1/patients/{patient_id}/history\nCreateMedicalHistoryDto
activate ctrl

ctrl -> histSvc : 3. create(CreateMedicalHistoryDto)
activate histSvc

histSvc -> db : 4. INSERT medical_history\n{ patient_id, condition, description, onset_date, status }
activate db
db --> histSvc : MedicalHistoryEntity
deactivate db

histSvc --> ctrl : MedicalHistoryEntity
deactivate histSvc

ctrl --> form : 5. 201 Created MedicalHistoryEntity
deactivate ctrl

form --> user : 6. Display added medical history entry
deactivate form

deactivate user

@enduml
