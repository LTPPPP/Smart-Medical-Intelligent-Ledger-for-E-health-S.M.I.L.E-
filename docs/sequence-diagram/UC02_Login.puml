@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "User" as user
boundary "LoginForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":RefreshTokensService" as refSvc
participant ":UserProfilesService" as profSvc
participant ":AuditLogsService" as auditSvc
entity "AccountEntity" as accEntity
entity "RefreshTokenEntity" as refEntity
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db
participant "JwtService" as jwt

user -> form : 1. Enter email and password
activate user
activate form

user -> form : 2. Click "Sign In"

form -> form : 3. validate: emailOrPhone is not empty,\npassword is not empty
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/auth/email/login
  activate ctrl

  ctrl -> authSvc : 5. validateLogin(AuthEmailLoginDto)
  activate authSvc

  authSvc -> accSvc : 6. findByEmail(email)
  activate accSvc

  accSvc -> accEntity : 7. findByEmail(email)
  activate accEntity
  accEntity -> db : 8. SELECT account WHERE email
  activate db
  db --> accEntity : 9. return result
  deactivate db
  accEntity --> accSvc : 10. return Account
  deactivate accEntity

  accSvc --> authSvc : 11. return Account

  authSvc -> authSvc : 12. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> authSvc : 13. check account.status
    activate authSvc
    deactivate authSvc
    alt account is ACTIVE
      authSvc -> authSvc : 14. compare password hash
      activate authSvc
      deactivate authSvc
      alt password matches
        authSvc -> accSvc : 15. updateLastLogin(accountId)

        accSvc -> accEntity : 16. update(accountId, lastLoginAt, failedLoginAttempts)
        activate accEntity
        accEntity -> db : 17. UPDATE lastLoginAt, failedLoginAttempts = 0
        activate db
        db --> accEntity : 18. return updated row
        deactivate db
        accEntity --> accSvc : 19. return Account
        deactivate accEntity

        accSvc --> authSvc : 20. return Account

        authSvc -> jwt : 21. signAsync(accessTokenPayload)
        activate jwt
        jwt --> authSvc : 22. return accessToken
        deactivate jwt

        authSvc -> refSvc : 23. create(accountId, tokenHash, expiresAt)
        activate refSvc

        refSvc -> refEntity : 24. save(accountId, tokenHash, expiresAt)
        activate refEntity
        refEntity -> db : 25. INSERT RefreshToken
        activate db
        db --> refEntity : 26. return RefreshToken
        deactivate db
        refEntity --> refSvc : 27. return RefreshToken
        deactivate refEntity

        refSvc --> authSvc : 28. return RefreshToken
        deactivate refSvc

        authSvc -> jwt : 29. signAsync(refreshTokenPayload)
        activate jwt
        jwt --> authSvc : 30. return refreshToken
        deactivate jwt

        authSvc -> profSvc : 31. findById(accountId)
        activate profSvc

        profSvc -> profEntity : 32. findOne(accountId)
        activate profEntity
        profEntity -> db : 33. SELECT UserProfile WHERE user_id
        activate db
        db --> profEntity : 34. return result
        deactivate db
        profEntity --> profSvc : 35. return UserProfile
        deactivate profEntity

        profSvc --> authSvc : 36. return UserProfile
        deactivate profSvc

        authSvc --> ctrl : 37. return LoginResponseDto

        ctrl -> auditSvc : 38. create(LOGIN audit log)
        activate auditSvc
        auditSvc --> ctrl : 39. return AuditLogEntity
        deactivate auditSvc

        ctrl --> form : 40. 200 OK { token, refreshToken, user, userProfile }

        form --> user : 41. Navigate to dashboard

      else password does not match
        authSvc -> accSvc : 42. updateFailedLoginAttempts(accountId)

        accSvc -> accEntity : 43. update(accountId, failedLoginAttempts)
        activate accEntity
        accEntity -> db : 44. UPDATE failedLoginAttempts
        activate db
        db --> accEntity : 45. return updated row
        deactivate db
        accEntity --> accSvc : 46. return Account
        deactivate accEntity

        accSvc --> authSvc : 47. return Account

        authSvc -> authSvc : 48. check failedAttempts >= 5
        activate authSvc
        deactivate authSvc
        opt attempts >= 5
          authSvc -> accSvc : 49. lockAccount(accountId, reason)

          accSvc -> accEntity : 50. update(accountId, status: LOCKED)
          activate accEntity
          accEntity -> db : 51. UPDATE status = LOCKED
          activate db
          db --> accEntity : 52. return updated row
          deactivate db
          accEntity --> accSvc : 53. return Account
          deactivate accEntity

          accSvc --> authSvc : 54. return Account
        end
        deactivate accSvc
        authSvc --> ctrl : 55. throw UnprocessableEntityException
        deactivate authSvc
        ctrl --> form : 56. 422 incorrectPassword
        deactivate ctrl
        form --> user : 57. Show error message
      end

    else account is LOCKED or SUSPENDED
      deactivate accSvc
      authSvc --> ctrl : 58. throw UnprocessableEntityException
      deactivate authSvc
      ctrl --> form : 59. 422 accountIsLOCKED
      deactivate ctrl
      form --> user : 60. Show account locked message
    end

  else account not found
    deactivate accSvc
    authSvc --> ctrl : 61. throw UnprocessableEntityException
    deactivate authSvc
    ctrl --> form : 62. 422 email notFound
    deactivate ctrl
    form --> user : 63. Show email not found message
  end

else validation fails
  form --> user : 64. Show validation errors
  deactivate form
end

deactivate user

@enduml
