@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-002: Login

actor "User" as user
boundary "LoginForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
database "PostgreSQL" as db
participant "JwtService" as jwt
participant ":RefreshTokensService" as refSvc
participant ":UserProfilesService" as profSvc
participant ":AuditLogsService" as auditSvc

user -> form : 1. Enter email and password
activate user
activate form

form -> form : 2. validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/email/login
  activate ctrl

  ctrl -> authSvc : 4. validateLogin(AuthEmailLoginDto)
  activate authSvc

  authSvc -> accSvc : 5. findByEmail(email)
  activate accSvc
  accSvc -> db : 6. SELECT account WHERE email
  activate db
  db --> accSvc : 7. return Account / null
  deactivate db
  accSvc --> authSvc : 8. return Account / null
  deactivate accSvc

  authSvc -> authSvc : 9. check account exists
  activate authSvc
  deactivate authSvc
  alt account found
    authSvc -> authSvc : 10. check account.status
    activate authSvc
    deactivate authSvc
    alt account is ACTIVE
      authSvc -> authSvc : 11. compare password hash
      activate authSvc
      deactivate authSvc
      alt password matches
        authSvc -> accSvc : 12. updateLastLogin(accountId)
        activate accSvc
        accSvc -> db : 13. UPDATE lastLoginAt, failedLoginAttempts = 0
        activate db
        db --> accSvc : 14. return Account
        deactivate db
        accSvc --> authSvc : 15. return Account
        deactivate accSvc

        authSvc -> jwt : 16. signAsync(accessTokenPayload)
        activate jwt
        jwt --> authSvc : 17. return accessToken
        deactivate jwt

        authSvc -> refSvc : 18. create(accountId, tokenHash, expiresAt)
        activate refSvc
        refSvc -> db : 19. INSERT RefreshToken
        activate db
        db --> refSvc : 20. return RefreshToken
        deactivate db
        refSvc --> authSvc : 21. return RefreshToken
        deactivate refSvc

        authSvc -> jwt : 22. signAsync(refreshTokenPayload)
        activate jwt
        jwt --> authSvc : 23. return refreshToken
        deactivate jwt

        authSvc -> profSvc : 24. findById(accountId)
        activate profSvc
        profSvc -> db : 25. SELECT UserProfile WHERE user_id
        activate db
        db --> profSvc : 26. return UserProfile / null
        deactivate db
        profSvc --> authSvc : 27. return UserProfile / null
        deactivate profSvc

        authSvc --> ctrl : 28. return LoginResponseDto

        ctrl -> auditSvc : 29. create(LOGIN audit log)
        activate auditSvc
        auditSvc --> ctrl : 30. return AuditLogEntity
        deactivate auditSvc

        ctrl --> form : 31. 200 OK { token, refreshToken, user, userProfile }
        deactivate ctrl
        form --> user : 32. Navigate to dashboard
        deactivate form

      else password does not match
        authSvc -> accSvc : 33. updateFailedLoginAttempts(accountId)
        activate accSvc
        accSvc -> db : 34. UPDATE failedLoginAttempts
        activate db
        db --> accSvc : 35. return Account
        deactivate db
        accSvc --> authSvc : 36. return Account
        deactivate accSvc

        authSvc -> authSvc : 37. check failedAttempts >= 5
        activate authSvc
        deactivate authSvc
        opt attempts >= 5
          authSvc -> accSvc : 38. lockAccount(accountId, reason)
          activate accSvc
          accSvc -> db : 39. UPDATE status = LOCKED
          activate db
          db --> accSvc : 40. return Account
          deactivate db
          accSvc --> authSvc : 41. return Account
          deactivate accSvc
        end

        authSvc --> ctrl : 42. throw UnprocessableEntityException
        deactivate authSvc
        activate ctrl
        ctrl --> form : 43. 422 incorrectPassword
        deactivate ctrl
        activate form
        form --> user : 44. Show error message
        deactivate form
      end

    else account is LOCKED or SUSPENDED
      authSvc --> ctrl : 45. throw UnprocessableEntityException
      deactivate authSvc
      activate ctrl
      ctrl --> form : 46. 422 accountIsLOCKED
      deactivate ctrl
      activate form
      form --> user : 47. Show account locked message
      deactivate form
    end

  else account not found
    authSvc --> ctrl : 48. throw UnprocessableEntityException
    deactivate authSvc
    activate ctrl
    ctrl --> form : 49. 422 email notFound
    deactivate ctrl
    activate form
    form --> user : 50. Show email not found message
  end

else validation fails
  form --> user : 51. Show validation errors
  deactivate form
end

deactivate user

@enduml
