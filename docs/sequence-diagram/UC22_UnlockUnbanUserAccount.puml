@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "AccountDetailPanel" as form
participant ":AccountsController" as ctrl
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

user -> form : 1. Click "Unlock Account"
activate user
activate form

form -> ctrl : 2. POST /api/v1/accounts/{id}/unlock
activate ctrl

ctrl -> accSvc : 3. unlockAccount(id)
activate accSvc

accSvc -> accEntity : 4. findOne(id)
activate accEntity
accEntity -> db : 5. SELECT account WHERE id
activate db
db --> accEntity : 6. return result
deactivate db
accEntity --> accSvc : 7. return Account
deactivate accEntity

accSvc -> accSvc : 8. check account exists
activate accSvc
deactivate accSvc
alt account found
  accSvc -> accEntity : 9. save(id, status: ACTIVE, lockedAt: null,\nlockedReason: null, failedLoginAttempts: 0)
  activate accEntity
  accEntity -> db : 10. UPDATE account SET\nstatus = ACTIVE, lockedAt = null,\nlockedReason = null, failedLoginAttempts = 0
  activate db
  db --> accEntity : 11. return updated row
  deactivate db
  accEntity --> accSvc : 12. return Account
  deactivate accEntity

  accSvc --> ctrl : 13. return success
  deactivate accSvc

  ctrl --> form : 14. 200 OK { message: Account unlocked successfully }
  deactivate ctrl

  form --> user : 15. Display unlock confirmation
else account not found
  accSvc --> ctrl : 16. throw NotFoundException
  deactivate accSvc

  ctrl --> form : 17. 404 { message: Account not found }
  deactivate ctrl

  form --> user : 18. Display error message
end

deactivate user

@enduml
