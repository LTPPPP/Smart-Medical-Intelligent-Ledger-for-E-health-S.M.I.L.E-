@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-035: Notify Schedule Change

actor "Admin" as user
boundary "ScheduleManagementPanel" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
participant ":NotificationService" as notifSvc
database "PostgreSQL" as db

user -> form : 1. Update schedule and confirm notification
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/doctor-schedules/{id}\n{ changed fields, changed_by, change_reason }
activate ctrl

ctrl -> schSvc : 3. update(id, UpdateDoctorScheduleDto)
activate schSvc

schSvc -> db : 4. SELECT schedule WHERE schedule_id
activate db
db --> schSvc : 5. return DoctorScheduleEntity
deactivate db

schSvc -> schSvc : 6. Capture old values
activate schSvc
deactivate schSvc

schSvc -> db : 7. UPDATE doctor_schedule SET changed fields
activate db
db --> schSvc : 8. return updated DoctorScheduleEntity
deactivate db

schSvc -> db : 9. INSERT schedule_change\n{ change_type: RESCHEDULING, old_values, new_values }
activate db
db --> schSvc : 10. return ScheduleChangeEntity
deactivate db

schSvc -> notifSvc : 11. sendScheduleChangeNotification\n({ doctorId, scheduleId, changeType, oldValues, newValues })
activate notifSvc
notifSvc --> schSvc : 12. return acknowledged
deactivate notifSvc

schSvc --> ctrl : 13. return DoctorScheduleEntity
deactivate schSvc

ctrl --> form : 14. 200 OK DoctorScheduleEntity
deactivate ctrl

form --> user : 15. Display update confirmation\n(notification sent to doctor)
deactivate form

deactivate user

@enduml
