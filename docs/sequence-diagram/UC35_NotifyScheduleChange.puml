@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "ScheduleManagementPanel" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
participant ":NotificationsService" as notifSvc
entity "DoctorScheduleEntity" as schEntity
entity "ScheduleChangeEntity" as changeEntity
database "PostgreSQL" as db

user -> form : 1. Update schedule fields
activate user
activate form

user -> form : 2. Click "Save & Notify"

form -> ctrl : 3. PATCH /api/v1/doctor-schedules/{id}\n{ changed fields, changed_by, change_reason }
activate ctrl

ctrl -> schSvc : 4. update(id, UpdateDoctorScheduleDto)
activate schSvc

schSvc -> schEntity : 5. findOne(id)
activate schEntity
schEntity -> db : 6. SELECT schedule WHERE schedule_id
activate db
db --> schEntity : 7. return result
deactivate db
schEntity --> schSvc : 8. return DoctorScheduleEntity
deactivate schEntity

schSvc -> schSvc : 9. Capture old values
activate schSvc
deactivate schSvc

schSvc -> schEntity : 10. save(updatedSchedule)
activate schEntity
schEntity -> db : 11. UPDATE doctor_schedule SET changed fields
activate db
db --> schEntity : 12. return updated row
deactivate db
schEntity --> schSvc : 13. return DoctorScheduleEntity
deactivate schEntity

schSvc -> changeEntity : 14. save(scheduleChange)
activate changeEntity
changeEntity -> db : 15. INSERT schedule_change\n{ change_type: RESCHEDULING, old_values, new_values }
activate db
db --> changeEntity : 16. return saved row
deactivate db
changeEntity --> schSvc : 17. return ScheduleChangeEntity
deactivate changeEntity

schSvc -> notifSvc : 18. sendScheduleChangeNotification\n({ doctorId, scheduleId, changeType, oldValues, newValues })
activate notifSvc
notifSvc --> schSvc : 19. return acknowledged
deactivate notifSvc

schSvc --> ctrl : 20. return DoctorScheduleEntity
deactivate schSvc

ctrl --> form : 21. 200 OK DoctorScheduleEntity
deactivate ctrl

form --> user : 22. Display update confirmation\n(notification sent to doctor)
deactivate form

deactivate user

@enduml
