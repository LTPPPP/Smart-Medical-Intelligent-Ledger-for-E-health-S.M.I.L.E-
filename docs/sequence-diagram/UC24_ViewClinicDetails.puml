@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "ClinicDetailPanel" as form
participant ":ClinicsController" as ctrl
participant ":ClinicsService" as clinicSvc
entity "ClinicEntity" as clinicEntity
database "PostgreSQL" as db

user -> form : 1. Select a clinic to view details
activate user
activate form

form -> ctrl : 2. GET /api/v1/clinics/{id}
activate ctrl

ctrl -> clinicSvc : 3. findById(id)
activate clinicSvc

clinicSvc -> clinicEntity : 4. findOne(id)
activate clinicEntity
clinicEntity -> db : 5. SELECT clinic WHERE clinic_id\nwith treatment_rooms relation
activate db
db --> clinicEntity : 6. return result
deactivate db
clinicEntity --> clinicSvc : 7. return ClinicEntity
deactivate clinicEntity

clinicSvc -> clinicSvc : 8. check clinic exists
activate clinicSvc
deactivate clinicSvc
alt clinic found
  clinicSvc --> ctrl : 9. return ClinicEntity

  ctrl --> form : 10. 200 OK ClinicEntity

  form --> user : 11. Display clinic detail\n(name, address, phone, license,\ntreatment rooms, services)
else clinic not found
  clinicSvc --> ctrl : 12. throw NotFoundException
  deactivate clinicSvc
  ctrl --> form : 13. 404 { message: Clinic not found }
  deactivate ctrl
  form --> user : 14. Display error message
  deactivate form
end

deactivate user

@enduml
