@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-069: Delete Symptoms

actor "Doctor" as user
boundary "SymptomDetailPanel" as form
participant ":SymptomsController" as ctrl
participant ":SymptomsService" as symSvc
database "PostgreSQL" as db

user -> form : 1. Click "Delete Symptom" and confirm
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/symptoms/{symptom_id}
activate ctrl

ctrl -> symSvc : 3. remove(symptom_id)
activate symSvc

symSvc -> db : 4. SELECT symptom WHERE symptom_id
activate db
db --> symSvc : 5. return SymptomEntity / null
deactivate db

symSvc -> symSvc : 6. check exists
activate symSvc
deactivate symSvc
alt found
  symSvc -> db : 7. DELETE FROM symptoms WHERE symptom_id
  activate db
  db --> symSvc : 8. return deleted (affectedRows: 1)
  deactivate db

  symSvc --> ctrl : 9. return success
  deactivate symSvc

  ctrl --> form : 10. 204 No Content
  deactivate ctrl

  form --> user : 11. Display deletion confirmation
  deactivate form
else not found
  symSvc --> ctrl : 12. throw NotFoundException
  deactivate symSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Symptom not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
