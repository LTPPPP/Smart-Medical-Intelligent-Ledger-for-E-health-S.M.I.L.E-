@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-031: Update Work Schedule / On-Call Schedule

actor "Admin" as user
boundary "ScheduleDetailPanel" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
database "PostgreSQL" as db

user -> form : 1. Edit schedule fields (shift, room,\nmax patients, status, notes) and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/doctor-schedules/{id}\n{ shift_id?, room_id?, max_patients?, status?, notes?, changed_by, change_reason }
activate ctrl

ctrl -> schSvc : 3. update(id, UpdateDoctorScheduleDto)
activate schSvc

schSvc -> db : 4. SELECT schedule WHERE schedule_id with relations
activate db
db --> schSvc : DoctorScheduleEntity / null
deactivate db

schSvc -> schSvc : 5. check schedule exists
activate schSvc
deactivate schSvc
alt schedule found
  schSvc -> schSvc : 6. Capture old values\n(shift_id, room_id, max_patients, status, notes)
  activate schSvc
  deactivate schSvc

  schSvc -> db : 7. UPDATE doctor_schedule SET changed fields
  activate db
  db --> schSvc : DoctorScheduleEntity
  deactivate db

  schSvc -> schSvc : 8. Capture new values for audit
  activate schSvc
  deactivate schSvc

  schSvc -> db : 9. INSERT schedule_change\n{ schedule_id, changed_by, change_type: RESCHEDULING,\nold_values, new_values, reason }
  activate db
  db --> schSvc : ScheduleChangeEntity
  deactivate db

  schSvc --> ctrl : DoctorScheduleEntity
  deactivate schSvc

  ctrl --> form : 10. 200 OK DoctorScheduleEntity
  deactivate ctrl

  form --> user : 11. Display updated schedule
  deactivate form
else schedule not found
  schSvc --> ctrl : 12. throw NotFoundException
  deactivate schSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Schedule not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
