@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-016: Assign Role

actor "Admin" as user
boundary "UserRolesPanel" as form
participant ":UserRolesController" as ctrl
participant ":UserRolesService" as urSvc
database "PostgreSQL" as db

user -> form : 1. Select user and role to assign
activate user
activate form

form -> ctrl : 2. POST /api/v1/user-roles/user/{userId}\n{ role_id }
activate ctrl

ctrl -> urSvc : 3. assignRole(userId, roleId)
activate urSvc

urSvc -> db : 4. SELECT user_role WHERE user_id AND role_id
activate db
db --> urSvc : 5. return UserRoleEntity / null
deactivate db

urSvc -> urSvc : 6. check role already assigned
activate urSvc
deactivate urSvc
alt role not yet assigned to user
  urSvc -> db : 7. INSERT INTO user_roles
  activate db
  db --> urSvc : 8. return UserRoleEntity
  deactivate db

  urSvc --> ctrl : 9. return UserRoleEntity
  deactivate urSvc

  ctrl --> form : 10. 201 Created UserRoleEntity
  deactivate ctrl

  form --> user : 11. Display role assigned to user confirmation
  deactivate form
else role already assigned to user
  urSvc --> ctrl : 12. throw ConflictException
  deactivate urSvc
  activate ctrl
  ctrl --> form : 13. 409 { message: Role already assigned to this user }
  deactivate ctrl
  activate form
  form --> user : 14. Display conflict error
  deactivate form
end

deactivate user

@enduml
