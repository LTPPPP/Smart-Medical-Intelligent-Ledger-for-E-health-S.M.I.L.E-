@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "UserRolesPanel" as form
participant ":UserRolesController" as ctrl
participant ":UserRolesService" as urSvc
entity "UserRoleEntity" as urEntity
entity "RoleEntity" as roleEntity
database "PostgreSQL" as db

user -> form : 1. Select user and role to assign
activate user
activate form

form -> ctrl : 2. POST /api/v1/user-roles/user/{userId}\n{ role_id }
activate ctrl

ctrl -> urSvc : 3. assignRole(userId, roleId)
activate urSvc

urSvc -> urEntity : 4. findOne(userId, roleId)
activate urEntity
urEntity -> db : 5. SELECT user_role WHERE user_id AND role_id
activate db
db --> urEntity : 6. return result
deactivate db
urEntity --> urSvc : 7. return UserRole
deactivate urEntity

urSvc -> urSvc : 8. check role already assigned
activate urSvc
deactivate urSvc
alt role not yet assigned to user
  urSvc -> roleEntity : 9. findOne(roleId)
  activate roleEntity
  roleEntity -> db : 10. SELECT role WHERE role_id
  activate db
  db --> roleEntity : 11. return result
  deactivate db
  roleEntity --> urSvc : 12. return Role
  deactivate roleEntity

  urSvc -> urEntity : 13. save(userId, roleId)
  activate urEntity
  urEntity -> db : 14. INSERT INTO user_roles
  activate db
  db --> urEntity : 15. return saved row
  deactivate db
  urEntity --> urSvc : 16. return UserRole
  deactivate urEntity

  urSvc --> ctrl : 17. return UserRoleEntity
  ctrl --> form : 18. 201 Created UserRoleEntity

  form --> user : 19. Display role assigned to user confirmation
else role already assigned to user
  urSvc --> ctrl : 20. throw ConflictException
  deactivate urSvc

  ctrl --> form : 21. 409 { message: Role already assigned to this user }
  deactivate ctrl

  form --> user : 22. Display conflict error
  deactivate form
end

deactivate user

@enduml
