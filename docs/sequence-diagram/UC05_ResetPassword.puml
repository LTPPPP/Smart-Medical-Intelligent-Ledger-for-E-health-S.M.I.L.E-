@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ResetPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":RefreshTokensService" as refSvc
entity "AccountEntity" as accEntity
entity "RefreshTokenEntity" as refEntity
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Click reset link, enter new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/reset/password { hash, password }
  activate ctrl

  ctrl -> authSvc : 4. resetPassword(hash, password)
  activate authSvc

  authSvc -> config : 5. get(auth.forgotSecret)
  activate config
  config --> authSvc : 6. return forgotSecret
  deactivate config

  authSvc -> jwt : 7. verifyAsync(hash, secret)
  activate jwt

  alt token is valid
    jwt --> authSvc : 8. return { forgotAccountId }

    authSvc -> accSvc : 9. findById(accountId)
    activate accSvc

    accSvc -> accEntity : 10. findOne(accountId)
    activate accEntity
    accEntity -> db : 11. SELECT account WHERE accountId
    activate db
    db --> accEntity : 12. return result
    deactivate db
    accEntity --> accSvc : 13. return Account
    deactivate accEntity

    accSvc --> authSvc : 14. return Account
    deactivate accSvc

    authSvc -> authSvc : 15. check account exists
    activate authSvc
    deactivate authSvc
    alt account found
      authSvc -> accSvc : 16. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 17. Hash new password
      activate accSvc
      deactivate accSvc

      accSvc -> accEntity : 18. save(accountId, passwordHash)
      activate accEntity
      accEntity -> db : 19. UPDATE passwordHash WHERE accountId
      activate db
      db --> accEntity : 20. return updated row
      deactivate db
      accEntity --> accSvc : 21. return Account
      deactivate accEntity

      accSvc --> authSvc : 22. return Account
      deactivate accSvc

      authSvc -> refSvc : 23. revokeByAccountId(accountId)
      activate refSvc

      refSvc -> refEntity : 24. update(accountId, revokedAt)
      activate refEntity
      refEntity -> db : 25. UPDATE revokedAt for all tokens
      activate db
      db --> refEntity : 26. return updated rows
      deactivate db
      refEntity --> refSvc : 27. return result
      deactivate refEntity

      refSvc --> authSvc : 28. return success
      deactivate refSvc

      authSvc --> ctrl : 29. return { message: "Password reset successfully." }

      ctrl --> form : 30. 200 OK

      form --> user : 31. Show success, redirect to login
    else account not found
      authSvc --> ctrl : 32. throw UnprocessableEntityException

      ctrl --> form : 33. 422 { hash: notFound }
      form --> user : 34. Show error message
    end
  else token invalid or expired
    jwt --> authSvc : 35. throw error
    deactivate jwt

    authSvc --> ctrl : 36. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 37. 422 { hash: invalidHash }
    deactivate ctrl

    form --> user : 38. Show invalid or expired token message
  end
else validation fails
  form --> user : 39. Show validation errors
  deactivate form
end

deactivate user

@enduml
