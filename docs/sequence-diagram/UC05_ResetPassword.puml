@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-005: Reset Password

actor "User" as user
boundary "ResetPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant "JwtService" as jwt
participant "ConfigService" as config
participant ":AccountsService" as accSvc
participant ":RefreshTokensService" as refSvc
database "PostgreSQL" as db

user -> form : 1. Click reset link, enter new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/reset/password { hash, password }
  activate ctrl

  ctrl -> authSvc : 4. resetPassword(hash, password)
  activate authSvc

  authSvc -> config : 5. get(auth.forgotSecret)
  activate config
  config --> authSvc : forgotSecret
  deactivate config

  authSvc -> jwt : 6. verifyAsync(hash, secret)
  activate jwt

  authSvc -> authSvc : 7. check token validity
  activate authSvc
  deactivate authSvc
  alt token is valid
    jwt --> authSvc : { forgotAccountId }
    deactivate jwt

    authSvc -> accSvc : 8. findById(accountId)
    activate accSvc
    accSvc -> db : 9. SELECT account WHERE accountId
    activate db
    db --> accSvc : Account / null
    deactivate db
    accSvc --> authSvc : Account / null
    deactivate accSvc

    authSvc -> authSvc : 10. check account exists
    activate authSvc
    deactivate authSvc
    alt account found
      authSvc -> accSvc : 11. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 12. Hash new password
      activate accSvc
      deactivate accSvc

      accSvc -> db : 13. UPDATE passwordHash WHERE accountId
      activate db
      db --> accSvc : Account
      deactivate db
      accSvc --> authSvc : Account
      deactivate accSvc

      authSvc -> refSvc : 14. revokeByAccountId(accountId)
      activate refSvc
      refSvc -> db : 15. UPDATE revokedAt for all tokens
      activate db
      db --> refSvc : void
      deactivate db
      refSvc --> authSvc : void
      deactivate refSvc

      authSvc --> ctrl : 16. { message: "Password reset successfully." }
      deactivate authSvc

      ctrl --> form : 17. 200 OK
      deactivate ctrl

      form --> user : 18. Show success, redirect to login
      deactivate form
    else account not found
      authSvc --> ctrl : 19. throw UnprocessableEntityException
      deactivate authSvc
      activate ctrl
      ctrl --> form : 20. 422 { hash: notFound }
      deactivate ctrl
      activate form
      form --> user : 21. Show error message
      deactivate form
    end
  else token invalid or expired
    activate jwt
    jwt --> authSvc : 22. throw error
    deactivate jwt

    authSvc --> ctrl : 23. throw UnprocessableEntityException
    deactivate authSvc
    activate ctrl
    ctrl --> form : 24. 422 { hash: invalidHash }
    deactivate ctrl
    activate form
    form --> user : 25. Show invalid or expired token message
  end
else validation fails
  form --> user : 26. Show validation errors
  deactivate form
end

deactivate user

@enduml
