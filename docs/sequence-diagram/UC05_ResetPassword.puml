@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ResetPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":OtpTokensService" as otpSvc
participant ":RefreshTokensService" as refSvc
entity "AccountEntity" as accEntity
entity "OtpTokenEntity" as otpEntity
entity "RefreshTokenEntity" as refEntity
database "PostgreSQL" as db

user -> form : 1. Enter OTP code, new password\nand confirm password
activate user
activate form

user -> form : 2. Click "Reset Password"

form -> form : 3. validate: otp is not empty,\nnewPassword is not empty,\nnewPassword length >= 8 characters,\nnewPassword equals confirmPassword
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. POST /api/v1/auth/reset/password\n{ emailOrPhone, otp, newPassword }
  activate ctrl

  ctrl -> authSvc : 5. resetPassword(emailOrPhone, otp, newPassword)
  activate authSvc

  authSvc -> accSvc : 6. findByEmail(emailOrPhone)
  activate accSvc

  accSvc -> accEntity : 7. findByEmail(email)
  activate accEntity
  accEntity -> db : 8. SELECT account WHERE email
  activate db
  db --> accEntity : 9. return result
  deactivate db
  accEntity --> accSvc : 10. return Account
  deactivate accEntity

  accSvc --> authSvc : 11. return Account
  deactivate accSvc

  alt account found
    authSvc -> otpSvc : 12. findValidByAccountAndCode(accountId,\notp, PASSWORD_RESET)
    activate otpSvc

    otpSvc -> otpEntity : 13. findOne(accountId, otpCode, otpType)
    activate otpEntity
    otpEntity -> db : 14. SELECT otp_token WHERE account_id\nAND otp_code AND otp_type\nAND used_at IS NULL AND expires_at > now()
    activate db
    db --> otpEntity : 15. return result
    deactivate db
    otpEntity --> otpSvc : 16. return OtpToken or null
    deactivate otpEntity

    otpSvc --> authSvc : 17. return OtpToken or null
    deactivate otpSvc

    authSvc -> authSvc : 18. check OTP exists,\nis unused and not expired
    activate authSvc
    deactivate authSvc
    alt OTP is valid
      authSvc -> otpSvc : 19. markAsUsed(otpId)
      activate otpSvc
      otpSvc -> otpEntity : 20. update(otpId, usedAt: now)
      activate otpEntity
      otpEntity -> db : 21. UPDATE otp_tokens SET used_at = now()
      activate db
      db --> otpEntity : 22. return updated row
      deactivate db
      otpEntity --> otpSvc : 23. return result
      deactivate otpEntity
      otpSvc --> authSvc : 24. return void
      deactivate otpSvc

      authSvc -> accSvc : 25. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 26. hash(newPassword) with bcrypt
      activate accSvc
      deactivate accSvc

      accSvc -> accEntity : 27. save(accountId, passwordHash)
      activate accEntity
      accEntity -> db : 28. UPDATE accounts SET password_hash\nWHERE account_id
      activate db
      db --> accEntity : 29. return updated row
      deactivate db
      accEntity --> accSvc : 30. return Account
      deactivate accEntity

      accSvc --> authSvc : 31. return Account
      deactivate accSvc

      authSvc -> refSvc : 32. revokeByAccountId(accountId)
      activate refSvc

      refSvc -> refEntity : 33. update(accountId, revokedAt: now)
      activate refEntity
      refEntity -> db : 34. UPDATE refresh_tokens SET revoked_at\nWHERE account_id
      activate db
      db --> refEntity : 35. return updated rows
      deactivate db
      refEntity --> refSvc : 36. return result
      deactivate refEntity

      refSvc --> authSvc : 37. return success
      deactivate refSvc

      authSvc --> ctrl : 38. return { message: "Password reset successfully." }

      ctrl --> form : 39. 200 OK

      form --> user : 40. Show success, redirect to login
    else OTP invalid, already used or expired
      authSvc --> ctrl : 41. throw UnprocessableEntityException

      ctrl --> form : 42. 422 { otp: invalidOtp }

      form --> user : 43. Show "Failed to reset.\nPlease check your OTP and try again"

      user -> form : 44. Click "Resend code"

      form -> ctrl : 45. POST /api/v1/auth/forgot/password\n{ emailOrPhone }

      ctrl -> authSvc : 46. forgotPassword(emailOrPhone)

      ref over authSvc, otpSvc, otpEntity, db : UC-10 Send OTP

      authSvc --> ctrl : 47. return { message: "Reset code sent." }

      ctrl --> form : 48. 200 OK

      form --> user : 49. Show "A new code has been sent"
    end
  else account not found
    authSvc --> ctrl : 50. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 51. 422 { email: emailNotExists }
    deactivate ctrl

    form --> user : 52. Show account not found message
  end
else validation fails
  form --> user : 53. Show the first failing rule:\n"Please enter the OTP code" /\n"Please enter a new password" /\n"Password must be at least 8 characters" /\n"Passwords do not match"
  deactivate form
end

deactivate user

@enduml
