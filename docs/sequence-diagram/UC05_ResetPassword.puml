@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-005: Reset Password

actor "User" as user
boundary "ResetPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant "JwtService" as jwt
participant "ConfigService" as config
participant ":AccountsService" as accSvc
participant ":RefreshTokensService" as refSvc
database "PostgreSQL" as db

user -> form : 1. Click reset link, enter new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/reset/password { hash, password }
  activate ctrl

  ctrl -> authSvc : 4. resetPassword(hash, password)
  activate authSvc

  authSvc -> config : 5. get(auth.forgotSecret)
  activate config
  config --> authSvc : 6. return forgotSecret
  deactivate config

  authSvc -> jwt : 7. verifyAsync(hash, secret)
  activate jwt

  authSvc -> authSvc : 8. check token validity
  activate authSvc
  deactivate authSvc
  alt token is valid
    jwt --> authSvc : 9. return { forgotAccountId }
    deactivate jwt

    authSvc -> accSvc : 10. findById(accountId)
    activate accSvc
    accSvc -> db : 11. SELECT account WHERE accountId
    activate db
    db --> accSvc : 12. return Account / null
    deactivate db
    accSvc --> authSvc : 13. return Account / null
    deactivate accSvc

    authSvc -> authSvc : 14. check account exists
    activate authSvc
    deactivate authSvc
    alt account found
      authSvc -> accSvc : 15. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 16. Hash new password
      activate accSvc
      deactivate accSvc

      accSvc -> db : 17. UPDATE passwordHash WHERE accountId
      activate db
      db --> accSvc : 18. return updated Account
      deactivate db
      accSvc --> authSvc : 19. return Account
      deactivate accSvc

      authSvc -> refSvc : 20. revokeByAccountId(accountId)
      activate refSvc
      refSvc -> db : 21. UPDATE revokedAt for all tokens
      activate db
      db --> refSvc : 22. return updated (affectedRows)
      deactivate db
      refSvc --> authSvc : 23. return success
      deactivate refSvc

      authSvc --> ctrl : 24. return { message: "Password reset successfully." }
      deactivate authSvc

      ctrl --> form : 25. 200 OK
      deactivate ctrl

      form --> user : 26. Show success, redirect to login
      deactivate form
    else account not found
      authSvc --> ctrl : 27. throw UnprocessableEntityException
      deactivate authSvc
      activate ctrl
      ctrl --> form : 28. 422 { hash: notFound }
      deactivate ctrl
      activate form
      form --> user : 29. Show error message
      deactivate form
    end
  else token invalid or expired
    activate jwt
    jwt --> authSvc : 30. throw error
    deactivate jwt

    authSvc --> ctrl : 31. throw UnprocessableEntityException
    deactivate authSvc
    activate ctrl
    ctrl --> form : 32. 422 { hash: invalidHash }
    deactivate ctrl
    activate form
    form --> user : 33. Show invalid or expired token message
  end
else validation fails
  form --> user : 34. Show validation errors
  deactivate form
end

deactivate user

@enduml
