@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ResetPasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
participant ":RefreshTokensService" as refSvc
entity "AccountEntity" as accEntity
entity "RefreshTokenEntity" as refEntity
database "PostgreSQL" as db
participant "JwtService" as jwt
participant "ConfigService" as config

user -> form : 1. Click reset link, enter new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/auth/reset/password { hash, password }
  activate ctrl

  ctrl -> authSvc : 4. resetPassword(hash, password)
  activate authSvc

  authSvc -> config : 5. get(auth.forgotSecret)
  activate config
  config --> authSvc : 6. return forgotSecret
  deactivate config

  authSvc -> jwt : 7. verifyAsync(hash, secret)
  activate jwt

  jwt -> jwt : 8. validate reset token
  activate jwt
  deactivate jwt
  alt token is valid
    jwt --> authSvc : 9. return { forgotAccountId }

    authSvc -> accSvc : 10. findById(accountId)
    activate accSvc

    accSvc -> accEntity : 11. findOne(accountId)
    activate accEntity
    accEntity -> db : 12. SELECT account WHERE accountId
    activate db
    db --> accEntity : 13. return result
    deactivate db
    accEntity --> accSvc : 14. return Account
    deactivate accEntity

    accSvc --> authSvc : 15. return Account
    deactivate accSvc

    authSvc -> authSvc : 16. check account exists
    activate authSvc
    deactivate authSvc
    alt account found
      authSvc -> accSvc : 17. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 18. Hash new password
      activate accSvc
      deactivate accSvc

      accSvc -> accEntity : 19. save(accountId, passwordHash)
      activate accEntity
      accEntity -> db : 20. UPDATE passwordHash WHERE accountId
      activate db
      db --> accEntity : 21. return updated row
      deactivate db
      accEntity --> accSvc : 22. return Account
      deactivate accEntity

      accSvc --> authSvc : 23. return Account
      deactivate accSvc

      authSvc -> refSvc : 24. revokeByAccountId(accountId)
      activate refSvc

      refSvc -> refEntity : 25. update(accountId, revokedAt)
      activate refEntity
      refEntity -> db : 26. UPDATE revokedAt for all tokens
      activate db
      db --> refEntity : 27. return updated rows
      deactivate db
      refEntity --> refSvc : 28. return result
      deactivate refEntity

      refSvc --> authSvc : 29. return success
      deactivate refSvc

      authSvc --> ctrl : 30. return { message: "Password reset successfully." }

      ctrl --> form : 31. 200 OK

      form --> user : 32. Show success, redirect to login
    else account not found
      authSvc --> ctrl : 33. throw UnprocessableEntityException

      ctrl --> form : 34. 422 { hash: notFound }
      form --> user : 35. Show error message
    end
  else token invalid or expired
    jwt --> authSvc : 36. throw error
    deactivate jwt

    authSvc --> ctrl : 37. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 38. 422 { hash: invalidHash }
    deactivate ctrl

    form --> user : 39. Show invalid or expired token message
  end
else validation fails
  form --> user : 40. Show validation errors
  deactivate form
end

deactivate user

@enduml
