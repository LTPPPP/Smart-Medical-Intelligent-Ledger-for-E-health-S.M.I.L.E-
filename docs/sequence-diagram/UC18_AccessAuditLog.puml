@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-018: Access Audit Log

actor "Admin" as user
boundary "AuditLogPanel" as form
participant ":AuditLogsController" as ctrl
participant ":AuditLogsService" as auditSvc
database "PostgreSQL\n(audit_logs)" as auditDb
database "PostgreSQL\n(user_profiles)" as profileDb

user -> form : 1. Open audit log panel
activate user
activate form

form -> form : 2. Set default filters (date range, page: 1, limit: 20)
activate form
deactivate form

form -> ctrl : 3. GET /api/v1/audit-logs?from_date&to_date&page=1&limit=20
activate ctrl

ctrl -> auditSvc : 4. findAll(QueryAuditLogDto)
activate auditSvc

auditSvc -> auditSvc : 5. Build WHERE clause from filters (user_id, action, resource, from_date, to_date)
activate auditSvc
deactivate auditSvc

auditSvc -> auditDb : 6. SELECT audit_logs WHERE filters ORDER BY created_at DESC LIMIT 20
activate auditDb
auditDb --> auditSvc : 7. return [AuditLogEntity[], total]
deactivate auditDb

auditSvc -> auditSvc : 8. Extract unique user_ids from results
activate auditSvc
deactivate auditSvc

auditSvc -> profileDb : 9. SELECT user_profiles WHERE user_id IN (userIds)
activate profileDb
profileDb --> auditSvc : 10. return UserProfileEntity[]
deactivate profileDb

auditSvc -> auditSvc : 11. Enrich each log entry with full_name from profile map
activate auditSvc
deactivate auditSvc

auditSvc --> ctrl : 12. return { data: AuditLogWithUser[], total }
deactivate auditSvc

ctrl --> form : 13. 200 OK { data, meta: { page, limit, total } }
deactivate ctrl

form --> user : 14. Display paginated audit log list
deactivate form

user -> form : 15. Select a log entry to view detail
activate form

form -> ctrl : 16. GET /api/v1/audit-logs/{id}
activate ctrl

ctrl -> auditSvc : 17. findById(id)
activate auditSvc

auditSvc -> auditDb : 18. SELECT audit_log WHERE log_id
activate auditDb
auditDb --> auditSvc : 19. return AuditLogEntity / null
deactivate auditDb

auditSvc -> auditSvc : 20. check log entry exists
activate auditSvc
deactivate auditSvc
alt log entry found
  opt user_id is present
    auditSvc -> profileDb : 21. SELECT user_profile WHERE user_id
    activate profileDb
    profileDb --> auditSvc : 22. return UserProfileEntity / null
    deactivate profileDb
  end

  auditSvc -> auditSvc : 23. Attach full_name to log entry
  activate auditSvc
  deactivate auditSvc

  auditSvc --> ctrl : 24. return AuditLogWithUser
  deactivate auditSvc

  ctrl --> form : 25. 200 OK AuditLogWithUser
  deactivate ctrl

  form --> user : 26. Display audit log detail\n(action, resource, user, IP, timestamp, details)
  deactivate form
else log entry not found
  auditSvc --> ctrl : 27. return null
  deactivate auditSvc
  activate ctrl
  ctrl --> form : 28. 404 { message: Audit log not found }
  deactivate ctrl
  activate form
  form --> user : 29. Display not found message
  deactivate form
end

deactivate user

@enduml
