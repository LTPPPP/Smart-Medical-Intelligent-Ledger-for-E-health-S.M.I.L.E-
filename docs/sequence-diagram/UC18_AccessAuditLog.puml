@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "AuditLogPanel" as form
participant ":AuditLogsController" as ctrl
participant ":AuditLogsService" as auditSvc
entity "AuditLogEntity" as auditEntity
database "PostgreSQL" as db

user -> form : 1. Open audit log panel
activate user
activate form

form -> form : 2. Set default filters (date range, page: 1, limit: 20)
activate form
deactivate form

form -> ctrl : 3. GET /api/v1/audit-logs?from_date&to_date&page=1&limit=20
activate ctrl

ctrl -> auditSvc : 4. findAll(QueryAuditLogDto)
activate auditSvc

auditSvc -> auditSvc : 5. Build WHERE clause from filters\n(user_id, action, resource, from_date, to_date)
activate auditSvc
deactivate auditSvc

auditSvc -> auditEntity : 6. findAndCount(filters, pagination)
activate auditEntity
auditEntity -> db : 7. SELECT audit_logs WHERE filters\nORDER BY created_at DESC LIMIT 20
activate db
db --> auditEntity : 8. return { data: AuditLog[], total }
deactivate db
auditEntity --> auditSvc : 9. return { data: AuditLog[], total }
deactivate auditEntity

auditSvc -> auditSvc : 10. Extract unique user_ids from results
activate auditSvc
deactivate auditSvc

auditSvc -> auditEntity : 11. findUserProfiles(userIds)
activate auditEntity
auditEntity -> db : 12. SELECT user_profiles WHERE user_id IN (userIds)
activate db
db --> auditEntity : 13. return UserProfile[]
deactivate db
auditEntity --> auditSvc : 14. return UserProfile[]
deactivate auditEntity

auditSvc -> auditSvc : 15. Enrich each log entry with full_name from profile map
activate auditSvc
deactivate auditSvc

auditSvc --> ctrl : 16. return { data: AuditLogWithUser[], total }
deactivate auditSvc

ctrl --> form : 17. 200 OK { data, meta: { page, limit, total } }
deactivate ctrl

form --> user : 18. Display paginated audit log list
deactivate form

deactivate user

@enduml
