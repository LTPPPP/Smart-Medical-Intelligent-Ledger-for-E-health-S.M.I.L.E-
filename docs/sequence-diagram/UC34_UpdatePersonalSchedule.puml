@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ScheduleDetailPanel" as form
participant ":DoctorSchedulesController" as ctrl
participant ":DoctorSchedulesService" as schSvc
entity "DoctorLeaveEntity" as leaveEntity
database "PostgreSQL" as db

user -> form : 1. Edit schedule fields\n(shift, room, max patients, notes) and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/doctor-schedules/{id}\n{ shift_id?, room_id?, max_patients?, notes?, changed_by, change_reason }
activate ctrl

ctrl -> schSvc : 3. update(id, UpdateDoctorScheduleDto)
activate schSvc

schSvc -> leaveEntity : 4. findOne(id)
activate leaveEntity
leaveEntity -> db : 5. SELECT schedule WHERE schedule_id with relations
activate db
db --> leaveEntity : 6. return result
deactivate db
leaveEntity --> schSvc : 7. return DoctorLeaveEntity
deactivate leaveEntity

schSvc -> schSvc : 8. check schedule exists
activate schSvc
deactivate schSvc
alt schedule found
  schSvc -> schSvc : 9. Capture old values for audit
  activate schSvc
  deactivate schSvc

  schSvc -> leaveEntity : 10. save(updatedSchedule)
  activate leaveEntity
  leaveEntity -> db : 11. UPDATE doctor_schedule SET changed fields
  activate db
  db --> leaveEntity : 12. return updated row
  deactivate db
  leaveEntity --> schSvc : 13. return DoctorLeaveEntity
  deactivate leaveEntity

  schSvc -> leaveEntity : 14. saveChange(scheduleChange)
  activate leaveEntity
  leaveEntity -> db : 15. INSERT schedule_change\n{ change_type: RESCHEDULING, old_values, new_values, reason }
  activate db
  db --> leaveEntity : 16. return saved row
  deactivate db
  leaveEntity --> schSvc : 17. return ScheduleChangeEntity
  deactivate leaveEntity

  schSvc --> ctrl : 18. return DoctorLeaveEntity
  ctrl --> form : 19. 200 OK DoctorLeaveEntity
  form --> user : 20. Display updated schedule
else schedule not found
  schSvc --> ctrl : 21. throw NotFoundException
  deactivate schSvc
  ctrl --> form : 22. 404 { message: Schedule not found }
  deactivate ctrl
  form --> user : 23. Show not found error
  deactivate form
end

deactivate user

@enduml
