@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "PermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
entity "PermissionEntity" as permEntity
database "PostgreSQL" as db

user -> form : 1. Fill permission name, description and submit
activate user
activate form

form -> ctrl : 2. POST /api/v1/permissions\n{ permission_name, description }
activate ctrl

ctrl -> permSvc : 3. create(CreatePermissionDto)
activate permSvc

permSvc -> permEntity : 4. findOne(permissionName)
activate permEntity
permEntity -> db : 5. SELECT permission WHERE permission_name
activate db
db --> permEntity : 6. return result
deactivate db
permEntity --> permSvc : 7. return Permission
deactivate permEntity

permSvc -> permSvc : 8. check duplicate
activate permSvc
deactivate permSvc
alt no duplicate
  permSvc -> permEntity : 9. save(permissionName, description)
  activate permEntity
  permEntity -> db : 10. INSERT INTO permissions
  activate db
  db --> permEntity : 11. return saved row
  deactivate db
  permEntity --> permSvc : 12. return Permission
  deactivate permEntity

  permSvc --> ctrl : 13. return PermissionEntity
  deactivate permSvc

  ctrl --> form : 14. 201 Created PermissionEntity
  deactivate ctrl

  form --> user : 15. Display created permission
else duplicate exists
  permSvc --> ctrl : 16. throw ConflictException
  deactivate permSvc

  ctrl --> form : 17. 409 { message: Permission already exists }
  deactivate ctrl

  form --> user : 18. Display conflict error
end

deactivate user

@enduml
