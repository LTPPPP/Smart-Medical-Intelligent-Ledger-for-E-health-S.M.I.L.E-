@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "PermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
entity "PermissionEntity" as permEntity
database "PostgreSQL" as db

user -> form : 1. Fill permission name, description
activate user
activate form

user -> form : 2. Click "Create Permission"

form -> ctrl : 3. POST /api/v1/permissions\n{ permission_name, description }
activate ctrl

ctrl -> permSvc : 4. create(CreatePermissionDto)
activate permSvc

permSvc -> permEntity : 5. findOne(permissionName)
activate permEntity
permEntity -> db : 6. SELECT permission WHERE permission_name
activate db
db --> permEntity : 7. return result
deactivate db
permEntity --> permSvc : 8. return Permission
deactivate permEntity

permSvc -> permSvc : 9. check duplicate
activate permSvc
deactivate permSvc
alt no duplicate
  permSvc -> permEntity : 10. save(permissionName, description)
  activate permEntity
  permEntity -> db : 11. INSERT INTO permissions
  activate db
  db --> permEntity : 12. return saved row
  deactivate db
  permEntity --> permSvc : 13. return Permission
  deactivate permEntity

  permSvc --> ctrl : 14. return PermissionEntity
  ctrl --> form : 15. 201 Created PermissionEntity

  form --> user : 16. Display created permission
else duplicate exists
  permSvc --> ctrl : 17. throw ConflictException
  deactivate permSvc

  ctrl --> form : 18. 409 { message: Permission already exists }
  deactivate ctrl

  form --> user : 19. Display conflict error
  deactivate form
end

deactivate user

@enduml
