@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-013: Create Permission

actor "Admin" as user
boundary "PermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
database "PostgreSQL" as db

user -> form : 1. Fill permission name, description and submit
activate user
activate form

form -> ctrl : 2. POST /api/v1/permissions\n{ permission_name, description }
activate ctrl

ctrl -> permSvc : 3. create(CreatePermissionDto)
activate permSvc

permSvc -> db : 4. SELECT permission WHERE permission_name
activate db
db --> permSvc : 5. return PermissionEntity / null
deactivate db

permSvc -> permSvc : 6. check duplicate
activate permSvc
deactivate permSvc
alt no duplicate
  permSvc -> db : 7. INSERT INTO permissions
  activate db
  db --> permSvc : 8. return PermissionEntity
  deactivate db

  permSvc --> ctrl : 9. return PermissionEntity
  deactivate permSvc

  ctrl --> form : 10. 201 Created PermissionEntity
  deactivate ctrl

  form --> user : 11. Display created permission
  deactivate form
else duplicate exists
  permSvc --> ctrl : 12. throw ConflictException
  deactivate permSvc
  activate ctrl
  ctrl --> form : 13. 409 { message: Permission already exists }
  deactivate ctrl
  activate form
  form --> user : 14. Display conflict error
  deactivate form
end

deactivate user

@enduml
