@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentPlanDetailPanel" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as planSvc
entity "TreatmentPlanEntity" as planEntity
database "PostgreSQL" as db

user -> form : 1. Edit treatment plan fields
activate user
activate form

user -> form : 2. Click "Save Changes"
form -> ctrl : 3. PATCH /api/v1/treatment-plans/{plan_id}\nUpdateTreatmentPlanDto
activate ctrl

ctrl -> planSvc : 4. update(plan_id, UpdateTreatmentPlanDto)
activate planSvc

planSvc -> planEntity : 5. findOne(plan_id)
activate planEntity
planEntity -> db : 6. SELECT treatment_plan WHERE plan_id
activate db
db --> planEntity : 7. return result
deactivate db
planEntity --> planSvc : 8. return TreatmentPlanEntity
deactivate planEntity

planSvc -> planSvc : 9. check plan exists
activate planSvc
deactivate planSvc
alt plan found
  planSvc -> planEntity : 10. save(updatedFields)
  activate planEntity
  planEntity -> db : 11. UPDATE treatment_plan SET changed fields
  activate db
  db --> planEntity : 12. return updated row
  deactivate db
  planEntity --> planSvc : 13. return TreatmentPlanEntity
  deactivate planEntity

  planSvc --> ctrl : 14. return TreatmentPlanEntity

  ctrl --> form : 15. 200 OK TreatmentPlanEntity

  form --> user : 16. Display updated treatment plan
else plan not found
  planSvc --> ctrl : 17. throw NotFoundException
  deactivate planSvc

  ctrl --> form : 18. 404 { message: Treatment plan not found }
  deactivate ctrl

  form --> user : 19. Show not found error
  deactivate form
end

deactivate user

@enduml
