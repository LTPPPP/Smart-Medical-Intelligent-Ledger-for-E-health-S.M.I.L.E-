@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-072: Edit Treatment Plan

actor "Doctor" as user
boundary "TreatmentPlanDetailPanel" as form
participant ":TreatmentPlansController" as ctrl
participant ":TreatmentPlansService" as planSvc
database "PostgreSQL" as db

user -> form : 1. Edit treatment plan fields and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/treatment-plans/{plan_id}\nUpdateTreatmentPlanDto
activate ctrl

ctrl -> planSvc : 3. update(plan_id, UpdateTreatmentPlanDto)
activate planSvc

planSvc -> db : 4. SELECT treatment_plan WHERE plan_id
activate db
db --> planSvc : 5. return TreatmentPlanEntity / null
deactivate db

planSvc -> planSvc : 6. check plan exists
activate planSvc
deactivate planSvc
alt plan found
  planSvc -> db : 7. UPDATE treatment_plan SET changed fields
  activate db
  db --> planSvc : 8. return updated TreatmentPlanEntity
  deactivate db

  planSvc --> ctrl : 9. return TreatmentPlanEntity
  deactivate planSvc

  ctrl --> form : 10. 200 OK TreatmentPlanEntity
  deactivate ctrl

  form --> user : 11. Display updated treatment plan
  deactivate form
else plan not found
  planSvc --> ctrl : 12. throw NotFoundException
  deactivate planSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Treatment plan not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
