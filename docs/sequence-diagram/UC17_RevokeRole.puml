@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "UserRolesPanel" as form
participant ":UserRolesController" as ctrl
participant ":UserRolesService" as urSvc
entity "UserRoleEntity" as urEntity
entity "RoleEntity" as roleEntity
database "PostgreSQL" as db

user -> form : 1. Select user and click "Revoke Role"
activate user
activate form

form -> ctrl : 2. DELETE /api/v1/user-roles/user/{userId}/role/{roleId}
activate ctrl

ctrl -> urSvc : 3. revokeRole(userId, roleId)
activate urSvc

urSvc -> urEntity : 4. delete(userId, roleId)
activate urEntity
urEntity -> db : 5. DELETE FROM user_roles\nWHERE user_id AND role_id
activate db
db --> urEntity : 6. return deleted (affectedRows: 1)
deactivate db
urEntity --> urSvc : 7. return result
deactivate urEntity

urSvc --> ctrl : 8. return success
deactivate urSvc

ctrl --> form : 9. 204 No Content
deactivate ctrl

form --> user : 10. Display role revoked confirmation
deactivate form

deactivate user

@enduml
