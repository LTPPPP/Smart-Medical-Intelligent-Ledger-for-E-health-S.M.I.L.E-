@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as staff
actor "Admin" as admin
boundary "KycVerificationView" as form
boundary "KycAdminPanel" as adminForm
participant ":KycVerificationsController" as ctrl
participant ":KycVerificationsService" as kycSvc
participant ":KycFileStorageService" as fileSvc
entity "KycVerificationEntity" as kycEntity
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

staff -> form : 1. Open KYC verification page
activate staff
activate form

form -> ctrl : 2. GET /api/v1/kyc-verifications/me
activate ctrl

ctrl -> kycSvc : 3. findMine(userId)
activate kycSvc

kycSvc -> kycEntity : 4. findOne(userId)
activate kycEntity
kycEntity -> db : 5. SELECT kyc_verification WHERE user_id\nORDER BY created_at DESC
activate db
db --> kycEntity : 6. return result
deactivate db
kycEntity --> kycSvc : 7. return KycVerification
deactivate kycEntity

kycSvc --> ctrl : 8. return KycResponseDto
deactivate kycSvc

ctrl --> form : 9. 200 OK { status, submitted_at }
deactivate ctrl

form --> staff : 10. Display current KYC status
deactivate form

staff -> form : 11. Upload ID document
activate form
staff -> form : 12. Click "Submit KYC"

form -> ctrl : 13. POST /api/v1/kyc-verifications/me/submit\n{ document files }
activate ctrl

ctrl -> kycSvc : 14. submitForCurrentUser(userId, files)
activate kycSvc

kycSvc -> fileSvc : 15. uploadDocuments(files)
activate fileSvc
fileSvc --> kycSvc : 16. return file paths
deactivate fileSvc

kycSvc -> kycEntity : 17. save(userId, status: PENDING, documentPaths)
activate kycEntity
kycEntity -> db : 18. INSERT kyc_verification\n{ user_id, status: PENDING, document_paths }
activate db
db --> kycEntity : 19. return saved row
deactivate db
kycEntity --> kycSvc : 20. return KycVerification
deactivate kycEntity

kycSvc --> ctrl : 21. return KycResponseDto
deactivate kycSvc

ctrl --> form : 22. 201 Created { KycResponseDto }
deactivate ctrl

form --> staff : 23. Show submission confirmation\n(status: PENDING)
deactivate form
deactivate staff

admin -> adminForm : 24. Open KYC review panel
activate admin
activate adminForm

admin -> adminForm : 25. Select a PENDING submission,\nreview documents and enter notes

admin -> adminForm : 26. Click "Approve"

adminForm -> adminForm : 27. validate: a submission is selected\nand its status is PENDING
activate adminForm
deactivate adminForm

adminForm -> ctrl : 28. POST /api/v1/kyc-verifications/{id}/approve\n{ notes }
activate ctrl

ctrl -> kycSvc : 29. approve(id, reviewerId, ApproveKycDto)
activate kycSvc

kycSvc -> kycEntity : 30. save(id, status: APPROVED, reviewedBy, reviewedAt)
activate kycEntity
kycEntity -> db : 31. UPDATE kyc_verification\nSET status = APPROVED, reviewed_by, reviewed_at
activate db
db --> kycEntity : 32. return updated row
deactivate db
kycEntity --> kycSvc : 33. return KycVerification
deactivate kycEntity

kycSvc -> accEntity : 34. update(userId, kycVerified: true)
activate accEntity
accEntity -> db : 35. UPDATE account SET kyc_verified = true
activate db
db --> accEntity : 36. return updated row
deactivate db
accEntity --> kycSvc : 37. return Account
deactivate accEntity

kycSvc --> ctrl : 38. return KycResponseDto
deactivate kycSvc

ctrl --> adminForm : 39. 200 OK { KycResponseDto }
deactivate ctrl

adminForm --> admin : 40. Display approval confirmation
deactivate adminForm
deactivate admin

@enduml
