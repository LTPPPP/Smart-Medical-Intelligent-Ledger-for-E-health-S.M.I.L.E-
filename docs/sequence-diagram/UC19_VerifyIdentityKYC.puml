@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-019: Verify Identity KYC (Phone Number)

actor "User" as user
boundary "PhoneVerificationView" as form
participant ":AccountsController" as ctrl
participant ":AccountsService" as accSvc
participant ":OtpTokensService" as otpSvc
database "PostgreSQL" as db

user -> form : 1. Click "Verify Phone Number"
activate user
activate form

form -> ctrl : 2. POST /api/v1/accounts/me/phone/send-otp
activate ctrl

ctrl -> accSvc : 3. createPhoneVerificationOtp(accountId)
activate accSvc

accSvc -> otpSvc : 4. create(accountId, IDENTITY_VERIFY)
activate otpSvc

otpSvc -> otpSvc : 5. generateOtpCode() → 6-digit code
activate otpSvc
deactivate otpSvc

otpSvc -> otpSvc : 6. Calculate expiresAt from AUTH_OTP_EXPIRES_IN
activate otpSvc
deactivate otpSvc

otpSvc -> db : 7. INSERT otp_token\n{ accountId, otpCode, otpType, expiresAt }
activate db
db --> otpSvc : 8. return OtpToken
deactivate db

otpSvc --> accSvc : 9. return OtpToken
deactivate otpSvc

accSvc --> ctrl : 10. return { message: "Phone verification OTP created" }
deactivate accSvc

ctrl --> form : 11. 200 OK { message }
deactivate ctrl

form --> user : 12. Show OTP input form\n(SMS sent to registered phone)
deactivate form

user -> form : 13. Enter 6-digit OTP and submit
activate form

form -> ctrl : 14. POST /api/v1/accounts/me/verify-phone { otp }
activate ctrl

ctrl -> accSvc : 15. verifyPhoneWithOtp(accountId, otp)
activate accSvc

accSvc -> otpSvc : 16. findValidByAccountAndCode\n(accountId, otp, IDENTITY_VERIFY)
activate otpSvc

otpSvc -> db : 17. SELECT otp_token WHERE account_id AND otp_code\nAND otp_type AND NOT used AND expiresAt > NOW()
activate db
db --> otpSvc : 18. return OtpToken / null
deactivate db

otpSvc --> accSvc : 19. return OtpToken / null
deactivate otpSvc

accSvc -> accSvc : 20. check token exists
activate accSvc
deactivate accSvc
alt valid OTP found
  accSvc -> otpSvc : 21. markAsUsed(otpId)
  activate otpSvc
  otpSvc -> db : 22. UPDATE otp_token SET usedAt = NOW()
  activate db
  db --> otpSvc : 23. return updated OtpToken
  deactivate db
  otpSvc --> accSvc : 24. return updated OtpToken
  deactivate otpSvc

  accSvc -> db : 25. UPDATE account SET phoneVerified = true
  activate db
  db --> accSvc : 26. return updated Account
  deactivate db

  accSvc --> ctrl : 27. return success
  deactivate accSvc

  ctrl --> form : 28. 200 OK { message: "Phone number verified successfully" }
  deactivate ctrl

  form --> user : 29. Show verification success
  deactivate form
else invalid or expired OTP
  accSvc --> ctrl : 30. throw UnauthorizedException("Invalid or expired OTP")
  deactivate accSvc
  activate ctrl
  ctrl --> form : 31. 401 { message: "Invalid or expired OTP" }
  deactivate ctrl
  activate form
  form --> user : 32. Show OTP error message
  deactivate form
end

deactivate user

@enduml
