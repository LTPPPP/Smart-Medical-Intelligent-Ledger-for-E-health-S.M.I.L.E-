@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "KycVerificationView" as form
participant ":KycVerificationsController" as ctrl
participant ":KycVerificationsService" as kycSvc
participant ":KycFileStorageService" as fileSvc
entity "KycVerificationEntity" as kycEntity
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

user -> form : 1. Open KYC verification page
activate user
activate form

form -> ctrl : 2. GET /api/v1/kyc-verifications/me
activate ctrl

ctrl -> kycSvc : 3. findMine(userId)
activate kycSvc

kycSvc -> kycEntity : 4. findOne(userId)
activate kycEntity
kycEntity -> db : 5. SELECT kyc_verification WHERE user_id\nORDER BY created_at DESC
activate db
db --> kycEntity : 6. return result
deactivate db
kycEntity --> kycSvc : 7. return KycVerification
deactivate kycEntity

kycSvc --> ctrl : 8. return KycResponseDto
deactivate kycSvc

ctrl --> form : 9. 200 OK { status, submitted_at }
deactivate ctrl

form --> user : 10. Display current KYC status
deactivate form

user -> form : 11. Upload ID document and submit
activate form

form -> ctrl : 12. POST /api/v1/kyc-verifications/me/submit\n{ document files }
activate ctrl

ctrl -> kycSvc : 13. submitForCurrentUser(userId, files)
activate kycSvc

kycSvc -> fileSvc : 14. uploadDocuments(files)
activate fileSvc
fileSvc --> kycSvc : 15. return file paths
deactivate fileSvc

kycSvc -> kycEntity : 16. save(userId, status: PENDING, documentPaths)
activate kycEntity
kycEntity -> db : 17. INSERT kyc_verification\n{ user_id, status: PENDING, document_paths }
activate db
db --> kycEntity : 18. return saved row
deactivate db
kycEntity --> kycSvc : 19. return KycVerification
deactivate kycEntity

kycSvc --> ctrl : 20. return KycResponseDto
deactivate kycSvc

ctrl --> form : 21. 201 Created { KycResponseDto }
deactivate ctrl

form --> user : 22. Show submission confirmation\n(status: PENDING)
deactivate form

opt Admin reviews submission
  actor "Admin" as admin
  boundary "KycAdminPanel" as adminForm

  admin -> adminForm : 23. Open KYC review panel
  activate admin
  activate adminForm

  adminForm -> ctrl : 24. POST /api/v1/kyc-verifications/{id}/approve\n{ notes }
  activate ctrl

  ctrl -> kycSvc : 25. approve(id, reviewerId, ApproveKycDto)
  activate kycSvc

  kycSvc -> kycEntity : 26. save(id, status: APPROVED, reviewedBy, reviewedAt)
  activate kycEntity
  kycEntity -> db : 27. UPDATE kyc_verification\nSET status = APPROVED, reviewed_by, reviewed_at
  activate db
  db --> kycEntity : 28. return updated row
  deactivate db
  kycEntity --> kycSvc : 29. return KycVerification
  deactivate kycEntity

  kycSvc -> accEntity : 30. update(userId, kycVerified: true)
  activate accEntity
  accEntity -> db : 31. UPDATE account SET kyc_verified = true
  activate db
  db --> accEntity : 32. return updated row
  deactivate db
  accEntity --> kycSvc : 33. return Account
  deactivate accEntity

  kycSvc --> ctrl : 34. return KycResponseDto
  deactivate kycSvc

  ctrl --> adminForm : 35. 200 OK { KycResponseDto }
  deactivate ctrl

  adminForm --> admin : 36. Display approval confirmation
  deactivate adminForm
  deactivate admin
end

deactivate user

@enduml
