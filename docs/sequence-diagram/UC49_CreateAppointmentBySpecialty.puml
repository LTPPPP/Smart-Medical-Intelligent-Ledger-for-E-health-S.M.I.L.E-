@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select specialty, date, time,\nenter chief complaint
activate user
activate page

page -> page : 2. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 3. POST /api/v1/appointments/by-specialty\nBookBySpecialtyDto
  activate ctrl

  ctrl -> aptSvc : 4. createBySpecialty(BookBySpecialtyDto)
  activate aptSvc

  aptSvc -> aptEntity : 5. find(DoctorSpecialty WHERE specialty_id)
  activate aptEntity
  aptEntity -> db : 6. SELECT * FROM doctor_specialties WHERE specialty_id
  activate db
  db --> aptEntity : 7. return rows
  deactivate db
  aptEntity --> aptSvc : 8. return DoctorSpecialty[]
  deactivate aptEntity

  aptSvc -> aptSvc : 9. check doctors found for specialty
  activate aptSvc
  deactivate aptSvc
  alt doctors found
    aptSvc -> aptEntity : 10. findOne(DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status)
    activate aptEntity
    aptEntity -> db : 11. SELECT * FROM doctor_schedules WHERE conditions
    activate db
    db --> aptEntity : 12. return row
    deactivate db
    aptEntity --> aptSvc : 13. return DoctorSchedule
    deactivate aptEntity

    aptSvc -> aptSvc : 14. check available doctor found
    activate aptSvc
    deactivate aptSvc
    alt available doctor found
      aptSvc -> kyc : 15. assertCanBook(created_by)
      activate kyc
      kyc --> aptSvc : 16. return eligible
      deactivate kyc

      aptSvc -> aptSvc : 17. generateAppointmentCode()
      activate aptSvc
      deactivate aptSvc

      aptSvc -> aptEntity : 18. save(appointment)
      activate aptEntity
      aptEntity -> db : 19. INSERT INTO appointments
      activate db
      db --> aptEntity : 20. return saved row
      deactivate db
      aptEntity --> aptSvc : 21. return Appointment
      deactivate aptEntity

      aptSvc -> histEntity : 22. save(old_status: null, new_status: SCHEDULED)
      activate histEntity
      histEntity -> db : 23. INSERT INTO appointment_status_history
      activate db
      db --> histEntity : 24. return saved row
      deactivate db
      histEntity --> aptSvc : 25. return AppointmentStatusHistory
      deactivate histEntity

      aptSvc --> ctrl : 26. return Appointment

      ctrl --> page : 27. 201 Created { Appointment }

      page --> user : 28. Show booking confirmation
    else no available doctor
      aptSvc --> ctrl : 29. throw BadRequestException
      ctrl --> page : 30. 400 { No scheduled doctors found }
      page --> user : 31. Show no availability message
    end
  else no doctors for specialty
    aptSvc --> ctrl : 32. throw BadRequestException
    deactivate aptSvc
    ctrl --> page : 33. 400 { No doctors found for specialty }
    deactivate ctrl
    page --> user : 34. Show no doctors message
  end
else validation fails
  page --> user : 35. Show validation errors
  deactivate page
end

deactivate user

@enduml
