@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-049: Create Appointment by Specialty

actor "Patient" as patient
boundary "BookingForm" as form
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
database "PostgreSQL" as db
participant ":AppointmentNotificationPublisher" as notifPub

patient -> form : 1. Select specialty, date, time,\nenter chief complaint
activate patient
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/appointments/by-specialty
  activate ctrl

  ctrl -> aptSvc : 4. createBySpecialty(BookBySpecialtyDto)
  activate aptSvc

  aptSvc -> db : 5. SELECT DoctorSpecialty WHERE specialty_id
  activate db
  db --> aptSvc : 6. return DoctorSpecialty[]
  deactivate db

  aptSvc -> aptSvc : 7. check doctors found for specialty
  activate aptSvc
  deactivate aptSvc
  alt doctors found for specialty
    aptSvc -> db : 8. SELECT DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status
    activate db
    db --> aptSvc : 9. return DoctorSchedule / null
    deactivate db

    aptSvc -> aptSvc : 10. check available doctor found
    activate aptSvc
    deactivate aptSvc
    alt available doctor found
      aptSvc -> aptSvc : 11. Generate appointment code
      activate aptSvc
      deactivate aptSvc

      aptSvc -> db : 12. INSERT Appointment
      activate db
      db --> aptSvc : 13. return Appointment
      deactivate db

      aptSvc -> db : 14. INSERT AppointmentStatusHistory
      activate db
      db --> aptSvc : 15. return AppointmentStatusHistory
      deactivate db

      aptSvc --> ctrl : 16. return Appointment

      ctrl --> form : 17. 201 Created { Appointment }

      form --> patient : 18. Show booking confirmation

      patient -> ctrl : 19. POST /api/v1/appointments/:id/notifications/confirmation

      ctrl -> aptSvc : 20. sendConfirmation(appointmentId)

      aptSvc -> db : 21. SELECT Appointment WHERE appointment_id
      activate db
      db --> aptSvc : 22. return Appointment
      deactivate db

      aptSvc -> aptSvc : 23. Build notification payload
      activate aptSvc
      deactivate aptSvc

      aptSvc -> notifPub : 24. sendAppointmentConfirmation(payload)
      activate notifPub
      notifPub --> aptSvc : 25. return AppointmentNotificationPayload
      deactivate notifPub

      aptSvc --> ctrl : 26. return AppointmentNotificationPayload
      deactivate aptSvc

      ctrl --> patient : 27. 202 Accepted
      deactivate ctrl

      deactivate form
    else no available doctor on preferred date
      aptSvc --> ctrl : 28. throw BadRequestException
      deactivate aptSvc
      ctrl --> form : 29. 400 { No scheduled doctors found }
      deactivate ctrl
      form --> patient : 30. Show no availability message
      deactivate form
    end
  else no doctors found for specialty
    aptSvc --> ctrl : 31. throw BadRequestException
    deactivate aptSvc
    ctrl --> form : 32. 400 { No doctors found for specialty }
    deactivate ctrl
    form --> patient : 33. Show no doctors message
  end
else validation fails
  form --> patient : 34. Show validation errors
  deactivate form
end

deactivate patient

@enduml
