@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select specialty, date, time,\nenter chief complaint
activate user
activate page

user -> page : 2. Click "Book Appointment"
page -> page : 3. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 4. POST /api/v1/appointments/by-specialty\nBookBySpecialtyDto
  activate ctrl

  ctrl -> aptSvc : 5. createBySpecialty(BookBySpecialtyDto)
  activate aptSvc

  aptSvc -> aptEntity : 6. find(DoctorSpecialty WHERE specialty_id)
  activate aptEntity
  aptEntity -> db : 7. SELECT * FROM doctor_specialties WHERE specialty_id
  activate db
  db --> aptEntity : 8. return rows
  deactivate db
  aptEntity --> aptSvc : 9. return DoctorSpecialty[]
  deactivate aptEntity

  aptSvc -> aptSvc : 10. check doctors found for specialty
  activate aptSvc
  deactivate aptSvc
  alt doctors found
    aptSvc -> aptEntity : 11. findOne(DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status)
    activate aptEntity
    aptEntity -> db : 12. SELECT * FROM doctor_schedules WHERE conditions
    activate db
    db --> aptEntity : 13. return row
    deactivate db
    aptEntity --> aptSvc : 14. return DoctorSchedule
    deactivate aptEntity

    aptSvc -> aptSvc : 15. check available doctor found
    activate aptSvc
    deactivate aptSvc
    alt available doctor found
      aptSvc -> kyc : 16. assertCanBook(created_by)
      activate kyc
      kyc --> aptSvc : 17. return eligible
      deactivate kyc

      aptSvc -> aptSvc : 18. generateAppointmentCode()
      activate aptSvc
      deactivate aptSvc

      aptSvc -> aptEntity : 19. save(appointment)
      activate aptEntity
      aptEntity -> db : 20. INSERT INTO appointments
      activate db
      db --> aptEntity : 21. return saved row
      deactivate db
      aptEntity --> aptSvc : 22. return Appointment
      deactivate aptEntity

      aptSvc -> histEntity : 23. save(old_status: null, new_status: SCHEDULED)
      activate histEntity
      histEntity -> db : 24. INSERT INTO appointment_status_history
      activate db
      db --> histEntity : 25. return saved row
      deactivate db
      histEntity --> aptSvc : 26. return AppointmentStatusHistory
      deactivate histEntity

      aptSvc --> ctrl : 27. return Appointment

      ctrl --> page : 28. 201 Created { Appointment }

      page --> user : 29. Show booking confirmation
    else no available doctor
      aptSvc --> ctrl : 30. throw BadRequestException
      ctrl --> page : 31. 400 { No scheduled doctors found }
      page --> user : 32. Show no availability message
    end
  else no doctors for specialty
    aptSvc --> ctrl : 33. throw BadRequestException
    deactivate aptSvc
    ctrl --> page : 34. 400 { No doctors found for specialty }
    deactivate ctrl
    page --> user : 35. Show no doctors message
  end
else validation fails
  page --> user : 36. Show validation errors
  deactivate page
end

deactivate user

@enduml
