@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RolesPanel" as form
participant ":RolesController" as ctrl
participant ":RolesService" as roleSvc
entity "RoleEntity" as roleEntity
database "PostgreSQL" as db

user -> form : 1. Open roles management page
activate user
activate form

form -> ctrl : 2. GET /api/v1/roles?page=1&limit=10
activate ctrl

ctrl -> roleSvc : 3. findAll(QueryRoleDto)
activate roleSvc

roleSvc -> roleEntity : 4. findAndCount(filters, pagination)
activate roleEntity
roleEntity -> db : 5. SELECT roles with pagination and search
activate db
db --> roleEntity : 6. return { data: Role[], total }
deactivate db
roleEntity --> roleSvc : 7. return { data: Role[], total }
deactivate roleEntity

roleSvc --> ctrl : 8. return RolesPageResult
deactivate roleSvc

ctrl --> form : 9. 200 OK { data, meta }
deactivate ctrl

form --> user : 10. Display role list
deactivate form

user -> form : 11. Select a role to view detail
activate form

form -> ctrl : 12. GET /api/v1/roles/{id}
activate ctrl

ctrl -> roleSvc : 13. findById(id)
activate roleSvc

roleSvc -> roleEntity : 14. findOne(roleId)
activate roleEntity
roleEntity -> db : 15. SELECT role WHERE role_id
activate db
db --> roleEntity : 16. return result
deactivate db
roleEntity --> roleSvc : 17. return Role
deactivate roleEntity

roleSvc --> ctrl : 18. return RoleEntity
deactivate roleSvc

ctrl --> form : 19. 200 OK RoleEntity
deactivate ctrl

form --> user : 20. Display role detail\n(role_name, description, permissions)
deactivate form

deactivate user

@enduml
