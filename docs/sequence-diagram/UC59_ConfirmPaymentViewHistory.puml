@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-059: Confirm Payment / View Payment History

actor "Staff" as user
boundary "PaymentPanel" as form
participant ":PaymentController" as ctrl
participant ":PaymentService" as paySvc
database "PostgreSQL" as db

user -> form : 1. Open payment history page
activate user
activate form

form -> ctrl : 2. GET /api/v1/payments?patient_id&status&page=1
activate ctrl

ctrl -> paySvc : 3. findAll(QueryPaymentDto)
activate paySvc

paySvc -> db : 4. SELECT payments WHERE filters\nwith payment_transactions relation\nORDER BY created_at DESC
activate db
db --> paySvc : 5. return { data: Payment[], total }
deactivate db

paySvc --> ctrl : 6. return { data, total }
deactivate paySvc

ctrl --> form : 7. 200 OK { data, meta }
deactivate ctrl

form --> user : 8. Display payment list with statuses
deactivate form

user -> form : 9. Select a payment to view detail
activate form

form -> ctrl : 10. GET /api/v1/payments/{id}
activate ctrl

ctrl -> paySvc : 11. findById(id)
activate paySvc

paySvc -> db : 12. SELECT payment WHERE payment_id\nwith transactions relation
activate db
db --> paySvc : 13. return Payment / null
deactivate db

paySvc --> ctrl : 14. return Payment / null
deactivate paySvc

ctrl --> form : 15. 200 OK Payment
deactivate ctrl

form --> user : 16. Display payment detail\n(amount, method, status, transactions, timestamps)
deactivate form

deactivate user

@enduml
