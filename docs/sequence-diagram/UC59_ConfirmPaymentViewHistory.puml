@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-059: Confirm Payment / View Payment History

actor "Staff" as user
boundary "PaymentPanel" as form
participant ":PaymentController" as ctrl
participant ":PaymentService" as paySvc
database "PostgreSQL" as db

user -> form : 1. Open payment history page
activate user
activate form

form -> ctrl : 2. GET /api/v1/payments?patient_id&status&page=1
activate ctrl

ctrl -> paySvc : 3. findAll(QueryPaymentDto)
activate paySvc

paySvc -> db : 4. SELECT payments WHERE filters\nwith payment_transactions relation\nORDER BY created_at DESC
activate db
db --> paySvc : { data: Payment[], total }
deactivate db

paySvc --> ctrl : { data, total }
deactivate paySvc

ctrl --> form : 5. 200 OK { data, meta }
deactivate ctrl

form --> user : 6. Display payment list with statuses
deactivate form

user -> form : 7. Select a payment to view detail
activate form

form -> ctrl : 8. GET /api/v1/payments/{id}
activate ctrl

ctrl -> paySvc : 9. findById(id)
activate paySvc

paySvc -> db : 10. SELECT payment WHERE payment_id\nwith transactions relation
activate db
db --> paySvc : Payment / null
deactivate db

paySvc --> ctrl : Payment / null
deactivate paySvc

ctrl --> form : 11. 200 OK Payment
deactivate ctrl

form --> user : 12. Display payment detail\n(amount, method, status, transactions, timestamps)
deactivate form

deactivate user

@enduml
