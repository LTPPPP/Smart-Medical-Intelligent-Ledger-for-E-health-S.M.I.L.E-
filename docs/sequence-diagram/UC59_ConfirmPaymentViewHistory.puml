@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "PaymentPanel" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Open payment history page
activate user
activate page

page -> ctrl : 2. GET /api/v1/appointments?payment_status&page=1
activate ctrl

ctrl -> aptSvc : 3. findAll(QueryAppointmentDto)
activate aptSvc

aptSvc -> aptEntity : 4. findAndCount(where, relations, skip, take, order)
activate aptEntity
aptEntity -> db : 5. SELECT appointments WHERE filters\nORDER BY created_at DESC
activate db
db --> aptEntity : 6. return rows and count
deactivate db
aptEntity --> aptSvc : 7. return { data: Appointment[], total }
deactivate aptEntity

aptSvc --> ctrl : 8. return { data, total }

ctrl --> page : 9. 200 OK { data, meta }

page --> user : 10. Display appointment list with payment statuses

user -> page : 11. Select an appointment to view detail

page -> ctrl : 12. GET /api/v1/appointments/{id}

ctrl -> aptSvc : 13. findById(id)

aptSvc -> aptEntity : 14. findOne(appointment_id, relations)
activate aptEntity
aptEntity -> db : 15. SELECT * FROM appointments WHERE appointment_id\nwith payment details
activate db
db --> aptEntity : 16. return row
deactivate db
aptEntity --> aptSvc : 17. return Appointment
deactivate aptEntity

aptSvc --> ctrl : 18. return Appointment
deactivate aptSvc
ctrl --> page : 19. 200 OK { Appointment }

deactivate ctrl
page --> user : 20. Display appointment payment detail\n(amount, method, status, timestamps)


deactivate page
deactivate user

@enduml
