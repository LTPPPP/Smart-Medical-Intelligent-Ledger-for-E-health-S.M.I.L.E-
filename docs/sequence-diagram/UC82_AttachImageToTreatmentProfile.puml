@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "TreatmentProfilePanel" as form
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as imgSvc
entity "DentalImageEntity" as dentalImageEntity
database "PostgreSQL" as db

user -> form : 1. Select image and click "Attach to Record"
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/dental-images/{image_id}\n{ record_id: treatmentRecordId }
activate ctrl

ctrl -> imgSvc : 3. update(image_id, { record_id })
activate imgSvc

imgSvc -> dentalImageEntity : 4. findById(image_id)
activate dentalImageEntity
dentalImageEntity -> db : 5. SELECT dental_image WHERE image_id
activate db
db --> dentalImageEntity : 6. return result
deactivate db
dentalImageEntity --> imgSvc : 7. return DentalImageEntity
deactivate dentalImageEntity

imgSvc -> imgSvc : 8. check image exists
activate imgSvc
deactivate imgSvc
alt image found
  imgSvc -> dentalImageEntity : 9. update(image_id, { record_id })
  activate dentalImageEntity
  dentalImageEntity -> db : 10. UPDATE dental_image SET record_id
  activate db
  db --> dentalImageEntity : 11. return result
  deactivate db
  dentalImageEntity --> imgSvc : 12. return DentalImageEntity
  deactivate dentalImageEntity

  imgSvc --> ctrl : 13. return DentalImageEntity
  ctrl --> form : 14. 200 OK DentalImageEntity
  form --> user : 15. Display image attached to record confirmation
else image not found
  imgSvc --> ctrl : 16. throw NotFoundException
  deactivate imgSvc
  ctrl --> form : 17. 404 { message: Image not found }
  deactivate ctrl
  form --> user : 18. Show not found error
  deactivate form
end

deactivate user

@enduml
