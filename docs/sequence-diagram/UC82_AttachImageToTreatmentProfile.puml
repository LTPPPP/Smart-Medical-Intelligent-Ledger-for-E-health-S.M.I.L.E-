@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-082: Attach Image to Treatment Profile

actor "Doctor" as user
boundary "TreatmentProfilePanel" as form
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as imgSvc
database "PostgreSQL" as db

user -> form : 1. Select image and click "Attach to Record"
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/dental-images/{image_id}\n{ record_id: treatmentRecordId }
activate ctrl

ctrl -> imgSvc : 3. update(image_id, { record_id })
activate imgSvc

imgSvc -> db : 4. SELECT dental_image WHERE image_id
activate db
db --> imgSvc : 5. return DentalImageEntity / null
deactivate db

imgSvc -> imgSvc : 6. check image exists
activate imgSvc
deactivate imgSvc
alt image found
  imgSvc -> db : 7. UPDATE dental_image SET record_id
  activate db
  db --> imgSvc : 8. return updated DentalImageEntity
  deactivate db

  imgSvc --> ctrl : 9. return DentalImageEntity
  deactivate imgSvc

  ctrl --> form : 10. 200 OK DentalImageEntity
  deactivate ctrl

  form --> user : 11. Display image attached to record confirmation
  deactivate form
else image not found
  imgSvc --> ctrl : 12. throw NotFoundException
  deactivate imgSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Image not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
