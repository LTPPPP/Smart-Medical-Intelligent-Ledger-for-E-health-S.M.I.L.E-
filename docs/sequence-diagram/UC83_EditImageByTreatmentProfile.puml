@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ImageDetailPanel" as form
participant ":ImageAnnotationsController" as ctrl
participant ":ImageAnnotationsService" as annotSvc
entity "ImageAnnotationEntity" as imageAnnotationEntity
entity "DentalImageEntity" as dentalImageEntity
database "PostgreSQL" as db

user -> form : 1. Edit image annotation\n(annotation_type, content, coordinates)
activate user
activate form

user -> form : 2. Click "Save Changes"
form -> ctrl : 3. PATCH /api/v1/image-annotations/{annotation_id}\nUpdateImageAnnotationDto
activate ctrl

ctrl -> annotSvc : 4. update(annotation_id, UpdateImageAnnotationDto)
activate annotSvc

annotSvc -> imageAnnotationEntity : 5. findById(annotation_id)
activate imageAnnotationEntity
imageAnnotationEntity -> db : 6. SELECT image_annotation WHERE annotation_id
activate db
db --> imageAnnotationEntity : 7. return result
deactivate db
imageAnnotationEntity --> annotSvc : 8. return ImageAnnotationEntity
deactivate imageAnnotationEntity

annotSvc -> annotSvc : 9. check annotation exists
activate annotSvc
deactivate annotSvc
alt annotation found
  annotSvc -> imageAnnotationEntity : 10. update(annotation_id, updatedFields)
  activate imageAnnotationEntity
  imageAnnotationEntity -> db : 11. UPDATE image_annotation SET changed fields
  activate db
  db --> imageAnnotationEntity : 12. return result
  deactivate db
  imageAnnotationEntity --> annotSvc : 13. return ImageAnnotationEntity
  deactivate imageAnnotationEntity

  annotSvc -> dentalImageEntity : 14. updateModifiedAt(image_id)
  activate dentalImageEntity
  dentalImageEntity -> db : 15. UPDATE dental_image SET modified_at
  activate db
  db --> dentalImageEntity : 16. return result
  deactivate db
  dentalImageEntity --> annotSvc : 17. return DentalImageEntity
  deactivate dentalImageEntity

  annotSvc --> ctrl : 18. return ImageAnnotationEntity

  ctrl --> form : 19. 200 OK ImageAnnotationEntity
  form --> user : 20. Display updated annotation
else annotation not found
  annotSvc --> ctrl : 21. throw NotFoundException
  deactivate annotSvc
  ctrl --> form : 22. 404 { message: Annotation not found }
  deactivate ctrl
  form --> user : 23. Show not found error
  deactivate form
end

deactivate user

@enduml
