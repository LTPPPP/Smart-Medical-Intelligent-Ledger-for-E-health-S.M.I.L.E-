@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC 8: Confirm Appointment

actor "Receptionist" as user
boundary "AppointmentListPage" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as svc
database "PostgreSQL" as db
participant ":AppointmentNotificationPublisher" as notifPub

user -> page : 1. View pending appointments list
activate user
activate page

page -> ctrl : 2. GET /api/v1/appointments?status=scheduled
activate ctrl

ctrl -> svc : 3. findAll(QueryAppointmentDto)
activate svc

svc -> db : 4. findAndCount(where: {status: scheduled})
activate db
db --> svc : [AppointmentEntity[], total]
deactivate db

svc --> ctrl : 5. {data: AppointmentEntity[], total}
deactivate svc

ctrl --> page : 6. 200 OK — appointment list
deactivate ctrl

page --> user : 7. Display pending appointments
deactivate page

user -> page : 8. Select appointment and click Confirm
activate page

page -> ctrl : 9. PATCH /api/v1/appointments/:id/confirm\n{changed_by: receptionistId}
activate ctrl

ctrl -> ctrl : 10. validate changed_by is present
activate ctrl
deactivate ctrl

alt changed_by is provided
  ctrl -> svc : 11. confirm(id, changedBy)
  activate svc

  svc -> svc : 12. changeStatus(id, {status: CONFIRMED, changed_by, reason})
  activate svc
  deactivate svc

  svc -> db : 13. findOne(appointment_id)
  activate db
  db --> svc : AppointmentEntity / null
  deactivate db

  alt appointment exists
    svc -> db : 14. save(appointment with status = CONFIRMED)
    activate db
    db --> svc : AppointmentEntity
    deactivate db

    svc -> db : 15. save(AppointmentStatusHistoryEntity)
    activate db
    db --> svc : AppointmentStatusHistoryEntity
    deactivate db

    svc --> ctrl : 16. AppointmentEntity
    deactivate svc

    ctrl -> svc : 17. sendConfirmation(id)
    activate svc

    svc -> db : 18. findOne(appointment_id)
    activate db
    db --> svc : AppointmentEntity
    deactivate db

    svc -> notifPub : 19. sendAppointmentConfirmation(payload)
    activate notifPub
    notifPub --> svc : 20. AppointmentNotificationPayload
    deactivate notifPub

    svc --> ctrl : 21. AppointmentNotificationPayload
    deactivate svc

    ctrl --> page : 22. 200 OK — confirmed appointment
    deactivate ctrl

    page --> user : 23. Display confirmation success
    deactivate page
  else appointment not found
    activate svc
    svc --> ctrl : 24. throw NotFoundException
    deactivate svc
    activate ctrl
    ctrl --> page : 25. 404 Not Found
    activate page
    deactivate ctrl
    page --> user : 26. Show error message
    deactivate page
  end
else changed_by is missing
  ctrl --> page : 27. 400 Bad Request
  activate page
  deactivate ctrl
  page --> user : 28. Show validation error
  deactivate page
end

deactivate user

@enduml
