@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select doctor, clinic, date,\ntime, service and submit
activate user
activate page

page -> page : 2. validate input
activate page
deactivate page
alt validation passes
  page -> ctrl : 3. POST /api/v1/appointments/by-doctor\nBookByDoctorDto
  activate ctrl

  ctrl -> aptSvc : 4. createByDoctor(BookByDoctorDto)
  activate aptSvc

  aptSvc -> aptEntity : 5. findOne(DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status = 'scheduled')
  activate aptEntity
  aptEntity -> db : 6. SELECT * FROM doctor_schedules WHERE conditions
  activate db
  db --> aptEntity : 7. return row
  deactivate db
  aptEntity --> aptSvc : 8. return DoctorSchedule
  deactivate aptEntity

  aptSvc -> aptSvc : 9. check doctor has schedule on requested date
  activate aptSvc
  deactivate aptSvc
  alt doctor is available
    aptSvc -> kyc : 10. assertCanBook(created_by)
    activate kyc
    kyc --> aptSvc : 11. return eligible
    deactivate kyc

    aptSvc -> aptSvc : 12. generateAppointmentCode()
    activate aptSvc
    deactivate aptSvc

    aptSvc -> aptEntity : 13. save(appointment)
    activate aptEntity
    aptEntity -> db : 14. INSERT INTO appointments
    activate db
    db --> aptEntity : 15. return saved row
    deactivate db
    aptEntity --> aptSvc : 16. return Appointment
    deactivate aptEntity

    aptSvc -> histEntity : 17. save(old_status: null, new_status: SCHEDULED)
    activate histEntity
    histEntity -> db : 18. INSERT INTO appointment_status_history
    activate db
    db --> histEntity : 19. return saved row
    deactivate db
    histEntity --> aptSvc : 20. return AppointmentStatusHistory
    deactivate histEntity

    aptSvc --> ctrl : 21. return Appointment

    ctrl --> page : 22. 201 Created { Appointment }

    page --> user : 23. Show booking confirmation
  else doctor not available on requested date
    aptSvc --> ctrl : 24. throw BadRequestException
    deactivate aptSvc
    ctrl --> page : 25. 400 { Doctor not available }
    deactivate ctrl
    page --> user : 26. Show no availability message
  end
else validation fails
  page --> user : 27. Show validation errors
  deactivate page
end

deactivate user

@enduml
