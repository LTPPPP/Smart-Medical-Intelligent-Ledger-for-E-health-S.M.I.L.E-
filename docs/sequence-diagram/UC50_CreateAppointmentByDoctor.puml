@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-050: Create Appointment by Doctor

actor "Patient" as patient
boundary "BookingForm" as form
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
database "PostgreSQL" as db

patient -> form : 1. Select doctor, clinic, date,\ntime, service and submit
activate patient
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/appointments/by-doctor\n{ doctor_id, clinic_id, appointment_date, appointment_time, ... }
  activate ctrl

  ctrl -> aptSvc : 4. createByDoctor(BookByDoctorDto)
  activate aptSvc

  aptSvc -> db : 5. SELECT doctor_schedule WHERE doctor_id\nAND clinic_id AND work_date AND status = 'scheduled'
  activate db
  db --> aptSvc : 6. return DoctorScheduleEntity / null
  deactivate db

  aptSvc -> aptSvc : 7. check doctor has schedule on requested date
  activate aptSvc
  deactivate aptSvc
  alt doctor is available
    aptSvc -> kyc : 8. assertCanBook(created_by)
    activate kyc
    kyc --> aptSvc : 9. return eligible
    deactivate kyc

    aptSvc -> aptSvc : 10. Generate appointment code (APT-YYYYMMDD-XXXX)
    activate aptSvc
    deactivate aptSvc

    aptSvc -> db : 11. INSERT appointment\n{ patient_id, doctor_id, clinic_id, appointment_code, ... }
    activate db
    db --> aptSvc : 12. return AppointmentEntity
    deactivate db

    aptSvc -> db : 13. INSERT appointment_status_history\n{ old_status: null, new_status: SCHEDULED }
    activate db
    db --> aptSvc : 14. return AppointmentStatusHistoryEntity
    deactivate db

    aptSvc --> ctrl : 15. return AppointmentEntity
    deactivate aptSvc

    ctrl --> form : 16. 201 Created AppointmentEntity
    deactivate ctrl

    form --> patient : 17. Show booking confirmation
    deactivate form
  else doctor not available on requested date
    aptSvc --> ctrl : 18. throw BadRequestException\n("Doctor has no scheduled availability at clinic on date")
    deactivate aptSvc
    activate ctrl
    ctrl --> form : 19. 400 { message: Doctor not available }
    deactivate ctrl
    activate form
    form --> patient : 20. Show no availability message
    deactivate form
  end
else validation fails
  form --> patient : 21. Show validation errors
  deactivate form
end

deactivate patient

@enduml
