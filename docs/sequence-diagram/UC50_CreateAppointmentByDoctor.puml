@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "BookingForm" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":KycEligibilityClient" as kyc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select doctor, clinic, date,\ntime, service
activate user
activate page

user -> page : 2. Click "Book Appointment"
page -> page : 3. validate: doctor_id, patient_id, clinic_id\nand created_by are not empty,\nappointment_date is a valid ISO date,\nappointment_time is not empty,\nduration_minutes is an integer >= 5 if provided
activate page
deactivate page
alt validation passes
  page -> ctrl : 4. POST /api/v1/appointments/by-doctor\nBookByDoctorDto
  activate ctrl

  ctrl -> aptSvc : 5. createByDoctor(BookByDoctorDto)
  activate aptSvc

  aptSvc -> aptEntity : 6. findOne(DoctorSchedule WHERE doctor_id\nAND clinic_id AND work_date AND status = 'scheduled')
  activate aptEntity
  aptEntity -> db : 7. SELECT * FROM doctor_schedules WHERE conditions
  activate db
  db --> aptEntity : 8. return row
  deactivate db
  aptEntity --> aptSvc : 9. return DoctorSchedule
  deactivate aptEntity

  aptSvc -> aptSvc : 10. check doctor has schedule on requested date
  activate aptSvc
  deactivate aptSvc
  alt doctor is available
    aptSvc -> kyc : 11. assertCanBook(created_by)
    activate kyc
    kyc --> aptSvc : 12. return eligible
    deactivate kyc

    aptSvc -> aptSvc : 13. generateAppointmentCode()
    activate aptSvc
    deactivate aptSvc

    aptSvc -> aptEntity : 14. save(appointment)
    activate aptEntity
    aptEntity -> db : 15. INSERT INTO appointments
    activate db
    db --> aptEntity : 16. return saved row
    deactivate db
    aptEntity --> aptSvc : 17. return Appointment
    deactivate aptEntity

    aptSvc -> histEntity : 18. save(old_status: null, new_status: SCHEDULED)
    activate histEntity
    histEntity -> db : 19. INSERT INTO appointment_status_history
    activate db
    db --> histEntity : 20. return saved row
    deactivate db
    histEntity --> aptSvc : 21. return AppointmentStatusHistory
    deactivate histEntity

    aptSvc --> ctrl : 22. return Appointment

    ctrl --> page : 23. 201 Created { Appointment }

    page --> user : 24. Show booking confirmation
  else doctor not available on requested date
    aptSvc --> ctrl : 25. throw BadRequestException
    deactivate aptSvc
    ctrl --> page : 26. 400 { Doctor not available }
    deactivate ctrl
    page --> user : 27. Show no availability message
  end
else validation fails
  page --> user : 28. Show validation errors
  deactivate page
end

deactivate user

@enduml
