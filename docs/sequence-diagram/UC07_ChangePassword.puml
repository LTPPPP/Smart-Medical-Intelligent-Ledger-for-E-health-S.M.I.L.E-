@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ChangePasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

user -> form : 1. Enter old password and new password
activate user
activate form

user -> form : 2. Click "Change Password"

form -> form : 3. validate: oldPassword is not empty,\nnewPassword is not empty and >= 8 characters,\nconfirmPassword equals newPassword
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. PATCH /api/v1/auth/me\n{ oldPassword, password }
  activate ctrl

  ctrl -> ctrl : 5. Validate JWT (AuthGuard)
  activate ctrl
  deactivate ctrl

  ctrl -> ctrl : 6. Extract accountId from JWT
  activate ctrl
  deactivate ctrl

  ctrl -> authSvc : 7. update(accountId, { oldPassword, password })
  activate authSvc

  authSvc -> accSvc : 8. findById(accountId)
  activate accSvc

  accSvc -> accEntity : 9. findOne(accountId)
  activate accEntity
  accEntity -> db : 10. SELECT account WHERE accountId
  activate db
  db --> accEntity : 11. return result
  deactivate db
  accEntity --> accSvc : 12. return Account
  deactivate accEntity

  accSvc --> authSvc : 13. return Account

  authSvc -> authSvc : 14. compare(oldPassword, passwordHash)
  activate authSvc
  deactivate authSvc
  alt old password matches
    authSvc -> accSvc : 15. update(accountId, { password })

    accSvc -> accSvc : 16. Hash new password
    activate accSvc
    deactivate accSvc

    accSvc -> accEntity : 17. save(accountId, passwordHash)
    activate accEntity
    accEntity -> db : 18. UPDATE account SET password
    activate db
    db --> accEntity : 19. return updated row
    deactivate db
    accEntity --> accSvc : 20. return Account
    deactivate accEntity

    accSvc --> authSvc : 21. return Account
    deactivate accSvc

    authSvc --> ctrl : 22. return Account

    ctrl --> form : 23. 200 OK

    form --> user : 24. Show password changed successfully
  else old password does not match
    authSvc --> ctrl : 25. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 26. 422 { oldPassword: incorrectOldPassword }
    deactivate ctrl

    form --> user : 27. Show incorrect password error
  end
else validation fails
  form --> user : 28. Show validation errors
  deactivate form
end

deactivate user

@enduml
