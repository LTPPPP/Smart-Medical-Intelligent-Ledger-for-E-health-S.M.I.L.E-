@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-007: Change Password

actor "User" as user
boundary "ChangePasswordForm" as form
participant ":AuthController" as ctrl
participant "JwtAuthGuard" as guard
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
database "PostgreSQL" as db

user -> form : 1. Enter old password and new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. PATCH /api/v1/auth/me\n{ oldPassword, password }
  activate ctrl

  ctrl -> guard : 4. Validate JWT from Authorization header
  activate guard

  guard -> guard : 5. check token validity
  activate guard
  deactivate guard
  alt JWT is valid
    guard --> ctrl : 6. request.user { accountId }
    deactivate guard

    ctrl -> authSvc : 7. update(accountId, { oldPassword, password })
    activate authSvc

    authSvc -> accSvc : 8. findById(accountId)
    activate accSvc
    accSvc -> db : 9. SELECT account WHERE accountId
    activate db
    db --> accSvc : Account / null
    deactivate db
    accSvc --> authSvc : Account
    deactivate accSvc

    authSvc -> authSvc : 10. compare(oldPassword, passwordHash)
    activate authSvc
    deactivate authSvc
    alt old password matches
      authSvc -> accSvc : 11. update(accountId, { password })
      activate accSvc

      accSvc -> accSvc : 12. Hash new password
      activate accSvc
      deactivate accSvc

      accSvc -> db : 13. UPDATE account SET password
      activate db
      db --> accSvc : Account
      deactivate db
      accSvc --> authSvc : Account
      deactivate accSvc

      authSvc --> ctrl : Account
      deactivate authSvc

      ctrl --> form : 14. 200 OK
      deactivate ctrl

      form --> user : 15. Show password changed successfully
      deactivate form
    else old password does not match
      authSvc --> ctrl : 16. throw UnprocessableEntityException
      deactivate authSvc
      activate ctrl
      ctrl --> form : 17. 422 { oldPassword: incorrectOldPassword }
      deactivate ctrl
      activate form
      form --> user : 18. Show incorrect password error
      deactivate form
    end
  else JWT is invalid
    activate guard
    guard --> ctrl : 19. throw UnauthorizedException
    deactivate guard
    ctrl --> form : 20. 401 Unauthorized
    deactivate ctrl
    activate form
    form --> user : 21. Redirect to login
    deactivate form
  end
else validation fails
  form --> user : 22. Show validation errors
  deactivate form
end

deactivate user

@enduml
