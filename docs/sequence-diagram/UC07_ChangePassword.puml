@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ChangePasswordForm" as form
participant ":AuthController" as ctrl
participant ":AuthService" as authSvc
participant ":AccountsService" as accSvc
entity "AccountEntity" as accEntity
database "PostgreSQL" as db

user -> form : 1. Enter old password and new password
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. PATCH /api/v1/auth/me\n{ oldPassword, password }
  activate ctrl

  ctrl -> ctrl : 4. Validate JWT (AuthGuard)
  activate ctrl
  deactivate ctrl

  ctrl -> ctrl : 5. Extract accountId from JWT
  activate ctrl
  deactivate ctrl

  ctrl -> authSvc : 6. update(accountId, { oldPassword, password })
  activate authSvc

  authSvc -> accSvc : 7. findById(accountId)
  activate accSvc

  accSvc -> accEntity : 8. findOne(accountId)
  activate accEntity
  accEntity -> db : 9. SELECT account WHERE accountId
  activate db
  db --> accEntity : 10. return result
  deactivate db
  accEntity --> accSvc : 11. return Account
  deactivate accEntity

  accSvc --> authSvc : 12. return Account

  authSvc -> authSvc : 13. compare(oldPassword, passwordHash)
  activate authSvc
  deactivate authSvc
  alt old password matches
    authSvc -> accSvc : 14. update(accountId, { password })

    accSvc -> accSvc : 15. Hash new password
    activate accSvc
    deactivate accSvc

    accSvc -> accEntity : 16. save(accountId, passwordHash)
    activate accEntity
    accEntity -> db : 17. UPDATE account SET password
    activate db
    db --> accEntity : 18. return updated row
    deactivate db
    accEntity --> accSvc : 19. return Account
    deactivate accEntity

    accSvc --> authSvc : 20. return Account
    deactivate accSvc

    authSvc --> ctrl : 21. return Account

    ctrl --> form : 22. 200 OK

    form --> user : 23. Show password changed successfully
  else old password does not match
    authSvc --> ctrl : 24. throw UnprocessableEntityException
    deactivate authSvc

    ctrl --> form : 25. 422 { oldPassword: incorrectOldPassword }
    deactivate ctrl

    form --> user : 26. Show incorrect password error
  end
else validation fails
  form --> user : 27. Show validation errors
  deactivate form
end

deactivate user

@enduml
