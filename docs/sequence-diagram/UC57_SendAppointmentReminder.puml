@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-057: Send Appointment Reminder

actor "Staff" as user
boundary "AppointmentDetailPanel" as form
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
participant ":AppointmentNotificationPublisher" as notifPub
database "PostgreSQL" as db

user -> form : 1. Click "Send Reminder"
activate user
activate form

form -> ctrl : 2. POST /api/v1/appointments/{id}/notifications/reminder
activate ctrl

ctrl -> aptSvc : 3. sendReminder(id)
activate aptSvc

aptSvc -> db : 4. SELECT appointment WHERE appointment_id\nwith relations
activate db
db --> aptSvc : AppointmentEntity / null
deactivate db

aptSvc -> aptSvc : 5. check appointment exists
activate aptSvc
deactivate aptSvc
alt appointment found
  aptSvc -> aptSvc : 6. buildNotificationPayload\n(appointment, APPOINTMENT_REMINDER)
  activate aptSvc
  deactivate aptSvc

  aptSvc -> notifPub : 7. sendAppointmentReminder(payload)
  activate notifPub
  notifPub --> aptSvc : AppointmentNotificationPayload
  deactivate notifPub

  aptSvc --> ctrl : AppointmentNotificationPayload
  deactivate aptSvc

  ctrl --> form : 8. 202 Accepted
  deactivate ctrl

  form --> user : 9. Display reminder sent confirmation
  deactivate form
else appointment not found
  aptSvc --> ctrl : 10. throw NotFoundException
  deactivate aptSvc
  activate ctrl
  ctrl --> form : 11. 404 { message: Appointment not found }
  deactivate ctrl
  activate form
  form --> user : 12. Show not found error
  deactivate form
end

deactivate user

@enduml
