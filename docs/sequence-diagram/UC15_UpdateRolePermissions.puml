@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RolePermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
entity "RolePermissionEntity" as rpEntity
database "PostgreSQL" as db

user -> form : 1. Select role and permission to assign
activate user
activate form

form -> ctrl : 2. POST /api/v1/permissions/role/{roleId}\n{ permission_id }
activate ctrl

ctrl -> permSvc : 3. assignPermissionToRole(roleId, permissionId)
activate permSvc

permSvc -> rpEntity : 4. findOne(roleId, permissionId)
activate rpEntity
rpEntity -> db : 5. SELECT role_permission\nWHERE role_id AND permission_id
activate db
db --> rpEntity : 6. return result
deactivate db
rpEntity --> permSvc : 7. return RolePermission
deactivate rpEntity

permSvc -> permSvc : 8. check permission already assigned
activate permSvc
deactivate permSvc
alt permission not yet assigned
  permSvc -> rpEntity : 9. save(roleId, permissionId)
  activate rpEntity
  rpEntity -> db : 10. INSERT INTO role_permissions
  activate db
  db --> rpEntity : 11. return saved row
  deactivate db
  rpEntity --> permSvc : 12. return RolePermission
  deactivate rpEntity

  permSvc --> ctrl : 13. return RolePermissionEntity
  deactivate permSvc

  ctrl --> form : 14. 201 Created RolePermissionEntity
  deactivate ctrl

  form --> user : 15. Display permission assigned confirmation
else permission already assigned
  permSvc --> ctrl : 16. throw ConflictException
  deactivate permSvc

  ctrl --> form : 17. 409 { message: Permission already assigned to this role }
  deactivate ctrl

  form --> user : 18. Display conflict error
end

deactivate user

@enduml
