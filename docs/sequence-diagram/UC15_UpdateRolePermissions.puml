@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "RolePermissionsPanel" as form
participant ":PermissionsController" as ctrl
participant ":PermissionsService" as permSvc
entity "RolePermissionEntity" as rpEntity
database "PostgreSQL" as db

user -> form : 1. Select role and permission to assign
activate user
activate form

user -> form : 2. Click "Assign Permission"

form -> form : 3. validate: a role is selected and\nat least one permission is selected
activate form
deactivate form

form -> ctrl : 4. POST /api/v1/permissions/role/{roleId}\n{ permission_id }
activate ctrl

ctrl -> permSvc : 5. assignPermissionToRole(roleId, permissionId)
activate permSvc

permSvc -> rpEntity : 6. findOne(roleId, permissionId)
activate rpEntity
rpEntity -> db : 7. SELECT role_permission\nWHERE role_id AND permission_id
activate db
db --> rpEntity : 8. return result
deactivate db
rpEntity --> permSvc : 9. return RolePermission
deactivate rpEntity

permSvc -> permSvc : 10. check permission already assigned
activate permSvc
deactivate permSvc
alt permission not yet assigned
  permSvc -> rpEntity : 11. save(roleId, permissionId)
  activate rpEntity
  rpEntity -> db : 12. INSERT INTO role_permissions
  activate db
  db --> rpEntity : 13. return saved row
  deactivate db
  rpEntity --> permSvc : 14. return RolePermission
  deactivate rpEntity

  permSvc --> ctrl : 15. return RolePermissionEntity
  deactivate permSvc

  ctrl --> form : 16. 201 Created RolePermissionEntity
  deactivate ctrl

  form --> user : 17. Display permission assigned confirmation
else permission already assigned
  permSvc --> ctrl : 18. throw ConflictException
  deactivate permSvc

  ctrl --> form : 19. 409 { message: Permission already assigned to this role }
  deactivate ctrl

  form --> user : 20. Display conflict error
end

deactivate user

@enduml
