@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "DentalImageUploadPage" as page
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as svc
entity "DentalImageEntity" as dentalImageEntity
participant "S3Storage" as s3
database "PostgreSQL" as db

user -> page : 1. Select patient record and\nchoose X-ray/CBCT image file
activate user
activate page

page -> page : 2. Validate file type and size
activate page
deactivate page
alt file is valid
  page -> s3 : 3. Upload X-ray/CBCT image to S3 bucket
  activate s3

  s3 -> s3 : 4. check upload result
  activate s3
  deactivate s3
  alt upload succeeds
    s3 --> page : 5. return image_url, thumbnail_url
    deactivate s3

    page -> ctrl : 6. POST /api/v1/dental-images\n{ patient_id, record_id, image_url,\ncategory: XRAY/CBCT, description }
    activate ctrl

    ctrl -> svc : 7. create(CreateDentalImageDto)
    activate svc

    svc -> dentalImageEntity : 8. save(dentalImageData)
    activate dentalImageEntity
    dentalImageEntity -> db : 9. INSERT dental_image
    activate db
    db --> dentalImageEntity : 10. return result
    deactivate db
    dentalImageEntity --> svc : 11. return DentalImageEntity
    deactivate dentalImageEntity

    svc --> ctrl : 12. return DentalImageEntity
    deactivate svc

    ctrl --> page : 13. 201 Created DentalImageEntity
    deactivate ctrl

    page --> user : 14. Display uploaded X-ray/CBCT image
  else upload fails
    s3 --> page : 15. return StorageError
    deactivate s3

    page --> user : 16. Show upload failed error
  end
else file is invalid
  page --> user : 17. Show file validation error
  deactivate page
end

deactivate user

@enduml
