@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Dentist" as user
boundary "DentalImageUploadPage" as page
participant ":DentalImagesController" as ctrl
participant ":DentalImagesService" as svc
entity "DentalImageEntity" as dentalImageEntity
participant "S3Storage" as s3
database "PostgreSQL" as db

user -> page : 1. Select patient record and\nchoose X-ray/CBCT image file
activate user
activate page

user -> page : 2. Click "Upload"
page -> page : 3. validate: a patient record is selected,\nfile format is an accepted image type,\nfile size is within the upload limit,\ntooth_numbers is an array of integers if provided
activate page
deactivate page
alt file is valid
  page -> s3 : 4. Upload X-ray/CBCT image to S3 bucket
  activate s3

  s3 -> s3 : 5. check upload result
  activate s3
  deactivate s3
  alt upload succeeds
    s3 --> page : 6. return image_url, thumbnail_url
    deactivate s3

    page -> ctrl : 7. POST /api/v1/dental-images\n{ patient_id, record_id, image_url,\ncategory: XRAY/CBCT, description }
    activate ctrl

    ctrl -> svc : 8. create(CreateDentalImageDto)
    activate svc

    svc -> dentalImageEntity : 9. save(dentalImageData)
    activate dentalImageEntity
    dentalImageEntity -> db : 10. INSERT dental_image
    activate db
    db --> dentalImageEntity : 11. return result
    deactivate db
    dentalImageEntity --> svc : 12. return DentalImageEntity
    deactivate dentalImageEntity

    svc --> ctrl : 13. return DentalImageEntity
    deactivate svc

    ctrl --> page : 14. 201 Created DentalImageEntity
    deactivate ctrl

    page --> user : 15. Display uploaded X-ray/CBCT image
  else upload fails
    s3 --> page : 16. return StorageError
    deactivate s3

    page --> user : 17. Show upload failed error
  end
else file is invalid
  page --> user : 18. Show file validation error
  deactivate page
end

deactivate user

@enduml
