@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-053: Edit Appointment

actor "Staff" as user
boundary "AppointmentDetailPanel" as form
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
database "PostgreSQL" as db

user -> form : 1. Edit appointment fields\n(date, time, doctor, room, notes) and submit
activate user
activate form

form -> ctrl : 2. PATCH /api/v1/appointments/{id}\nUpdateAppointmentDto
activate ctrl

ctrl -> aptSvc : 3. update(id, UpdateAppointmentDto)
activate aptSvc

aptSvc -> db : 4. SELECT appointment WHERE appointment_id\nwith relations
activate db
db --> aptSvc : 5. return AppointmentEntity / null
deactivate db

aptSvc -> aptSvc : 6. check appointment exists
activate aptSvc
deactivate aptSvc
alt appointment found
  aptSvc -> db : 7. UPDATE appointment SET changed fields
  activate db
  db --> aptSvc : 8. return updated AppointmentEntity
  deactivate db

  aptSvc --> ctrl : 9. return AppointmentEntity
  deactivate aptSvc

  ctrl --> form : 10. 200 OK AppointmentEntity
  deactivate ctrl

  form --> user : 11. Display updated appointment
  deactivate form
else appointment not found
  aptSvc --> ctrl : 12. throw NotFoundException
  deactivate aptSvc
  activate ctrl
  ctrl --> form : 13. 404 { message: Appointment not found }
  deactivate ctrl
  activate form
  form --> user : 14. Show not found error
  deactivate form
end

deactivate user

@enduml
