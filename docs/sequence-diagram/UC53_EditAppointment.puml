@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "AppointmentDetailPanel" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Edit appointment fields\n(date, time, doctor, room, notes)
activate user
activate page

user -> page : 2. Click "Save Changes"
page -> ctrl : 3. PATCH /api/v1/appointments/{id}\nUpdateAppointmentDto
activate ctrl

ctrl -> aptSvc : 4. update(id, UpdateAppointmentDto)
activate aptSvc

aptSvc -> aptEntity : 5. findOne(appointment_id, relations)
activate aptEntity
aptEntity -> db : 6. SELECT appointment WHERE appointment_id
activate db
db --> aptEntity : 7. return row
deactivate db
aptEntity --> aptSvc : 8. return Appointment
deactivate aptEntity

aptSvc -> aptSvc : 9. check appointment exists
activate aptSvc
deactivate aptSvc
alt appointment found
  aptSvc -> aptEntity : 10. save(updated appointment)
  activate aptEntity
  aptEntity -> db : 11. UPDATE appointments SET changed fields
  activate db
  db --> aptEntity : 12. return updated row
  deactivate db
  aptEntity --> aptSvc : 13. return Appointment
  deactivate aptEntity

  aptSvc --> ctrl : 14. return Appointment

  ctrl --> page : 15. 200 OK { Appointment }

  page --> user : 16. Display updated appointment
else appointment not found
  aptSvc --> ctrl : 17. throw NotFoundException
  deactivate aptSvc

  ctrl --> page : 18. 404 { Appointment not found }
  deactivate ctrl

  page --> user : 19. Show not found error
  deactivate page
end

deactivate user

@enduml
