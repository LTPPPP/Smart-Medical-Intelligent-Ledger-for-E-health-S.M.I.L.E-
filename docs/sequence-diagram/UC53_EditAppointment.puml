@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "AppointmentDetailPanel" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db

user -> page : 1. Edit appointment fields\n(date, time, doctor, room, notes) and submit
activate user
activate page

page -> ctrl : 2. PATCH /api/v1/appointments/{id}\nUpdateAppointmentDto
activate ctrl

ctrl -> aptSvc : 3. update(id, UpdateAppointmentDto)
activate aptSvc

aptSvc -> aptEntity : 4. findOne(appointment_id, relations)
activate aptEntity
aptEntity -> db : 5. SELECT appointment WHERE appointment_id
activate db
db --> aptEntity : 6. return row
deactivate db
aptEntity --> aptSvc : 7. return Appointment
deactivate aptEntity

aptSvc -> aptSvc : 8. check appointment exists
activate aptSvc
deactivate aptSvc
alt appointment found
  aptSvc -> aptEntity : 9. save(updated appointment)
  activate aptEntity
  aptEntity -> db : 10. UPDATE appointments SET changed fields
  activate db
  db --> aptEntity : 11. return updated row
  deactivate db
  aptEntity --> aptSvc : 12. return Appointment
  deactivate aptEntity

  aptSvc --> ctrl : 13. return Appointment

  ctrl --> page : 14. 200 OK { Appointment }

  page --> user : 15. Display updated appointment
else appointment not found
  aptSvc --> ctrl : 16. throw NotFoundException
  deactivate aptSvc

  ctrl --> page : 17. 404 { Appointment not found }
  deactivate ctrl

  page --> user : 18. Show not found error
  deactivate page
end

deactivate user

@enduml
