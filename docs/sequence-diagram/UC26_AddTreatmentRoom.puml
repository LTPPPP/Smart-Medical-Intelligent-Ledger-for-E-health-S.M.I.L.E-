@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Admin" as user
boundary "ClinicDetailPanel" as form
participant ":TreatmentRoomsController" as ctrl
participant ":TreatmentRoomsService" as roomSvc
entity "TreatmentRoomEntity" as roomEntity
database "PostgreSQL" as db

user -> form : 1. Fill room name, room type, floor,\nmax capacity, equipment list
activate user
activate form

user -> form : 2. Click "Add Room"

form -> ctrl : 3. POST /api/v1/clinics/{clinicId}/treatment-rooms\nCreateTreatmentRoomDto
activate ctrl

ctrl -> roomSvc : 4. create(clinicId, CreateTreatmentRoomDto)
activate roomSvc

roomSvc -> roomEntity : 5. save(treatmentRoom)
activate roomEntity
roomEntity -> db : 6. INSERT treatment_room\n{ clinic_id, room_name, room_type, floor, max_capacity, equipment }
activate db
db --> roomEntity : 7. return saved row
deactivate db
roomEntity --> roomSvc : 8. return TreatmentRoomEntity
deactivate roomEntity

roomSvc --> ctrl : 9. return TreatmentRoomEntity
deactivate roomSvc

ctrl --> form : 10. 201 Created TreatmentRoomEntity
deactivate ctrl

form --> user : 11. Display created treatment room
deactivate form

deactivate user

@enduml
