@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Doctor" as user
boundary "ExaminationPanel" as form
participant ":ClinicalOrdersController" as ctrl
participant ":ClinicalOrdersService" as orderSvc
entity "DiagnosticOrderEntity" as orderEntity
database "PostgreSQL" as db

user -> form : 1. Select order type LAB,\nfill test name, description, priority
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. POST /api/v1/clinical-orders\n{ record_id, patient_id, ordered_by,\norder_type: LAB, description, priority }
  activate ctrl

  ctrl -> orderSvc : 4. create(CreateClinicalOrderDto)
  activate orderSvc

  orderSvc -> orderEntity : 5. save(DiagnosticOrderEntity)
  activate orderEntity
  orderEntity -> db : 6. INSERT INTO clinical_orders\n{ order_type: LAB,\nstatus: ORDERED, ordered_at: NOW() }
  activate db
  db --> orderEntity : 7. return record
  deactivate db
  orderEntity --> orderSvc : 8. return DiagnosticOrderEntity
  deactivate orderEntity

  orderSvc --> ctrl : 9. return DiagnosticOrderEntity
  deactivate orderSvc

  ctrl --> form : 10. 201 Created DiagnosticOrderEntity
  deactivate ctrl

  form --> user : 11. Display created lab order\n(status: ORDERED)
else validation fails
  form --> user : 12. Show validation errors
  deactivate form
end

deactivate user

@enduml
