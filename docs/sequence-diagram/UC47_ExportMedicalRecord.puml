@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Staff" as user
boundary "MedicalRecordView" as form
participant ":RecordExportsController" as ctrl
participant ":RecordExportsService" as exportSvc
entity "RecordExportEntity" as exportEntity
database "PostgreSQL" as db

user -> form : 1. Click "Export Record" and select format
activate user
activate form

form -> ctrl : 2. POST /api/v1/record-exports\n{ record_id, export_format, requested_by }
activate ctrl

ctrl -> exportSvc : 3. create(CreateRecordExportDto)
activate exportSvc

exportSvc -> exportEntity : 4. save(recordExport)
activate exportEntity
exportEntity -> db : 5. INSERT record_export\n{ record_id, export_format, requested_by, status: PENDING }
activate db
db --> exportEntity : 6. return saved row
deactivate db
exportEntity --> exportSvc : 7. return RecordExportEntity
deactivate exportEntity

exportSvc --> ctrl : 8. return RecordExportEntity
deactivate exportSvc

ctrl --> form : 9. 201 Created RecordExportEntity
deactivate ctrl

form --> user : 10. Display export initiated\n(status: PENDING, export_id)
deactivate form

opt Check export status
  user -> form : 11. Refresh or poll export status
  activate form

  form -> ctrl : 12. GET /api/v1/record-exports/{export_id}
  activate ctrl

  ctrl -> exportSvc : 13. findOne(export_id)
  activate exportSvc

  exportSvc -> exportEntity : 14. findOne(export_id)
  activate exportEntity
  exportEntity -> db : 15. SELECT record_export WHERE export_id
  activate db
  db --> exportEntity : 16. return result
  deactivate db
  exportEntity --> exportSvc : 17. return RecordExportEntity
  deactivate exportEntity

  exportSvc --> ctrl : 18. return RecordExportEntity
  deactivate exportSvc

  ctrl --> form : 19. 200 OK RecordExportEntity
  deactivate ctrl

  form --> user : 20. Display export status\n(download link if COMPLETED)
  deactivate form
end

deactivate user

@enduml
