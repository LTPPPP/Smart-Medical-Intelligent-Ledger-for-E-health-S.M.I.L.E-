@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "AppointmentDetailView" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
entity "AppointmentStatusHistoryEntity" as histEntity
database "PostgreSQL" as db

user -> page : 1. Select appointment, click Cancel
activate user
activate page

page -> page : 2. validate: cancelled_by is not empty,\ncancellation_reason is a non-empty string,\nthe appointment status still allows cancellation
activate page
deactivate page
alt validation passes
  page -> ctrl : 3. PATCH /api/v1/appointments/:id/cancel\n{ cancelled_by, cancellation_reason }
  activate ctrl

  ctrl -> aptSvc : 4. cancel(id, CancelAppointmentDto)
  activate aptSvc

  aptSvc -> aptEntity : 5. findOne(appointment_id, relations)
  activate aptEntity
  aptEntity -> db : 6. SELECT * FROM appointments WHERE appointment_id
  activate db
  db --> aptEntity : 7. return row
  deactivate db
  aptEntity --> aptSvc : 8. return Appointment
  deactivate aptEntity

  aptSvc -> aptSvc : 9. check appointment exists
  activate aptSvc
  deactivate aptSvc
  alt appointment found
    aptSvc -> aptSvc : 10. save oldStatus, set status = CANCELLED,\ncancelled_by, cancellation_reason, cancelled_at
    activate aptSvc
    deactivate aptSvc

    aptSvc -> aptEntity : 11. save(updated appointment)
    activate aptEntity
    aptEntity -> db : 12. UPDATE appointments SET status, cancelled fields
    activate db
    db --> aptEntity : 13. return updated row
    deactivate db
    aptEntity --> aptSvc : 14. return Appointment
    deactivate aptEntity

    aptSvc -> histEntity : 15. save(old_status, new_status: CANCELLED,\nchanged_by, reason)
    activate histEntity
    histEntity -> db : 16. INSERT INTO appointment_status_history
    activate db
    db --> histEntity : 17. return saved row
    deactivate db
    histEntity --> aptSvc : 18. return AppointmentStatusHistory
    deactivate histEntity

    aptSvc --> ctrl : 19. return Appointment

    ctrl --> page : 20. 200 OK { Appointment }

    page --> user : 21. Show cancellation confirmation
  else appointment not found
    aptSvc --> ctrl : 22. throw NotFoundException
    deactivate aptSvc

    ctrl --> page : 23. 404 { Appointment not found }
    deactivate ctrl

    page --> user : 24. Show not found message
  end
else validation fails
  page --> user : 25. Show validation errors
  deactivate page
end

deactivate user

@enduml
