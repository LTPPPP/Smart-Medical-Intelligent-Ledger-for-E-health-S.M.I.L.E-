@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-054: Cancel Appointment

actor "Patient" as patient
boundary "AppointmentDetailView" as view
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
database "PostgreSQL" as db
participant ":AppointmentNotificationPublisher" as notifPub

patient -> view : 1. Select appointment, click Cancel
activate patient
activate view

view -> view : 2. Validate cancellation reason
activate view
deactivate view
alt validation passes
  view -> ctrl : 3. PATCH /api/v1/appointments/:id/cancel\n{ cancelled_by, cancellation_reason }
  activate ctrl

  ctrl -> aptSvc : 4. cancel(id, CancelAppointmentDto)
  activate aptSvc

  aptSvc -> db : 5. SELECT Appointment WHERE appointment_id
  activate db
  db --> aptSvc : 6. return Appointment / null
  deactivate db

  aptSvc -> aptSvc : 7. check appointment exists
  activate aptSvc
  deactivate aptSvc
  alt appointment found
    aptSvc -> aptSvc : 8. Save oldStatus
    activate aptSvc
    deactivate aptSvc

    aptSvc -> aptSvc : 9. Set status = CANCELLED,\ncancelled_by, cancellation_reason,\ncancelled_at = now
    activate aptSvc
    deactivate aptSvc

    aptSvc -> db : 10. UPDATE Appointment
    activate db
    db --> aptSvc : 11. return updated Appointment
    deactivate db

    aptSvc -> db : 12. INSERT AppointmentStatusHistory\n{ old_status, new_status: CANCELLED,\nchanged_by, reason }
    activate db
    db --> aptSvc : 13. return AppointmentStatusHistory
    deactivate db

    aptSvc --> ctrl : 14. return Appointment

    ctrl --> view : 15. 200 OK { updated Appointment }

    view --> patient : 16. Show cancellation confirmation

    patient -> ctrl : 17. POST /api/v1/appointments/:id/notifications/confirmation

    ctrl -> aptSvc : 18. sendConfirmation(appointmentId)

    aptSvc -> db : 19. SELECT Appointment WHERE appointment_id
    activate db
    db --> aptSvc : 20. return Appointment
    deactivate db

    aptSvc -> aptSvc : 21. Build notification payload
    activate aptSvc
    deactivate aptSvc

    aptSvc -> notifPub : 22. sendAppointmentConfirmation(payload)
    activate notifPub
    notifPub --> aptSvc : 23. return AppointmentNotificationPayload
    deactivate notifPub

    aptSvc --> ctrl : 24. return AppointmentNotificationPayload
    deactivate aptSvc

    ctrl --> patient : 25. 202 Accepted
    deactivate ctrl

    deactivate view
  else appointment not found
    aptSvc --> ctrl : 26. throw NotFoundException
    deactivate aptSvc
    ctrl --> view : 27. 404 { Appointment not found }
    deactivate ctrl
    view --> patient : 28. Show not found message
  end
else validation fails
  view --> patient : 29. Show validation errors
  deactivate view
end

deactivate patient

@enduml
