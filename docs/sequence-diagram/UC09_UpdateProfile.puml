@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ProfileForm" as form
participant ":UserProfilesController" as ctrl
participant ":UserProfilesService" as profSvc
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db

user -> form : 1. Edit profile fields\n(full_name, phone, avatar)
activate user
activate form

form -> form : 2. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 3. PATCH /api/v1/user-profiles/{id}\n{ UpdateUserProfileDto }
  activate ctrl

  ctrl -> profSvc : 4. update(id, UpdateUserProfileDto)
  activate profSvc

  profSvc -> profEntity : 5. findOne(userId)
  activate profEntity
  profEntity -> db : 6. SELECT user_profile WHERE user_id
  activate db
  db --> profEntity : 7. return result
  deactivate db
  profEntity --> profSvc : 8. return UserProfile
  deactivate profEntity

  profSvc -> profSvc : 9. check profile exists
  activate profSvc
  deactivate profSvc
  alt profile found
    profSvc -> profEntity : 10. save(updatedFields)
    activate profEntity
    profEntity -> db : 11. UPDATE user_profile SET changed fields
    activate db
    db --> profEntity : 12. return updated row
    deactivate db
    profEntity --> profSvc : 13. return UserProfile
    deactivate profEntity

    profSvc --> ctrl : 14. return UserProfileEntity

    ctrl --> form : 15. 200 OK { updated UserProfileEntity }

    form --> user : 16. Show profile updated successfully
  else profile not found
    profSvc --> ctrl : 17. throw NotFoundException
    deactivate profSvc

    ctrl --> form : 18. 404 Not Found
    deactivate ctrl

    form --> user : 19. Show error
  end
else validation fails
  form --> user : 20. Show validation errors
  deactivate form
end

deactivate user

@enduml
