@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "User" as user
boundary "ProfileForm" as form
participant ":UserProfilesController" as ctrl
participant ":UserProfilesService" as profSvc
entity "UserProfileEntity" as profEntity
database "PostgreSQL" as db

user -> form : 1. Edit profile fields\n(full_name, phone, avatar)
activate user
activate form

user -> form : 2. Click "Save Changes"

form -> form : 3. Validate input
activate form
deactivate form
alt validation passes
  form -> ctrl : 4. PATCH /api/v1/user-profiles/{id}\n{ UpdateUserProfileDto }
  activate ctrl

  ctrl -> profSvc : 5. update(id, UpdateUserProfileDto)
  activate profSvc

  profSvc -> profEntity : 6. findOne(userId)
  activate profEntity
  profEntity -> db : 7. SELECT user_profile WHERE user_id
  activate db
  db --> profEntity : 8. return result
  deactivate db
  profEntity --> profSvc : 9. return UserProfile
  deactivate profEntity

  profSvc -> profSvc : 10. check profile exists
  activate profSvc
  deactivate profSvc
  alt profile found
    profSvc -> profEntity : 11. save(updatedFields)
    activate profEntity
    profEntity -> db : 12. UPDATE user_profile SET changed fields
    activate db
    db --> profEntity : 13. return updated row
    deactivate db
    profEntity --> profSvc : 14. return UserProfile
    deactivate profEntity

    profSvc --> ctrl : 15. return UserProfileEntity

    ctrl --> form : 16. 200 OK { updated UserProfileEntity }

    form --> user : 17. Show profile updated successfully
  else profile not found
    profSvc --> ctrl : 18. throw NotFoundException
    deactivate profSvc

    ctrl --> form : 19. 404 Not Found
    deactivate ctrl

    form --> user : 20. Show error
  end
else validation fails
  form --> user : 21. Show validation errors
  deactivate form
end

deactivate user

@enduml
