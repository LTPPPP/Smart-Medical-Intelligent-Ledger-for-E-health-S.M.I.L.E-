@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center
actor "Patient" as user
boundary "InvoiceView" as page
participant ":AppointmentsController" as ctrl
participant ":AppointmentsService" as aptSvc
entity "AppointmentEntity" as aptEntity
database "PostgreSQL" as db
participant "VNPay" as vnpay

user -> page : 1. Click "Pay Invoice"
activate user
activate page

page -> ctrl : 2. POST /api/v1/appointments/{id}/payment\n{ method: VNPAY }
activate ctrl

ctrl -> aptSvc : 3. processPayment(appointmentId, method)
activate aptSvc

aptSvc -> aptEntity : 4. findOne(appointment_id)
activate aptEntity
aptEntity -> db : 5. SELECT * FROM appointments WHERE appointment_id
activate db
db --> aptEntity : 6. return row
deactivate db
aptEntity --> aptSvc : 7. return Appointment
deactivate aptEntity

aptSvc -> aptSvc : 8. generate HMAC signature and construct VNPay payload
activate aptSvc
deactivate aptSvc

aptSvc -> aptSvc : 9. build VNPay redirect URL with signed params
activate aptSvc
deactivate aptSvc

aptSvc -> aptEntity : 10. save(payment_status = PENDING)
activate aptEntity
aptEntity -> db : 11. UPDATE appointments SET payment_status = PENDING
activate db
db --> aptEntity : 12. return updated row
deactivate db
aptEntity --> aptSvc : 13. return Appointment
deactivate aptEntity

aptSvc --> ctrl : 14. return { paymentUrl, appointmentId }

ctrl --> page : 15. 200 OK { paymentUrl, appointmentId }

page -> vnpay : 16. Redirect patient browser to VNPay URL
activate vnpay

user -> vnpay : 17. Authenticate and complete payment via bank
vnpay --> page : 18. Redirect back to frontend /payment/return
deactivate vnpay

vnpay -> ctrl : 19. Async IPN callback with payment result and checksum
activate vnpay

ctrl -> aptSvc : 20. handleIpnCallback(ipnParams)

aptSvc -> aptSvc : 21. verify HMAC checksum against VNPay secret
activate aptSvc
deactivate aptSvc
alt checksum valid and payment successful
  aptSvc -> aptEntity : 22. save(payment_status = COMPLETED)
  activate aptEntity
  aptEntity -> db : 23. UPDATE appointments SET payment_status = COMPLETED
  activate db
  db --> aptEntity : 24. return updated row
  deactivate db
  aptEntity --> aptSvc : 25. return Appointment
  deactivate aptEntity

  aptSvc --> ctrl : 26. return IpnResponse { rspCode: 00 }

  ctrl --> vnpay : 27. 200 OK { RspCode: 00 }
  page --> user : 28. Display "Payment Successful"
else checksum invalid or payment failed
  aptSvc -> aptEntity : 29. save(payment_status = FAILED)
  activate aptEntity
  aptEntity -> db : 30. UPDATE appointments SET payment_status = FAILED
  activate db
  db --> aptEntity : 31. return updated row
  deactivate db
  aptEntity --> aptSvc : 32. return Appointment
  deactivate aptEntity

  aptSvc --> ctrl : 33. return IpnResponse { rspCode: 97 }
  deactivate aptSvc
  ctrl --> vnpay : 34. 200 OK { RspCode: 97 }
  deactivate vnpay

  page --> user : 35. Display "Payment Failed"
  
  deactivate ctrl
  deactivate page
end

deactivate user

@enduml
