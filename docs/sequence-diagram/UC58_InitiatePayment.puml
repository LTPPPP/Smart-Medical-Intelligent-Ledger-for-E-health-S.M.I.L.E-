@startuml SequenceDiagram
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram — UC-058: Initiate Payment

actor "Patient" as user
boundary "InvoiceView" as form
participant ":PaymentController" as ctrl
participant ":PaymentService" as paySvc
database "PostgreSQL" as db
participant "VNPay" as vnpay

user -> form : 1. Click "Pay Invoice"
activate user
activate form

form -> ctrl : 2. POST /api/v1/payments/process { invoiceId, method: VNPAY }
activate ctrl

ctrl -> paySvc : 3. processPayment(invoiceId, method)
activate paySvc

paySvc -> db : 4. SELECT payment WHERE invoiceId
activate db
db --> paySvc : 5. return Payment
deactivate db

paySvc -> paySvc : 6. Generate HMAC signature and construct VNPay payload
activate paySvc
deactivate paySvc

paySvc -> paySvc : 7. Build VNPay redirect URL with signed params
activate paySvc
deactivate paySvc

paySvc -> db : 8. INSERT payment_transaction { status: PENDING }
activate db
db --> paySvc : 9. return PaymentTransaction
deactivate db

paySvc --> ctrl : 10. return { paymentUrl, transactionId }
deactivate paySvc

ctrl --> form : 11. 200 OK { paymentUrl, transactionId }
deactivate ctrl

form -> vnpay : 12. Redirect patient browser to VNPay URL
activate vnpay

user -> vnpay : 13. Authenticate and complete payment via bank
vnpay --> form : 14. Redirect back to frontend /payment/return
deactivate vnpay

vnpay -> ctrl : 15. Async IPN callback with payment result and checksum
activate vnpay
activate ctrl

ctrl -> paySvc : 16. handleIpnCallback(ipnParams)
activate paySvc

paySvc -> paySvc : 17. Verify HMAC checksum against VNPay secret
activate paySvc
deactivate paySvc
alt checksum valid and payment successful
  paySvc -> db : 18. UPDATE payment SET status = COMPLETED
  activate db
  db --> paySvc : 19. return updated Payment
  deactivate db

  paySvc -> db : 20. UPDATE payment_transaction SET status = SUCCESS
  activate db
  db --> paySvc : 21. return updated PaymentTransaction
  deactivate db

  paySvc --> ctrl : 22. return IpnResponse { rspCode: 00 }
  deactivate paySvc

  ctrl --> vnpay : 23. 200 OK { RspCode: 00 }
  deactivate ctrl
  deactivate vnpay

  form --> user : 24. Display "Payment Successful"
  deactivate form
else checksum invalid or payment failed
  paySvc -> db : 25. UPDATE payment_transaction SET status = FAILED
  activate db
  db --> paySvc : 26. return updated PaymentTransaction
  deactivate db

  paySvc --> ctrl : 27. return IpnResponse { rspCode: 97 }
  deactivate paySvc
  activate ctrl
  ctrl --> vnpay : 28. 200 OK { RspCode: 97 }
  deactivate ctrl
  deactivate vnpay

  activate form
  form --> user : 29. Display "Payment Failed"
  deactivate form
end

deactivate user

@enduml
