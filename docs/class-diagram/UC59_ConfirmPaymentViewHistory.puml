@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}

title Class Diagram — UC-059: Confirm Payment / View Payment History

class "AppointmentsController" as ApptCtrl {
  - appointmentsService : AppointmentsService
  --
  + update(id : string, dto : UpdateAppointmentDto) : Promise<AppointmentEntity>
  + getStatusHistory(id : string) : Promise<AppointmentStatusHistoryEntity[]>
}

class "AppointmentsService" as ApptSvc {
  - appointmentRepository : Repository<AppointmentEntity>
  - historyRepository : Repository<AppointmentStatusHistoryEntity>
  --
  + update(id : string, dto : UpdateAppointmentDto) : Promise<AppointmentEntity>
  + getStatusHistory(appointmentId : string) : Promise<AppointmentStatusHistoryEntity[]>
}

class "UpdateAppointmentDto" as UpdateDto {
  - payment_status? : string
  - payment_id? : string
}

class "AppointmentEntity" as ApptEntity {
  - appointment_id : string
  - payment_id : string | null
  - payment_status : string
}

class "AppointmentStatusHistoryEntity" as HistEntity {
  - history_id : string
  - appointment_id : string
  - old_status : string | null
  - new_status : string | null
  - changed_by : string
}

' ---- Relationships ----
ApptCtrl "1" --> "1" ApptSvc : <<association>>

ApptCtrl ..> UpdateDto : <<dependency>>
ApptSvc ..> ApptEntity : <<dependency>>

ApptEntity "1" *-- "*" HistEntity : <<composition>>

@enduml
