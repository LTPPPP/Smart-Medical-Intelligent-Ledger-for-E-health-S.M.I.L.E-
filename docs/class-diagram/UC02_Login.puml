@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}

title Class Diagram — UC-002: Login

class "AuthController" as AuthCtrl {
  - service : AuthService
  - auditLogsService : AuditLogsService
  --
  + login(request, loginDto : AuthEmailLoginDto) : Promise<LoginResponseDto>
}

class "AuthService" as AuthSvc {
  - accountsService : AccountsService
  - refreshTokensService : RefreshTokensService
  - userProfilesService : UserProfilesService
  --
  + validateLogin(loginDto : AuthEmailLoginDto) : Promise<LoginResponseDto>
  - getTokensData(data : { accountId, email, role, status }) : Promise<{ token, refreshToken, tokenExpires }>
  - createRefreshToken(accountId : string) : Promise<string>
}

class "AccountsService" as AccSvc {
  + findByEmail(email : string) : Promise<Account | null>
  + updateLastLogin(accountId : string) : Promise<void>
  + updateFailedLoginAttempts(accountId : string, attempts : number) : Promise<void>
  + lockAccount(accountId : string, reason : string, lockedBy : string | null) : Promise<void>
}

class "RefreshTokensService" as RefTokenSvc {
  + create(data : Partial<RefreshToken>) : Promise<RefreshToken>
  + findByTokenHash(tokenHash : string) : Promise<RefreshToken | null>
}

class "UserProfilesService" as UserProfSvc {
  + findById(id : string) : Promise<UserProfileEntity | null>
}

class "AuditLogsService" as AuditSvc {
  + create(data : Partial<AuditLog>) : Promise<AuditLog>
}

class "AuthEmailLoginDto" as LoginDto {
  - email : string
  - password : string
}

class "LoginResponseDto" as LoginRespDto {
  - token : string
  - refreshToken : string
  - tokenExpires : number
  - user : Account
  - userProfile : UserProfileEntity | null
}

class "AccountEntity" as AccountEntity {
  - accountId : string
  - email : string | null
  - passwordHash : string | null
  - role : RoleEnum
  - status : AccountStatus
  - failedLoginAttempts : number
  - lastLoginAt : Date | null
}

class "RefreshTokenEntity" as RefTokenEntity {
  - tokenId : string
  - accountId : string | null
  - tokenHash : string
  - expiresAt : Date
  - revokedAt : Date | null
  - createdAt : Date
}

class "UserProfileEntity" as UserProfileEntity {
  - user_id : string
  - full_name : string
  - email : string | null
}

' ---- Relationships ----
AuthCtrl "1" --> "1" AuthSvc : <<association>>
AuthCtrl "1" --> "1" AuditSvc : <<association>>
AuthSvc "1" --> "1" AccSvc : <<association>>
AuthSvc "1" --> "1" RefTokenSvc : <<association>>
AuthSvc "1" --> "1" UserProfSvc : <<association>>

AuthCtrl ..> LoginDto : <<dependency>>
AuthSvc ..> LoginRespDto : <<dependency>>

AccSvc ..> AccountEntity : <<dependency>>
RefTokenSvc ..> RefTokenEntity : <<dependency>>
UserProfSvc ..> UserProfileEntity : <<dependency>>

RefTokenEntity "*" --> "1" AccountEntity : <<association>>

@enduml
