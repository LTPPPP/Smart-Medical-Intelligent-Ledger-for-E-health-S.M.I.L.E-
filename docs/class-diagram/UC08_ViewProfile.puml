@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}

title Class Diagram — UC-008: View Profile

class "UserProfilesController" as UserProfCtrl {
  - userProfilesService : UserProfilesService
  --
  + findOne(id : string) : Promise<UserProfileEntity | null>
}

class "UserProfilesService" as UserProfSvc {
  + findById(id : string) : Promise<UserProfileEntity | null>
}

class "UserProfileEntity" as UserProfileEntity {
  - user_id : string
  - full_name : string
  - email : string | null
  - phone : string | null
  - date_of_birth : Date | null
  - gender : string | null
  - avatar_url : string | null
  - is_banned : boolean
}

' ---- Relationships ----
UserProfCtrl "1" --> "1" UserProfSvc : <<association>>

UserProfSvc ..> UserProfileEntity : <<dependency>>

@enduml
