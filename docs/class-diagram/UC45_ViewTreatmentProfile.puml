@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "TreatmentHistoryController" as TreatCtrl {
  - treatmentHistoryService : TreatmentHistoryService
  ...
  --
  + findOne(treatment_id : string) : Promise<TreatmentHistoryEntity>
  + findByPatientId(patient_id : string) : Promise<TreatmentHistoryEntity[]>
  + findByRecordId(record_id : string) : Promise<TreatmentHistoryEntity[]>
  ...
}

class "TreatmentHistoryService" as TreatSvc {
  - treatmentHistoryRepository : Repository<TreatmentHistoryEntity>
  ...
  --
  + findOne(treatment_id : string) : Promise<TreatmentHistoryEntity>
  + findByPatientId(patient_id : string) : Promise<TreatmentHistoryEntity[]>
  + findByRecordId(record_id : string) : Promise<TreatmentHistoryEntity[]>
  ...
}

class "TreatmentHistoryEntity" as TreatEntity {
  - treatment_id : string
  - record_id : string
  - patient_id : string
  - treatment_date : Date
  - tooth_numbers : number[] | null
  - procedure_name : string
  - cost : number | null
  - status : string
  - performed_by : string
  ...
  --
}

' ---- Relationships ----
TreatCtrl --> TreatSvc : <<association>>

TreatSvc ..> TreatEntity : <<dependency>>

@enduml
