title Class Diagram — UC-033: Register Personal Schedule - Examination

class "DoctorLeavesController" as LeaveCtrl {
  - doctorLeavesService : DoctorLeavesService
  --
  + create(dto : CreateDoctorLeaveDto) : Promise<DoctorLeaveEntity>
}

class "DoctorLeavesService" as LeaveSvc {
  - leaveRepository : Repository<DoctorLeaveEntity>
  --
  + create(dto : CreateDoctorLeaveDto) : Promise<DoctorLeaveEntity>
}

class "CreateDoctorLeaveDto" as CreateDto {
  - doctor_id : string
  - leave_type? : string
  - start_date : string
  - end_date : string
  - reason? : string
}

class "DoctorLeaveEntity" as LeaveEntity {
  - leave_id : string
  - doctor_id : string
  - leave_type : string | null
  - start_date : Date
  - end_date : Date
  - reason : string | null
  - status : string
  - approved_by : string | null
}

