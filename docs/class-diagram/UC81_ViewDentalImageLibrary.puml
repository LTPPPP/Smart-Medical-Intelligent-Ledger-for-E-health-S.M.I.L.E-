@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "DentalImagesController" as ImgCtrl {
  - dentalImagesService : DentalImagesService
  --
  + findAll() : Promise<DentalImageEntity[]>
  + findOne(image_id : string) : Promise<DentalImageEntity>
  + findByPatientId(patient_id : string) : Promise<DentalImageEntity[]>
  + findByCategoryId(category_id : string) : Promise<DentalImageEntity[]>
}

class "DentalImagesService" as ImgSvc {
  - dentalImagesRepository : Repository<DentalImageEntity>
  --
  + findAll() : Promise<DentalImageEntity[]>
  + findOne(image_id : string) : Promise<DentalImageEntity>
  + findByPatientId(patient_id : string) : Promise<DentalImageEntity[]>
  + findByCategoryId(category_id : string) : Promise<DentalImageEntity[]>
}

class "DentalImageEntity" as ImgEntity {
  - image_id : string
  - patient_id : string
  - image_type : string
  - image_url : string
  - thumbnail_url : string | null
  - tooth_numbers : number[] | null
  - tags : string[] | null
  - is_archived : boolean
}

class "ImageCategoryEntity" as CatEntity {
  - category_id : string
  - category_name : string
}

' ---- Relationships ----
ImgCtrl --> ImgSvc : <<association>>

ImgSvc ..> ImgEntity : <<dependency>>

ImgEntity --> CatEntity : <<association>>

@enduml
