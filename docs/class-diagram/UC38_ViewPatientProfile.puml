@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}

title Class Diagram — UC-038: View Patient Profile

class "PatientsController" as PatCtrl {
  - patientsService : PatientsService
  --
  + findOne(patient_id : string) : Promise<PatientEntity>
  + findByCode(patient_code : string) : Promise<PatientEntity>
}

class "PatientsService" as PatSvc {
  - patientsRepository : Repository<PatientEntity>
  --
  + findOne(patient_id : string) : Promise<PatientEntity>
  + findByCode(patient_code : string) : Promise<PatientEntity>
}

class "PatientEntity" as PatEntity {
  - patient_id : string
  - patient_code : string
  - full_name : string
  - date_of_birth : Date | null
  - gender : string | null
  - phone : string | null
  - email : string | null
  - address : string | null
  - blood_type : string | null
  - allergies : string[] | null
  - chronic_diseases : string[] | null
  - insurance_number : string | null
}

' ---- Relationships ----
PatCtrl "1" --> "1" PatSvc : <<association>>

PatSvc ..> PatEntity : <<dependency>>

@enduml
