@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "SpecialtiesController" as SpecCtrl {
  - specialtiesService : SpecialtiesService
  --
  + create(dto : CreateSpecialtyDto) : Promise<SpecialtyEntity>
}

class "SpecialtiesService" as SpecSvc {
  - specialtyRepository : Repository<SpecialtyEntity>
  --
  + create(dto : CreateSpecialtyDto) : Promise<SpecialtyEntity>
}

class "CreateSpecialtyDto" as CreateDto {
  - specialty_name : string
  - specialty_code : string
  - description? : string
  - icon_url? : string
  - is_active? : boolean
  - display_order? : number
}

class "SpecialtyEntity" as SpecEntity {
  - specialty_id : string
  - specialty_name : string
  - specialty_code : string
  - is_active : boolean
}

' ---- Relationships ----
SpecCtrl --> SpecSvc : <<association>>

SpecCtrl ..> CreateDto : <<dependency>>
SpecSvc ..> SpecEntity : <<dependency>>

@enduml
