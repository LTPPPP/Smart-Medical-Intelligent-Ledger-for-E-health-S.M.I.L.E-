@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "PermissionsController" as PermCtrl {
  - permissionsService : PermissionsService
  --
  + findAll() : Promise<PermissionEntity[]>
  + findOne(id : string) : Promise<PermissionEntity | null>
}

class "PermissionsService" as PermSvc {
  + findAll() : Promise<PermissionEntity[]>
  + findById(id : string) : Promise<PermissionEntity | null>
}

class "PermissionEntity" as PermEntity {
  - permission_id : string
  - permission_name : string
  - resource : string | null
  - action : string | null
  - description : string | null
  - created_at : Date
}

' ---- Relationships ----
PermCtrl --> PermSvc : <<association>>

PermSvc ..> PermEntity : <<dependency>>

@enduml
