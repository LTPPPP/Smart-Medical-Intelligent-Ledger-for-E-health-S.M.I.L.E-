@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "AppointmentsController" as ApptCtrl {
  - appointmentsService : AppointmentsService
  ...
  --
  + cancel(id : string, dto : CancelAppointmentDto) : Promise<AppointmentEntity>
  ...
}

class "AppointmentsService" as ApptSvc {
  - appointmentRepository : Repository<AppointmentEntity>
  - historyRepository : Repository<AppointmentStatusHistoryEntity>
  ...
  --
  + cancel(id : string, dto : CancelAppointmentDto) : Promise<AppointmentEntity>
  ...
}

class "CancelAppointmentDto" as CancelDto {
  - cancelled_by : string
  - cancellation_reason? : string
  ...
  --
}

class "AppointmentEntity" as ApptEntity {
  - appointment_id : string
  - status : string
  - cancellation_reason : string | null
  - cancelled_by : string | null
  - cancelled_at : Date | null
  ...
  --
}

class "AppointmentStatusHistoryEntity" as HistEntity {
  - history_id : string
  - appointment_id : string
  - old_status : string | null
  - new_status : string | null
  - changed_by : string
  - reason : string | null
  ...
  --
}

' ---- Relationships ----
ApptCtrl --> ApptSvc : <<association>>

ApptCtrl ..> CancelDto : <<dependency>>
ApptSvc ..> ApptEntity : <<dependency>>

ApptEntity *-- HistEntity : <<composition>>

@enduml
