@startuml ClassDiagram
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam classFontStyle bold
skinparam classFontSize 14
skinparam nodesep 50
skinparam ranksep 50
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #E8E8E8
  BorderColor #999999
}


class "AuthController" as AuthCtrl {
  - service : AuthService
  ...
  --
  + resetPassword(resetPasswordDto : AuthResetPasswordDto) : Promise<{ message: string }>
  ...
}

class "AuthService" as AuthSvc {
  - accountsService : AccountsService
  - refreshTokensService : RefreshTokensService
  ...
  --
  + resetPassword(hash : string, password : string) : Promise<{ message: string }>
  ...
}

class "AccountsService" as AccSvc {
  - accountsRepository : AccountsRepository
  ...
  --
  + findById(id : string) : Promise<Account | null>
  + update(id : string, updateAccountDto : UpdateAccountDto) : Promise<Account | null>
  ...
}

class "RefreshTokensService" as RefTokenSvc {
  ...
  --
  + revokeByAccountId(accountId : string) : Promise<void>
  ...
}

class "AccountsRepository" as AccRepo {
  ...
  --
  + findById(id : string) : Promise<Account | null>
  + update(id : string, data : Partial<Account>) : Promise<Account | null>
  ...
}

class "AuthResetPasswordDto" as ResetPwdDto {
  - hash : string
  - password : string
  ...
  --
}

class "AccountEntity" as AccountEntity {
  - accountId : string
  - email : string | null
  - passwordHash : string | null
  ...
  --
}

class "RefreshTokenEntity" as RefTokenEntity {
  - tokenId : string
  - accountId : string | null
  - revokedAt : Date | null
  ...
  --
}

' ---- Relationships ----
AuthCtrl --> AuthSvc : <<association>>
AuthSvc --> AccSvc : <<association>>
AuthSvc --> RefTokenSvc : <<association>>
AccSvc --> AccRepo : <<association>>

AuthCtrl ..> ResetPwdDto : <<dependency>>
AccRepo ..> AccountEntity : <<dependency>>
RefTokenSvc ..> RefTokenEntity : <<dependency>>

RefTokenEntity --> AccountEntity : <<association>>

@enduml
