# S.M.I.L.E Frontend — local dev env
# All API traffic goes through the API Gateway (gateway-service) on :8080.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080/api/v1

# Per-service vars kept for backwards-compat; all point at the gateway.
NEXT_PUBLIC_ACCOUNT_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_CLINIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APPOINTMENT_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PATIENT_MEDIA_RECORD_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SCHEDULE_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SERVICE_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_EXAMINATION_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DENTAL_IMAGE_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8080/api/v1

# Chatbot (booking orchestrator FastAPI) — direct, not behind gateway.
NEXT_PUBLIC_CHATBOT_URL=http://localhost:8089

NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
