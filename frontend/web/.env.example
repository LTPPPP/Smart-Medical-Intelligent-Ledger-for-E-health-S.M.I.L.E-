# ── SMILE Frontend Configuration ──────────────────────────────────────────────
# All backend traffic goes through the API Gateway (gateway-service), which
# proxies /api/v1/<resource> to the underlying microservices (iam-service,
# clinical-emr-service, payment-service, ...). See src/shared/constants/env.ts —
# every value below already has a working localhost fallback baked in, so the
# app runs even if this file is never copied.

# Gateway base URL — the single origin the whole app talks to.
# Defaults to http://localhost:8080/api/v1.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080/api/v1

# Request timeout in ms
NEXT_PUBLIC_API_TIMEOUT=10000

# Google OAuth client ID, used by "Sign in with Google" on the login page.
# Leave empty to disable Google login locally.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
