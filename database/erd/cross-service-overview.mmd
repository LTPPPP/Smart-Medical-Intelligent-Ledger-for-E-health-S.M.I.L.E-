%% ERD — CROSS-SERVICE overview of links between the 5 databases
%% Every relationship here is dashed (..) = a UUID link maintained by application code,
%% NOT a real foreign key (each service owns a separate database).
%% Only the join/anchor tables of each DB are drawn.
erDiagram
    %% ---------- auth_service_db ----------
    accounts["accounts (auth_service_db)"] {
        UUID account_id PK
        VARCHAR email UK
        VARCHAR status
    }

    %% ---------- account_service_db (user-service) ----------
    users["users (account_service_db)"] {
        UUID user_id PK "= accounts.account_id (1-1)"
        VARCHAR full_name
    }
    notifications["notifications (account_service_db)"] {
        UUID notification_id PK
        UUID recipient_id
        UUID related_entity_id
    }
    %% ---------- core_clinic_service_db ----------
    appointments["appointments (core_clinic_service_db)"] {
        UUID appointment_id PK
        UUID patient_id "seed uses medical patients.patient_id"
        UUID doctor_id "= users.user_id"
        UUID payment_id "= payments.payment_id"
        UUID session_id
        UUID treatment_plan_id
    }
    doctor_schedules["doctor_schedules (core_clinic_service_db)"] {
        UUID schedule_id PK
        UUID doctor_id "= users.user_id"
    }
    doctor_specialties["doctor_specialties (core_clinic_service_db)"] {
        UUID doctor_id PK "= users.user_id"
        UUID specialty_id PK
    }

    %% ---------- payment_service_db ----------
    payments["payments (payment_service_db)"] {
        UUID payment_id PK
        UUID appointment_id "= appointments.appointment_id"
        NUMERIC amount
        VARCHAR status
    }

    %% ---------- core_medical_service_db ----------
    patients["patients (core_medical_service_db)"] {
        UUID patient_id PK
        UUID user_id "= users.user_id (nullable, walk-in patient)"
    }
    medical_records["medical_records (core_medical_service_db)"] {
        UUID record_id PK
        UUID appointment_id
        UUID clinic_id
        UUID doctor_id "= users.user_id"
    }
    examination_sessions["examination_sessions (core_medical_service_db)"] {
        UUID session_id PK
        UUID appointment_id
        UUID doctor_id "= users.user_id"
    }
    treatment_plans["treatment_plans (core_medical_service_db)"] {
        UUID plan_id PK
        UUID session_id FK
    }
    prescriptions["prescriptions (core_medical_service_db)"] {
        UUID prescription_id PK
    }

    %% ---------- Cross-service links (dashed, no FK) ----------
    accounts ||..|| users : "account_id = user_id (1-1)"
    users ||..o{ notifications : "recipient_id"
    users ||..o{ patients : "user_id (nullable)"
    users ||..o{ doctor_schedules : "doctor_id"
    users ||..o{ doctor_specialties : "doctor_id"
    users ||..o{ appointments : "doctor_id"
    patients ||..o{ appointments : "patient_id (per seed data)"
    appointments ||..o{ medical_records : "appointment_id"
    appointments ||..o{ examination_sessions : "appointment_id"
    examination_sessions ||..o| appointments : "session_id (BIDIRECTIONAL — app keeps in sync)"
    appointments ||..o| treatment_plans : "treatment_plan_id"
    users ||..o{ medical_records : "doctor_id"
    appointments ||..o{ notifications : "related_entity_id"
    appointments ||..o{ payments : "appointment_id"
