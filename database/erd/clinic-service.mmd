%% ERD — core_clinic_service_db (database/clinical-emr-service/clinic-service/schema.sql)
%% Net lien (--) = FK that. Net dut (..) = lien ket logic cross-service, KHONG co FK.
%% doctor_id / patient_id / created_by... tro sang iam-service (users.user_id) — khong ve entity ngoai.
%% Da luoc bo 2 bang infra khong thuoc domain: `migrations` (TypeORM) va `idempotency_keys`.
erDiagram
    clinics {
        UUID clinic_id PK
        VARCHAR clinic_name
        VARCHAR clinic_code UK
        TEXT address
        JSONB operating_hours
        VARCHAR status
        VARCHAR license_number
    }

    treatment_rooms {
        UUID room_id PK
        UUID clinic_id FK "UNIQUE(clinic_id, room_code)"
        VARCHAR room_name
        VARCHAR room_code
        ENUM room_type "examination | surgery | imaging"
        VARCHAR status
    }

    specialties {
        UUID specialty_id PK
        VARCHAR specialty_name
        VARCHAR specialty_code UK
        BOOLEAN is_active
    }

    doctor_specialties {
        UUID doctor_id PK "iam users.user_id (cross-service, khong FK)"
        UUID specialty_id PK,FK
        VARCHAR certification_number
        BOOLEAN is_primary
    }

    work_shifts {
        UUID shift_id PK
        VARCHAR shift_name
        TIME start_time
        TIME end_time
    }

    service_categories {
        UUID category_id PK
        VARCHAR category_name
        UUID parent_category_id FK "self-reference"
    }

    services {
        UUID service_id PK
        VARCHAR service_code UK
        VARCHAR service_name
        UUID category_id FK
        UUID specialty_id FK
        INTEGER duration_minutes
        NUMERIC base_price
        ENUM required_room_type
    }

    clinic_services {
        UUID clinic_service_id PK
        UUID clinic_id FK "UNIQUE(clinic_id, service_id)"
        UUID service_id FK
        NUMERIC custom_price
        BOOLEAN is_available
    }

    doctor_schedules {
        UUID schedule_id PK
        UUID doctor_id "iam users.user_id (cross-service, khong FK)"
        UUID clinic_id FK
        UUID shift_id FK "UNIQUE(doctor_id, work_date, shift_id)"
        DATE work_date
        UUID room_id FK
        INTEGER max_patients
        VARCHAR status
    }

    doctor_leaves {
        UUID leave_id PK
        UUID doctor_id "iam users.user_id (cross-service, khong FK)"
        VARCHAR leave_type
        DATE start_date
        DATE end_date
        VARCHAR status
        UUID approved_by
    }

    schedule_changes {
        UUID change_id PK
        UUID schedule_id FK
        UUID changed_by
        VARCHAR change_type
        JSONB old_values
        JSONB new_values
        VARCHAR approval_status
    }

    appointments {
        UUID appointment_id PK
        VARCHAR appointment_code UK
        UUID patient_id "comment: users.user_id — seed lai dung medical patients.patient_id!"
        UUID doctor_id "iam users.user_id (cross-service, khong FK)"
        UUID clinic_id FK
        UUID room_id FK
        UUID service_id FK
        DATE appointment_date
        TIME appointment_time
        VARCHAR status "scheduled | confirmed | checked_in | in_progress | completed | cancelled | no_show"
        UUID payment_id "payment-service (cross-service, khong FK)"
        VARCHAR payment_status
        TSRANGE occupied_during "GENERATED — EXCLUDE gist chong trung lich doctor/patient/room"
        UUID session_id "medical examination_sessions (cross-service, khong FK)"
        UUID treatment_plan_id "medical treatment_plans (cross-service, khong FK)"
    }

    appointment_status_history {
        UUID history_id PK
        UUID appointment_id FK
        VARCHAR old_status
        VARCHAR new_status
        UUID changed_by
    }

    appointment_reminder_preferences {
        UUID preference_id PK
        UUID patient_id "cross-service, khong FK — UNIQUE(patient_id, channel)"
        VARCHAR channel
        BOOLEAN enabled
        INTEGER reminder_minutes_before
    }

    appointment_notification_logs {
        UUID log_id PK
        UUID appointment_id FK
        VARCHAR notification_type
        VARCHAR channel
        VARCHAR status
        VARCHAR notification_id "user-service notifications (cross-service)"
    }

    diagnostic_orders {
        UUID order_id PK
        UUID appointment_id FK
        UUID patient_id "cross-service, khong FK"
        UUID doctor_id "cross-service, khong FK"
        VARCHAR order_code UK
        VARCHAR order_type
        VARCHAR status
    }

    clinics ||--o{ treatment_rooms : "co (CASCADE)"
    clinics ||--o{ clinic_services : "cung cap (CASCADE)"
    clinics ||--o{ doctor_schedules : "xep lich (CASCADE)"
    clinics ||--o{ appointments : "dien ra tai (CASCADE)"
    specialties ||--o{ doctor_specialties : "gan cho (CASCADE)"
    specialties ||--o{ services : "thuoc"
    service_categories ||--o{ services : "phan loai"
    service_categories ||--o| service_categories : "cha-con"
    services ||--o{ clinic_services : "ap gia (CASCADE)"
    work_shifts ||--o{ doctor_schedules : "theo ca"
    treatment_rooms ||--o{ doctor_schedules : "tai phong"
    treatment_rooms ||--o{ appointments : "tai phong"
    services ||--o{ appointments : "dich vu"
    doctor_schedules ||--o{ schedule_changes : "thay doi (CASCADE)"
    appointments ||--o{ appointment_status_history : "lich su (CASCADE)"
    appointments ||--o{ appointment_notification_logs : "thong bao (CASCADE)"
    appointments ||--o{ diagnostic_orders : "chi dinh (CASCADE)"
