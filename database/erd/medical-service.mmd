%% ERD — core_medical_service_db (database/clinical-emr-service/medical-service/schema.sql)
%% Solid line (--) = real FK. Dashed line (..) = logical link, NO FK.
%% Columns doctor_id / clinic_id / appointment_id point to other services — external entities not drawn.
%% Omitted: infra table `migrations` (TypeORM) and 5 NestJS boilerplate tables
%% (file, role, status, user, session) — not in the domain, see schema.sql if needed.
erDiagram
    patients {
        UUID patient_id PK
        UUID user_id "iam users.user_id (cross-service, no FK, nullable)"
        VARCHAR patient_code UK
        VARCHAR full_name
        DATE date_of_birth
        SMALLINT gender "ISO 5218: 0 unknown | 1 male | 2 female (CHECK)"
        TEXT[] allergies
        TEXT[] chronic_diseases
        VARCHAR insurance_number
    }

    patient_representatives {
        UUID representative_id PK
        UUID patient_id FK
        VARCHAR full_name
        VARCHAR relationship
        BOOLEAN is_primary
        BOOLEAN authorized_for_treatment
        BOOLEAN authorized_for_payment
        BOOLEAN authorized_for_records
    }

    medical_history {
        UUID history_id PK
        UUID patient_id FK
        VARCHAR condition_name
        VARCHAR condition_type
        DATE diagnosed_date
    }

    medical_records {
        UUID record_id PK
        UUID patient_id FK
        UUID appointment_id "clinic appointments (cross-service, no FK)"
        UUID clinic_id "clinic clinics (cross-service, no FK)"
        UUID doctor_id "iam users.user_id (cross-service, no FK)"
        DATE visit_date
        TEXT diagnosis
        VARCHAR record_status "draft | finalized"
        VARCHAR record_hash
        UUID finalized_by
    }

    medical_record_versions {
        UUID version_id PK
        UUID record_id FK
        INTEGER version_number
        JSONB snapshot
        UUID changed_by
    }

    record_exports {
        UUID export_id PK
        UUID patient_id FK
        UUID record_id FK
        VARCHAR export_type
        VARCHAR export_format
        UUID exported_by
    }

    examination_sessions {
        UUID session_id PK
        UUID appointment_id "clinic appointments (cross-service, no FK)"
        UUID record_id FK
        UUID patient_id FK
        UUID doctor_id "cross-service, no FK"
        UUID clinic_id "cross-service, no FK"
        TIMESTAMP session_date
        JSONB vital_signs
        VARCHAR status "in_progress | completed | signed"
        UUID signed_by
    }

    examination_session_amendments {
        UUID amendment_id PK
        UUID session_id FK
        UUID record_id FK "SET NULL"
        UUID patient_id FK "SET NULL"
        TEXT amendment_reason
        UUID amended_by
    }

    symptoms {
        UUID symptom_id PK
        UUID session_id FK
        UUID patient_id FK "denormalized — duplicates session.patient_id"
        VARCHAR symptom_name
        VARCHAR severity
        UUID recorded_by
    }

    diagnoses {
        UUID diagnosis_id PK
        UUID session_id FK
        VARCHAR icd_code
        VARCHAR diagnosis_name
        VARCHAR diagnosis_type
    }

    dental_charts {
        UUID chart_id PK
        UUID patient_id FK
        UUID record_id FK "UNIQUE(record_id, tooth_number)"
        INTEGER tooth_number
        VARCHAR tooth_status
        JSONB surfaces
    }

    image_categories {
        UUID category_id PK
        VARCHAR category_name
    }

    dental_images {
        UUID image_id PK
        UUID patient_id FK
        UUID record_id FK
        UUID category_id FK
        VARCHAR image_type
        TEXT image_url
        INTEGER[] tooth_numbers
        VARCHAR pacs_id
        UUID uploaded_by
    }

    image_annotations {
        UUID annotation_id PK
        UUID image_id FK
        UUID annotated_by
        JSONB annotation_data
    }

    pacs_sync_logs {
        UUID sync_id PK
        UUID image_id FK
        VARCHAR sync_type
        VARCHAR pacs_server
        VARCHAR status
    }

    clinical_orders {
        UUID order_id PK
        UUID session_id FK
        UUID record_id FK
        UUID patient_id FK
        UUID ordered_by
        VARCHAR order_type
        VARCHAR test_type
        VARCHAR status
    }

    lab_test_results {
        UUID result_id PK
        UUID order_id FK
        VARCHAR test_name
        TEXT result_value
        BOOLEAN is_abnormal
    }

    treatment_plans {
        UUID plan_id PK
        UUID session_id FK
        UUID patient_id FK
        UUID record_id FK
        VARCHAR plan_name
        NUMERIC estimated_cost
        CHAR quote_currency "char(3), ISO 4217"
        VARCHAR status "draft | sent | proposed | accepted | partially_accepted | declined | in_progress | completed | cancelled"
        UUID accepted_representative_id FK "-> patient_representatives (SET NULL)"
    }

    treatment_history {
        UUID treatment_id PK
        UUID record_id FK
        UUID patient_id FK
        DATE treatment_date
        VARCHAR procedure_name
        NUMERIC cost
        UUID performed_by
    }

    prescriptions {
        UUID prescription_id PK
        UUID session_id FK
        UUID record_id FK
        UUID patient_id FK
        UUID doctor_id "cross-service, no FK"
        DATE prescription_date
        VARCHAR status "draft | issued | dispensed | cancelled"
        UUID digital_signature_id "user-service digital_signatures (cross-service)"
        BOOLEAN minor_patient_at_issue
    }

    prescription_items {
        UUID item_id PK
        UUID prescription_id FK
        VARCHAR medication_name
        VARCHAR dosage
        VARCHAR frequency
        INTEGER quantity
    }

    patients ||--o{ patient_representatives : "represented by (CASCADE)"
    patients ||--o{ medical_history : "history (CASCADE)"
    patients ||--o{ medical_records : "records (CASCADE)"
    patients ||--o{ record_exports : "export (CASCADE)"
    patients ||--o{ examination_sessions : "examined"
    patients ||--o{ symptoms : "symptom"
    patients ||--o{ dental_charts : "dental chart (CASCADE)"
    patients ||--o{ dental_images : "image (CASCADE)"
    patients ||--o{ clinical_orders : "order (CASCADE)"
    patients ||--o{ treatment_plans : "plan (CASCADE)"
    patients ||--o{ treatment_history : "treated (CASCADE)"
    patients ||--o{ prescriptions : "prescription"
    patients ||--o{ examination_session_amendments : "amendment (SET NULL)"

    medical_records ||--o{ medical_record_versions : "version (CASCADE)"
    medical_records ||--o{ record_exports : "export (CASCADE)"
    medical_records ||--o{ examination_sessions : "contains (CASCADE)"
    medical_records ||--o{ examination_session_amendments : "amendment (SET NULL)"
    medical_records ||--o{ dental_charts : "records (CASCADE)"
    medical_records ||--o{ dental_images : "attaches"
    medical_records ||--o{ clinical_orders : "order (CASCADE)"
    medical_records ||--o{ treatment_plans : "plan"
    medical_records ||--o{ treatment_history : "history (CASCADE)"
    medical_records ||--o{ prescriptions : "prescription (CASCADE)"

    examination_sessions ||--o{ examination_session_amendments : "amendment (CASCADE)"
    examination_sessions ||--o{ symptoms : "records (CASCADE)"
    examination_sessions ||--o{ diagnoses : "diagnosis (CASCADE)"
    examination_sessions ||--o{ clinical_orders : "order (CASCADE)"
    examination_sessions ||--o{ treatment_plans : "proposes (CASCADE)"
    examination_sessions ||--o{ prescriptions : "prescribes (CASCADE)"

    clinical_orders ||--o{ lab_test_results : "result (CASCADE)"
    image_categories ||--o{ dental_images : "categorizes"
    dental_images ||--o{ image_annotations : "annotation (CASCADE)"
    dental_images ||--o{ pacs_sync_logs : "PACS sync"
    prescriptions ||--o{ prescription_items : "contains meds (CASCADE)"

    patient_representatives ||--o{ treatment_plans : "representative accepts (SET NULL)"
