    examination_sessions ||--o{ diagnoses : "chan doan (CASCADE)"
    examination_sessions ||--o{ clinical_orders : "chi dinh (CASCADE)"
    examination_sessions ||--o{ treatment_plans : "de xuat (CASCADE)"
    examination_sessions ||--o{ prescriptions : "ke don (CASCADE)"

