# ============================================
# S.M.I.L.E - Root Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# This file is used by docker-compose.dev.yml

# ============================================
# PostgreSQL Configuration (Main Database)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================
# Database Names
# ============================================
AUTH_DB_NAME=auth_service_db
ACCOUNT_DB_NAME=account_service_db
CLINIC_DB_NAME=core_clinic_service_db
MEDICAL_DB_NAME=core_medical_service_db
PAYMENT_DB_NAME=payment_service_db
CORE_PAYMENT_DB_NAME=core_payment_service_db
BOOKING_ORCHESTRATOR_DB_NAME=booking_orchestrator

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# Spring Profiles
# ============================================
SPRING_PROFILES_ACTIVE=docker

# ============================================
# JWT Configuration (Shared across services)
# ============================================
# Generate a secure random secret key (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# OTP Configuration
# ============================================
OTP_EXPIRATION=300000
OTP_LENGTH=6

# ============================================
# Email Configuration (SMTP)
# ============================================
# For Gmail, use App Password (not your regular password)
# Enable 2FA and generate App Password at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=smile.dentalteeth@gmail.com
MAIL_PASSWORD=your-app-password
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8081/api/account/oauth/callback/google
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

# ============================================
# VNPay Configuration (Payment)
# ============================================
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8083/api/appointment/vnpay/return
VNPAY_TMN_CODE=your-tmn-code
VNPAY_SECRET_KEY=your-vnpay-secret-key

# ============================================
# AWS S3 Configuration (Image Storage)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smile-dental-images

# ============================================
# AI & Infrastructure Services
# ============================================
AI_SERVICE_URL=http://dental-detection-api:8000
AI_SERVICE_PORT=8000

# Kafka
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Vault
VAULT_PORT=8200
VAULT_ROOT_TOKEN=dev-root-token

# ============================================
# Service Ports
# ============================================
GATEWAY_PORT=8080
IAM_SERVICE_PORT=8081
CLINICAL_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8085
BOOKING_ORCHESTRATOR_PORT=8086

# ============================================
# Database Configuration (Service Specific)
# ============================================
AI_SERVICE_URL=http://dental-detection-api:8000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/appointment_service_db

# ============================================
# Account Service Database
# ============================================
ACCOUNT_DB_HOST=postgres
ACCOUNT_DB_PORT=5432
ACCOUNT_DB_NAME=account_service_db
ACCOUNT_DB_USERNAME=postgres
ACCOUNT_DB_PASSWORD=postgres

# ============================================
# Clinic Service Database
# ============================================
CLINIC_DB_HOST=postgres
CLINIC_DB_PORT=5432
CLINIC_DB_NAME=clinic_service_db
CLINIC_DB_USERNAME=postgres
CLINIC_DB_PASSWORD=postgres

# ============================================
# Appointment Service Database
# ============================================
APPOINTMENT_DB_HOST=postgres
APPOINTMENT_DB_PORT=5432
APPOINTMENT_DB_NAME=appointment_service_db
APPOINTMENT_DB_USERNAME=postgres
APPOINTMENT_DB_PASSWORD=postgres

# ============================================
# Patient Media Record Service Database
# ============================================
PATIENT_MEDIA_RECORD_DB_HOST=postgres
PATIENT_MEDIA_RECORD_DB_PORT=5432
PATIENT_MEDIA_RECORD_DB_NAME=patient_media_record_service_db
PATIENT_MEDIA_RECORD_DB_USERNAME=postgres
PATIENT_MEDIA_RECORD_DB_PASSWORD=postgres

# ============================================
# Schedule Service Database
# ============================================
SCHEDULE_DB_HOST=postgres
SCHEDULE_DB_PORT=5432
SCHEDULE_DB_NAME=schedule_service_db
SCHEDULE_DB_USERNAME=postgres
SCHEDULE_DB_PASSWORD=postgres

# ============================================
# Service Service Database
# ============================================
SERVICE_DB_HOST=postgres
SERVICE_DB_PORT=5432
SERVICE_DB_NAME=service_service_db
SERVICE_DB_USERNAME=postgres
SERVICE_DB_PASSWORD=postgres

# ============================================
# Examination Service Database
# ============================================
EXAMINATION_DB_HOST=postgres
EXAMINATION_DB_PORT=5432
EXAMINATION_DB_NAME=examination_service_db
EXAMINATION_DB_USERNAME=postgres
EXAMINATION_DB_PASSWORD=postgres

# ============================================
# Dental Image Service Database
# ============================================
DENTAL_IMAGE_DB_HOST=postgres
DENTAL_IMAGE_DB_PORT=5432
DENTAL_IMAGE_DB_NAME=dental_image_service_db
DENTAL_IMAGE_DB_USERNAME=postgres
DENTAL_IMAGE_DB_PASSWORD=postgres

# ============================================
# Ory Kratos Configuration
# ============================================
# Enable/disable Ory Kratos integration
ORY_ENABLED=true

# Ory Network SDK URL (from Ory Console -> Project Settings)
ORY_SDK_URL=https://eloquent-mccarthy-172rchyvm7.projects.oryapis.com

# Ory Public URL (same as SDK URL for Ory Network)
ORY_PUBLIC_URL=https://eloquent-mccarthy-172rchyvm7.projects.oryapis.com

# Ory Admin URL (same as SDK URL for Ory Network)
ORY_ADMIN_URL=https://eloquent-mccarthy-172rchyvm7.projects.oryapis.com

# Ory API Key (optional, for admin operations)
# Get from Ory Console -> API Keys
ORY_API_KEY=ory_pat_ST5we0TGzLdMYfqvLSqXhu9kSPSsIcgC

# JWT Configuration for Ory
ORY_JWT_ISSUER=https://eloquent-mccarthy-172rchyvm7.projects.oryapis.com
ORY_JWKS_URI=https://eloquent-mccarthy-172rchyvm7.projects.oryapis.com/.well-known/jwks.json
