# ============================================
# S.M.I.L.E - Root Environment Variables
# ============================================
# Reference only: docker-compose.yml currently hardcodes its environment;
# per-service configuration lives in each service's own .env.example
# (backend/service/*/.env.example, ai/*/env.example).

# ============================================
# PostgreSQL (single instance, one logical DB per service)
# Created by docker/init-db.sql
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_service_db                      # iam-service (accounts, tokens, otp)
ACCOUNT_DB_NAME=account_service_db                # iam-service (users, roles, kyc, notifications)
MEDICAL_DB_NAME=core_medical_service_db           # clinical-emr-service (patients, records)
CLINIC_DB_NAME=core_clinic_service_db             # clinical-emr-service (clinics, appointments)
PAYMENT_DB_NAME=payment_service_db                # payment-service
BOOKING_ORCHESTRATOR_DB_NAME=booking_orchestrator_db  # ai/booking_orchestrator (chatbot logs)

# NOTE: no physical foreign keys across databases — services reference each
# other's records by UUID only (logical FK).

# ============================================
# Redis (single shared instance, one logical DB per service)
#   DB 0 — gateway-service        (distributed rate limiting)
#   DB 1 — clinical-emr-service   (master-data read cache)
#   DB 2 — booking_langgraph      (conversation state + confirmation tokens)
#   DB 3 — iam-service            (logout access-token blacklist)
#   DB 4 — payment-service        (idempotency + callback replay guard)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
GATEWAY_REDIS_URL=redis://redis:6379/0
CLINICAL_EMR_REDIS_URL=redis://redis:6379/1
BOOKING_LANGGRAPH_REDIS_URL=redis://redis:6379/2
IAM_REDIS_URL=redis://redis:6379/3
PAYMENT_REDIS_URL=redis://redis:6379/4

# ============================================
# JWT (shared HS256 secret across NestJS services)
# ============================================
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# OTP (stored in Postgres by iam-service)
# ============================================
OTP_EXPIRATION=300000
OTP_LENGTH=6

# ============================================
# Email (maildev in docker-compose; SMTP in production)
# ============================================
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_CLIENT_PORT=1080

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Cloudinary (avatar uploads)
# ============================================
# Frontend values are public; the API secret is backend-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# ============================================
# VNPay (mocked by payment-service in dev)
# ============================================
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-tmn-code
VNPAY_SECRET_KEY=your-vnpay-secret-key
# Keep true without merchant credentials. Use exactly false for signed sandbox requests.
VNPAY_MOCK=true

# ============================================
# Service Ports (docker-compose internal)
# ============================================
GATEWAY_PORT=8080
IAM_SERVICE_PORT=8081
CLINICAL_EMR_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
BOOKING_LANGGRAPH_PORT=8030
BOOKING_ORCHESTRATOR_PORT=8089
KYC_OCR_PORT=8010

# ============================================
# Inter-service URLs (docker network)
# ============================================
IAM_SERVICE_URL=http://iam-service:8081
CLINICAL_EMR_SERVICE_URL=http://clinical-emr-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
BOOKING_LANGGRAPH_SERVICE_URL=http://booking-langgraph:8030
KYC_OCR_URL=http://kyc-ocr-service:8010
IAM_INTERNAL_API_KEY=smile-local-kyc-key

# ============================================
# Notifications (SMS / Web Push / SMTP / reminders)
# ============================================
# Gmail app password SMTP (leave unset to keep maildev in dev)
# MAIL_HOST=smtp.gmail.com  MAIL_PORT=465  MAIL_SECURE=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

# Twilio SMS
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@smile.com

# Server-to-server token for POST /v1/notifications (unset = open, dev only)
INTERNAL_SERVICE_TOKEN=smile-local-internal-token

# Automatic appointment reminders (clinical-emr-service)
APPOINTMENT_REMINDER_ENABLED=true
APPOINTMENT_REMINDER_INTERVAL_MS=60000
APPOINTMENT_REMINDER_BATCH_SIZE=20
