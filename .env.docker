# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  S.M.I.L.E — Docker Environment Variables                              ║
# ║  Copy to .env and adjust values as needed                               ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Global ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=smile
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smile_db
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── IAM Service ─────────────────────────────────────────────────────────────
IAM_SERVICE_PORT=3001
AUTH_JWT_SECRET=smile-dev-jwt-secret-change-in-production
AUTH_REFRESH_SECRET=smile-dev-refresh-secret-change-in-production

# ── Clinical EMR Service ───────────────────────────────────────────────────
CLINICAL_EMR_SERVICE_PORT=8082

# ── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3100

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@smile.com
PGADMIN_DEFAULT_PASSWORD=admin
